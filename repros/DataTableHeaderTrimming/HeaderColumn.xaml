<UserControl x:Class="DataTableHeaderTrimming.HeaderColumn"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid x:Name="HeaderTemplate">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <ContentPresenter x:Name="HeaderPresenter" Margin="4,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
      <Button x:Name="HeaderButton" Padding="0"
              MinWidth="0" HorizontalContentAlignment="Left">
        <Grid x:Name="SortHeader">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <TextBlock x:Name="HeaderText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <FontIcon x:Name="SortIcon" Grid.Column="1" Width="16" Margin="4,0,0,0"
                    FontSize="10" Glyph="&#xE70E;" Visibility="Collapsed" />
        </Grid>
      </Button>
    </ContentPresenter>
    <Thumb x:Name="ResizeThumb" Grid.Column="1" Width="8" HorizontalAlignment="Right">
      <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="Transparent" /></ControlTemplate></Thumb.Template>
    </Thumb>
  </Grid>
</UserControl>
