namespace OpenNet.UI.Xaml.View.Dialog
{
	[default_interface]
	runtimeclass HttpDownloadDialog : Microsoft.UI.Xaml.Controls.ContentDialog
	{
		HttpDownloadDialog();

		// The validated URL entered by the user
		String Url{ get; };
		// Optional save directory
		String SaveDirectory{ get; };
		// Optional custom filename
		String FileName{ get; };
		// Whether the URL is valid
		Boolean IsUrlValid{ get; };
		Int32 ConnectionsPerServer{ get; };
		Int64 MaximumDownloadRate{ get; };
		Boolean StartPaused{ get; };
		String Referer{ get; };
		String UserAgent{ get; };
		String Cookie{ get; };
		String Headers{ get; };
		String Mirrors{ get; };
		String Checksum{ get; };
		String Description{ get; };
		String Username{ get; };
		String Password{ get; };
	}
}
