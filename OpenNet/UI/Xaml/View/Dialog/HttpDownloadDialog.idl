namespace OpenNet.UI.Xaml.View.Dialog
{
	[default_interface]
	runtimeclass HttpDownloadDialog : Microsoft.UI.Xaml.Controls.ContentDialog, Microsoft.UI.Xaml.Data.INotifyPropertyChanged
	{
		HttpDownloadDialog();

		// The validated URL entered by the user
		String Url;
		// Optional save directory
		String SaveDirectory;
		// Optional custom filename
		String FileName;
		// Whether the URL is valid
		Boolean IsUrlValid{ get; };
		Double ConnectionsPerServer;
		Double MaximumDownloadRate;
		Boolean StartPaused{ get; };
		String Referer;
		String UserAgent;
		String Cookie;
		String Headers;
		String Mirrors;
		String Checksum;
		String Description;
		String Username;
		String Password;
		String ClipboardPreviewText { get; };
		Microsoft.UI.Xaml.Visibility ClipboardPreviewVisibility { get; };
		String FileSizeText { get; };
		String DiskSpaceText { get; };
		String ResumeSupportText { get; };
		Boolean IsMetadataLoading { get; };
		Boolean CanFetchMetadata { get; };
		String ErrorTitle { get; };
		String ErrorMessage { get; };
		Boolean IsErrorOpen { get; };
	}
}
