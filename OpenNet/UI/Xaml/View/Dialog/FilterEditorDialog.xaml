<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="OpenNet.UI.Xaml.View.Dialog.FilterEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass"
    x:Name="RootDialog"
    DefaultButton="Primary"
    Style="{StaticResource DefaultContentDialogStyle}"
    mc:Ignorable="d">
    <Grid>
        <StackPanel
            x:Name="ClientRulePanel"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock x:Uid="CF_EditPatternLabel" />
            <wl:LiquidGlassTextBox
                x:Name="PatternTextBox"
                MinWidth="460"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True" />
            <TextBlock x:Uid="CF_EditMatchTypeLabel" />
            <wl:LiquidGlassComboBox
                x:Name="MatchTypeComboBox"
                HorizontalAlignment="Stretch"
                essential:ComboBoxHelper.AcrylicWorkaround="True"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True">
                <ComboBoxItem x:Uid="CF_EditMatchContains" />
                <ComboBoxItem x:Uid="CF_EditMatchExact" />
                <ComboBoxItem x:Uid="CF_EditMatchWildcard" />
                <ComboBoxItem x:Uid="CF_EditMatchRegex" />
            </wl:LiquidGlassComboBox>
            <wl:LiquidGlassToggleSwitch
                x:Name="CaseSensitiveToggle"
                x:Uid="CF_EditCaseSensitive"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True"
                Checked="CaseSensitiveToggle_Changed"
                Loaded="CaseSensitiveToggle_Loaded"
                Unchecked="CaseSensitiveToggle_Changed" />
            <wl:LiquidGlassToggleSwitch
                x:Name="EnabledToggle"
                x:Uid="CF_EditEnabled"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True"
                Checked="EnabledToggle_Changed"
                Loaded="EnabledToggle_Loaded"
                Unchecked="EnabledToggle_Changed" />
            <TextBlock x:Uid="CF_EditDescriptionLabel" />
            <wl:LiquidGlassTextBox
                x:Name="DescriptionTextBox"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True" />
        </StackPanel>

        <StackPanel
            x:Name="ClientImportPanel"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock x:Name="ImportHintText" TextWrapping="Wrap" />
            <wl:LiquidGlassCheckBox
                x:Name="ReplaceExistingCheckBox"
                x:Uid="CF_ReplaceExisting"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True" />
        </StackPanel>

        <StackPanel
            x:Name="SubscriptionPanel"
            Spacing="10"
            Visibility="Collapsed">
            <wl:LiquidGlassTextBox
                x:Name="SubscriptionUrlTextBox"
                MinWidth="480"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True" />
            <wl:LiquidGlassCheckBox
                x:Name="SubscriptionEnabledCheckBox"
                x:Uid="IPF_EditSubscriptionEnabled"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True" />
        </StackPanel>

        <StackPanel
            x:Name="IpRulePanel"
            Spacing="8"
            Visibility="Collapsed">
            <TextBlock x:Uid="IPF_EditRuleEntryLabel" />
            <wl:LiquidGlassTextBox
                x:Name="RuleEntryTextBox"
                MinWidth="460"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True" />
            <TextBlock x:Uid="IPF_EditRuleDescriptionLabel" />
            <wl:LiquidGlassTextBox
                x:Name="RuleDescriptionTextBox"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True" />
        </StackPanel>
    </Grid>
</ContentDialog>
