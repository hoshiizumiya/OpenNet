<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OpenNet.UI.Xaml.View.InfoBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid
        x:Name="VisibilityRoot"
        Margin="16"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Visibility="Collapsed">
        <Border
            x:Name="ShowButtonBorder"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="Collapsed">
            <Button x:Uid="InfoBarShowButton" Click="OnShowButtonClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock x:Uid="InfoBarShowButtonText" Text="Notifications" />
                    <InfoBadge
                        x:Name="NotificationCountBadge"
                        Style="{ThemeResource CriticalValueInfoBadgeStyle}"
                        Value="0" />
                </StackPanel>
            </Button>
        </Border>

        <Border
            x:Name="InfoBarItemsBorder"
            Width="440"
            MaxHeight="520"
            Padding="12"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="InfoBarPanelTitle"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Notifications" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button
                            x:Uid="InfoBarClearAllButton"
                            Click="OnClearAllButtonClick"
                            Content="Clear all" />
                        <Button
                            x:Uid="InfoBarCollapseButton"
                            Click="OnCollapseButtonClick"
                            Content="Collapse" />
                    </StackPanel>
                </Grid>
                <ScrollViewer
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="InfoBarItemsPanel" Spacing="8">
                        <StackPanel.ChildrenTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
