<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="OpenNet.UI.Xaml.View.InfoBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:OpenNet.UI.Xaml.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:notification="using:OpenNet.Service.Notification"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/InfoBarOverride.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate
                x:Key="InfoBarTemplate"
                x:DataType="notification:InfoBarOptions">
                <InfoBar
                    Title="{x:Bind Title, Mode=OneTime}"
                    control:InfoBarHelper.IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneTime}"
                    Closed="OnInfoBarClosed"
                    Content="{x:Bind Content, Mode=OneTime}"
                    IsOpen="True"
                    Message="{x:Bind Message, Mode=OneTime}"
                    Severity="{x:Bind Severity, Mode=OneTime}" />
            </DataTemplate>

            <DataTemplate
                x:Key="InfoBarWithActionButtonTemplate"
                x:DataType="notification:InfoBarOptions">
                <InfoBar
                    Title="{x:Bind Title, Mode=OneTime}"
                    control:InfoBarHelper.IsTextSelectionEnabled="{x:Bind IsTextSelectionEnabled, Mode=OneTime}"
                    Closed="OnInfoBarClosed"
                    Content="{x:Bind Content, Mode=OneTime}"
                    IsOpen="True"
                    Message="{x:Bind Message, Mode=OneTime}"
                    Severity="{x:Bind Severity, Mode=OneTime}">
                    <InfoBar.ActionButton>
                        <Button
                            Command="{x:Bind ActionButtonCommand, Mode=OneTime}"
                            Content="{x:Bind ActionButtonContent, Mode=OneTime}" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </DataTemplate>

            <control:InfoBarTemplateSelector
                x:Key="InfoBarTemplateSelector"
                ActionButtonDisabled="{StaticResource InfoBarTemplate}"
                ActionButtonEnabled="{StaticResource InfoBarWithActionButtonTemplate}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid
        x:Name="VisibilityRoot"
        Margin="16"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Visibility="Collapsed">
        <Border
            x:Name="ShowButtonBorder"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource ControlCornerRadius}"
            Visibility="Collapsed">
            <Button
                x:Uid="InfoBarShowButton"
                Click="OnShowButtonClick"
                Style="{StaticResource SubtleButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xEA8F;" />
                    <TextBlock
                        x:Uid="InfoBarShowButtonText"
                        VerticalAlignment="Center"
                        Text="Notifications" />
                    <InfoBadge
                        x:Name="NotificationCountBadge"
                        Style="{ThemeResource CriticalValueInfoBadgeStyle}"
                        Value="0" />
                </StackPanel>
            </Button>
        </Border>

        <Border
            x:Name="InfoBarItemsBorder"
            Width="460"
            MaxHeight="560"
            Padding="12"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}"
            Visibility="Collapsed">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Uid="InfoBarPanelTitle"
                        VerticalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="Notifications" />
                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="4">
                        <Button
                            x:Uid="InfoBarClearAllButton"
                            Click="OnClearAllButtonClick"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Clear all">
                            <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        </Button>
                        <Button
                            x:Uid="InfoBarCollapseButton"
                            Click="OnCollapseButtonClick"
                            Style="{StaticResource SubtleButtonStyle}"
                            ToolTipService.ToolTip="Collapse">
                            <FontIcon FontSize="14" Glyph="&#xE70E;" />
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollView Grid.Row="1">
                    <ItemsControl
                        x:Name="InfoBarItemsControl"
                        ItemTemplateSelector="{StaticResource InfoBarTemplateSelector}"
                        ItemsSource="{x:Bind InfoBars, Mode=OneWay}">
                        <ItemsControl.ItemContainerTransitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </ItemsControl.ItemContainerTransitions>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
