<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskSpeedGraphPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:card="using:OpenNet.UI.Xaml.Control.Card"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:effects="using:OpenNet.UI.Xaml.Control.Effect"
    xmlns:essential="using:WinUI3Package"
    xmlns:graph="using:OpenNet.UI.Xaml.Control.Graph"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xtwc="using:XamlToolkit.WinUI.Controls"
    Loaded="Page_Loaded"
    NavigationCacheMode="Required"
    Unloaded="Page_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/SettingsStyle_ResourceDictionary.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/AnimatedNumber_ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="12" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    x:Uid="TaskSpeedGraph_Title"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Performance graph" />
                <TextBlock
                    x:Uid="TaskSpeedGraph_Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Live session and system telemetry"
                    TextWrapping="Wrap" />
            </StackPanel>
            <ComboBox
                x:Name="MetricSelector"
                x:Uid="TaskSpeedGraph_MetricSelector"
                Grid.Column="1"
                MinWidth="250"
                essential:ComboBoxHelper.AcrylicWorkaround="True"
                AutomationProperties.AutomationId="TaskSpeedGraph_MetricSelector"
                Header="Display"
                SelectedIndex="0"
                SelectedValuePath="Tag"
                SelectionChanged="MetricSelector_SelectionChanged">
                <ComboBoxItem
                    x:Uid="TaskSpeedGraph_TransferSpeed"
                    Content="Transfer Speed"
                    Tag="TransferSpeed" />
                <ComboBoxItem
                    x:Uid="TaskSpeedGraph_DiskCache"
                    Content="Disk Cache"
                    Tag="DiskCache" />
                <ComboBoxItem
                    x:Uid="TaskSpeedGraph_LongTermSeeding"
                    Content="Long-Term Seeding"
                    Tag="LongTermSeeding" />
                <ComboBoxItem
                    x:Uid="TaskSpeedGraph_CpuOverall"
                    Content="CPU Usage (Overall)"
                    Tag="CpuOverall" />
                <ComboBoxItem
                    x:Uid="TaskSpeedGraph_CpuLogicalProcessors"
                    Content="CPU Usage (Logical Processor)"
                    Tag="CpuLogicalProcessors" />
                <ComboBoxItem
                    x:Uid="TaskSpeedGraph_MemoryUsage"
                    Content="Memory Usage"
                    Tag="MemoryUsage" />
                <ComboBoxItem
                    x:Uid="TaskSpeedGraph_DhtUdp"
                    Content="DHT over UDP"
                    Tag="DhtUdp" />
            </ComboBox>
            <Button
                x:Uid="ViewTaskSpeedGraphPageCustomButton"
                Grid.Column="2"
                Margin="0,24,0,0"
                VerticalAlignment="Top"
                AutomationProperties.Name="Customize graph style">
                <ToolTipService.ToolTip>
                    <ToolTip essential:ToolTipHelper.AcrylicWorkaround="True" Content="Customize graph style" />
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE713;" />
                <Button.Flyout>
                    <Flyout essential:FlyoutHelper.AcrylicWorkaround="True" Placement="Right">
                        <ScrollViewer
                            HorizontalContentAlignment="Stretch"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="10">
                                <StackPanel>
                                    <TextBlock
                                        x:Uid="ViewTaskSpeedGraphPageTextBlockHeader"
                                        FontSize="18"
                                        FontWeight="SemiBold"
                                        Text="Graph customization" />
                                    <TextBlock
                                        x:Uid="ViewTaskSpeedGraphPageTextBlockDescription"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Changes are applied immediately and saved for the next session."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock
                                    x:Uid="ViewTaskSpeedGraphPageTextBlockBehavior"
                                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                    Text="Behavior" />

                                <essential:SettingsExpander
                                    x:Uid="ViewTaskSpeedGraphPageBehaviorSettingsExpander"
                                    Description="Control sampling, movement, curve smoothing, and retained history"
                                    Header="Motion and history">
                                    <essential:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE823;" />
                                    </essential:SettingsExpander.HeaderIcon>
                                    <essential:SettingsExpander.Items>
                                        <essential:SettingsCard
                                            x:Uid="ViewTaskSpeedGraphPageBehaviorSettingsCard"
                                            Description="Horizontal distance travelled during each scroll duration."
                                            Header="Scroll distance">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    Width="150"
                                                    Maximum="500"
                                                    Minimum="0.1"
                                                    SmallChange="1"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{x:Bind Settings.HorizontalScrollDistance, Mode=TwoWay}" />
                                                <TextBlock x:Uid="ViewTaskSpeedGraphPageNumberBoxScrollDistanceUnit" Text="Pixels" />
                                            </Grid>
                                        </essential:SettingsCard>
                                        <essential:SettingsCard
                                            x:Uid="ViewTaskSpeedGraphPageSettingsCardScrollDuration"
                                            Description="Time used to travel the configured distance"
                                            Header="Scroll duration">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    Width="150"
                                                    Maximum="5000"
                                                    Minimum="1"
                                                    SmallChange="25"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{x:Bind Settings.HorizontalScrollDurationMilliseconds, Mode=TwoWay}" />
                                                <TextBlock x:Uid="ViewTaskSpeedGraphPageNumberBoxTimeUnit" Text="Milliseconds" />
                                            </Grid>
                                        </essential:SettingsCard>
                                        <essential:SettingsCard
                                            x:Uid="ViewTaskSpeedGraphPageSettingsCardSampleInterval"
                                            Description="Telemetry sampling cadence"
                                            Header="Sample interval">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    Width="150"
                                                    Maximum="5000"
                                                    Minimum="16"
                                                    SmallChange="25"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{x:Bind Settings.SampleIntervalMilliseconds, Mode=TwoWay}" />
                                                <TextBlock x:Uid="ViewTaskSpeedGraphPageNumberBoxTimeUnit" Text="Milliseconds" />
                                            </Grid>
                                        </essential:SettingsCard>
                                        <essential:SettingsCard
                                            x:Uid="ViewTaskSpeedGraphPageSettingsCardHistoryBuffer"
                                            Description="Retain off-screen points so widening the window can reveal recent history"
                                            Header="History reserve">
                                            <NumberBox
                                                x:Uid="ViewTaskSpeedGraphPageNumberBoxHistoryBuffer"
                                                Width="150"
                                                Header="Screen widths"
                                                Maximum="4"
                                                Minimum="0"
                                                SmallChange="0.25"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{x:Bind Settings.HistoryBufferScreens, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                        <essential:SettingsCard
                                            x:Uid="ViewTaskSpeedGraphPageSettingsCardScrollDistance"
                                            Description="Interpolate adjacent samples with rounded curves."
                                            Header="Smooth curves">
                                            <ToggleSwitch IsOn="{x:Bind Settings.SmoothCurves, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                    </essential:SettingsExpander.Items>
                                </essential:SettingsExpander>

                                <essential:SettingsExpander
                                    x:Uid="ViewTaskSpeedGraphPageSettingsExpanderHighlight"
                                    Description="Display a moving marker for sampled graph values."
                                    Header="Highlight line">
                                    <essential:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE7C3;" />
                                    </essential:SettingsExpander.HeaderIcon>
                                    <ToggleSwitch IsOn="{x:Bind Settings.HighlightEnabled, Mode=TwoWay}" />
                                    <essential:SettingsExpander.Items>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageSettingsCard" Header="Point selection">
                                            <ComboBox Width="210" SelectedIndex="{x:Bind Settings.HighlightBehaviorIndex, Mode=TwoWay}">
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemHighestAcrossAllSeries" Content="Highest across all series" />
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemLowestAcrossAllSeries" Content="Lowest across all series" />
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemHighestInEachSeries" Content="Highest in each series" />
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemLowestInEachSeries" Content="Lowest in each series" />
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemEachPoint" Content="Each point" />
                                            </ComboBox>
                                        </essential:SettingsCard>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageSettingsCardAnimationDuration" Header="Animation duration">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <NumberBox
                                                    Width="150"
                                                    Maximum="2000"
                                                    Minimum="0"
                                                    SmallChange="50"
                                                    SpinButtonPlacementMode="Inline"
                                                    Value="{x:Bind Settings.HighlightAnimationMilliseconds, Mode=TwoWay}" />
                                                <TextBlock x:Uid="ViewTaskSpeedGraphPageNumberBoxTimeUnit" Text="Milliseconds" />
                                            </Grid>
                                        </essential:SettingsCard>
                                    </essential:SettingsExpander.Items>
                                </essential:SettingsExpander>

                                <TextBlock
                                    x:Uid="ViewTaskSpeedGraphPageAppearanceTextBlock"
                                    Margin="0,6,0,0"
                                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                                    Text="Appearance" />

                                <essential:SettingsExpander
                                    x:Uid="ViewTaskSpeedGraphPageCanvasSettingsExpander"
                                    Description="Choose the canvas pattern and spacing"
                                    Header="Grid and canvas">
                                    <essential:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE80A;" />
                                    </essential:SettingsExpander.HeaderIcon>
                                    <essential:SettingsExpander.Items>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageBackgroundPatternSettingsCard" Header="Background pattern">
                                            <ComboBox Width="150" SelectedIndex="{x:Bind Settings.BackgroundModeIndex, Mode=TwoWay}">
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemNone" Content="None" />
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemCross" Content="Cross" />
                                                <ComboBoxItem x:Uid="ViewTaskSpeedGraphPageComboBoxItemDot" Content="Dot" />
                                            </ComboBox>
                                        </essential:SettingsCard>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageCrossSpacingSettingsCard" Header="Cross spacing">
                                            <NumberBox
                                                Width="150"
                                                Maximum="200"
                                                Minimum="2"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{x:Bind Settings.CrossSpacing, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageDotSpacingSettingsCard" Header="Dot spacing">
                                            <NumberBox
                                                Width="150"
                                                Maximum="200"
                                                Minimum="2"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{x:Bind Settings.DotSpacing, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                        <essential:SettingsCard
                                            x:Uid="ViewTaskSpeedGraphPageCustomCanvasColorsSettingsCard"
                                            Description="Override theme-aware grid and transparent canvas defaults"
                                            Header="Custom canvas colors">
                                            <ToggleSwitch IsOn="{x:Bind Settings.UseCustomCanvasColors, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                    </essential:SettingsExpander.Items>
                                </essential:SettingsExpander>

                                <essential:SettingsExpander
                                    x:Uid="ViewTaskSpeedGraphPageCanvasColorsSettingsExpander"
                                    Description="Select the grid and canvas colors used when custom colors are enabled"
                                    Header="Canvas colors">
                                    <essential:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE790;" />
                                    </essential:SettingsExpander.HeaderIcon>
                                    <essential:SettingsExpander.Items>
                                        <essential:SettingsCard HorizontalContentAlignment="Stretch" ContentAlignment="Left">
                                            <StackPanel Spacing="12">
                                                <card:TitleCard
                                                    x:Uid="ViewTaskSpeedGraphPageGridColorCard"
                                                    Title="Grid color"
                                                    Padding="12"
                                                    DividerVisibility="Collapsed">
                                                    <card:TitleCard.Content>
                                                        <xtwc:ColorPickerButton HorizontalAlignment="Stretch" SelectedColor="{x:Bind Settings.BackgroundColor, Mode=TwoWay}">
                                                            <xtwc:ColorPickerButton.ColorPicker>
                                                                <xtwc:ColorPicker
                                                                    IsAlphaEnabled="True"
                                                                    IsColorChannelTextInputVisible="False"
                                                                    IsColorSliderVisible="False"
                                                                    IsColorSpectrumVisible="True"
                                                                    IsHexInputVisible="True"
                                                                    IsMoreButtonVisible="True" />
                                                            </xtwc:ColorPickerButton.ColorPicker>
                                                        </xtwc:ColorPickerButton>
                                                    </card:TitleCard.Content>
                                                </card:TitleCard>
                                                <card:TitleCard
                                                    x:Uid="ViewTaskSpeedGraphPageCanvasClearColorCard"
                                                    Title="Canvas clear color"
                                                    Padding="12"
                                                    DividerVisibility="Collapsed">
                                                    <card:TitleCard.Content>
                                                        <xtwc:ColorPickerButton HorizontalAlignment="Stretch" SelectedColor="{x:Bind Settings.ClearColor, Mode=TwoWay}">
                                                            <xtwc:ColorPickerButton.ColorPicker>
                                                                <xtwc:ColorPicker
                                                                    IsAlphaEnabled="True"
                                                                    IsColorChannelTextInputVisible="False"
                                                                    IsColorSliderVisible="False"
                                                                    IsColorSpectrumVisible="True"
                                                                    IsHexInputVisible="True"
                                                                    IsMoreButtonVisible="True" />
                                                            </xtwc:ColorPickerButton.ColorPicker>
                                                        </xtwc:ColorPickerButton>
                                                    </card:TitleCard.Content>
                                                </card:TitleCard>
                                            </StackPanel>
                                        </essential:SettingsCard>
                                    </essential:SettingsExpander.Items>
                                </essential:SettingsExpander>

                                <essential:SettingsExpander
                                    x:Uid="ViewTaskSpeedGraphPageSeriesAppearanceSettingsExpander"
                                    Description="Configure the rendered line, border, and gradient area"
                                    Header="Series appearance">
                                    <essential:SettingsExpander.HeaderIcon>
                                        <FontIcon Glyph="&#xE8D2;" />
                                    </essential:SettingsExpander.HeaderIcon>
                                    <essential:SettingsExpander.Items>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageSeriesAppearanceStrokeSettingsCard" Header="Stroke width">
                                            <NumberBox
                                                Width="150"
                                                Maximum="12"
                                                Minimum="0.5"
                                                SmallChange="0.5"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{x:Bind Settings.StrokeWidth, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageSeriesAppearanceGradientSettingsCard" Header="Gradient fill">
                                            <ToggleSwitch IsOn="{x:Bind Settings.FillEnabled, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                        <essential:SettingsCard x:Uid="ViewTaskSpeedGraphPageSeriesAppearanceBorderSettingsCard" Header="Border line">
                                            <ToggleSwitch IsOn="{x:Bind Settings.BorderEnabled, Mode=TwoWay}" />
                                        </essential:SettingsCard>
                                    </essential:SettingsExpander.Items>
                                </essential:SettingsExpander>

                                <essential:SettingsCard
                                    x:Uid="ViewTaskSpeedGraphPageResetSettingsCard"
                                    Description="Reset every graph customization option to its original value."
                                    Header="Restore defaults">
                                    <essential:SettingsCard.HeaderIcon>
                                        <FontIcon Glyph="&#xE777;" />
                                    </essential:SettingsCard.HeaderIcon>
                                    <Button
                                        x:Uid="ViewTaskSpeedGraphPageResetButton"
                                        Click="ResetGraphSettings_Click"
                                        Content="Reset"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </essential:SettingsCard>
                            </StackPanel>
                        </ScrollViewer>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <essential:SwitchPresenter Value="{Binding SelectedValue, ElementName=MetricSelector, Mode=OneWay}">
                        <essential:Case Value="TransferSpeed">
                            <TextBlock
                                x:Uid="ViewTaskSpeedGraphPageGlobalDownload"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Global download" />
                        </essential:Case>
                        <essential:Case Value="DiskCache">
                            <TextBlock
                                x:Uid="ViewTaskSpeedGraphPageDiskCacheTitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Disk cache" />
                        </essential:Case>
                        <essential:Case Value="LongTermSeeding">
                            <TextBlock
                                x:Uid="ViewTaskSpeedGraphPageLongTermUpload"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Long-term upload" />
                        </essential:Case>
                        <essential:Case Value="CpuOverall">
                            <TextBlock
                                x:Uid="ViewTaskSpeedGraphPageOverallCpu"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Overall CPU" />
                        </essential:Case>
                        <essential:Case Value="CpuLogicalProcessors">
                            <TextBlock
                                x:Uid="ViewTaskSpeedGraphPageAverageCpu"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Average CPU" />
                        </essential:Case>
                        <essential:Case Value="MemoryUsage">
                            <TextBlock
                                x:Uid="ViewTaskSpeedGraphPageWorkingSet"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="OpenNet working set" />
                        </essential:Case>
                        <essential:Case Value="DhtUdp">
                            <TextBlock
                                x:Uid="ViewTaskSpeedGraphPageDhtReceive"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="DHT receive" />
                        </essential:Case>
                    </essential:SwitchPresenter>
                    <effects:AnimatedNumber
                        x:Name="PrimaryMetricValue"
                        x:Uid="ViewTaskSpeedGraphPageTextBlock"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Value="0 B/s" />
                </StackPanel>
            </Border>
            <Border
                Grid.Column="1"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <essential:SwitchPresenter Value="{Binding SelectedValue, ElementName=MetricSelector, Mode=OneWay}">
                        <essential:Case Value="TransferSpeed">
                            <TextBlock
                                x:Uid="TaskSpeedGraph_GlobalUpload"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Global upload" />
                        </essential:Case>
                        <essential:Case Value="DiskCache">
                            <TextBlock
                                x:Uid="TaskSpeedGraph_Source"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Source" />
                        </essential:Case>
                        <essential:Case Value="LongTermSeeding">
                            <TextBlock
                                x:Uid="TaskSpeedGraph_Scope"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Scope" />
                        </essential:Case>
                        <essential:Case Value="CpuOverall">
                            <TextBlock
                                x:Uid="TaskSpeedGraph_Sampling"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Sampling" />
                        </essential:Case>
                        <essential:Case Value="CpuLogicalProcessors">
                            <TextBlock
                                x:Uid="TaskSpeedGraph_PeakCpu"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Peak CPU" />
                        </essential:Case>
                        <essential:Case Value="MemoryUsage">
                            <TextBlock
                                x:Uid="TaskSpeedGraph_PhysicalMemoryShare"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Physical memory share" />
                        </essential:Case>
                        <essential:Case Value="DhtUdp">
                            <TextBlock
                                x:Uid="TaskSpeedGraph_DhtSend"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="DHT send" />
                        </essential:Case>
                    </essential:SwitchPresenter>
                    <effects:AnimatedNumber
                        x:Name="SecondaryMetricValue"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Value="0 B/s" />
                </StackPanel>
            </Border>
            <Border
                Grid.Column="2"
                Padding="12,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        x:Uid="TaskSpeedGraph_GraphScale"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Graph scale" />
                    <effects:AnimatedNumber
                        x:Name="ScaleMetricValue"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Value="Auto" />
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="2"
            MinHeight="180"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <graph:LiveGraph
                    x:Name="PerformanceGraph"
                    BackgroundMode="Cross"
                    ClearColor="Transparent"
                    CreateResources="PerformanceGraph_CreateResources"
                    CrossSpacing="30"
                    Draw="PerformanceGraph_Draw"
                    HighlightLineBehavior="EachPoint"
                    HighlightLineUpdated="PerformanceGraph_HighlightLineUpdated"
                    HighlightLineVisibility="Visible"
                    HorizontalScrollDistance="6"
                    HorizontalScrollDuration="0:0:0.1">
                    <graph:LiveGraph.HighlightLineContent>
                        <Grid IsHitTestVisible="False">
                            <Line
                                VerticalAlignment="Top"
                                Opacity="0.65"
                                Stroke="#FF26A65B"
                                StrokeDashArray="3,3"
                                StrokeThickness="1"
                                X1="0"
                                X2="10000" />
                            <Border
                                Margin="0,-15,10,0"
                                Padding="8,3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <effects:AnimatedNumber
                                    x:Name="HighlightValueText"
                                    FontSize="12"
                                    Value="—" />
                            </Border>
                        </Grid>
                    </graph:LiveGraph.HighlightLineContent>
                </graph:LiveGraph>

                <ContentPresenter
                    Margin="8,7,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Content="{Binding SelectedItem.Content, ElementName=MetricSelector, Mode=OneWay}"
                    FontSize="12"
                    IsHitTestVisible="False" />
                <effects:AnimatedNumber
                    x:Name="AxisMaximumText"
                    Margin="0,8,10,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    FontSize="12"
                    IsHitTestVisible="False"
                    Value="—" />
                <effects:AnimatedNumber
                    x:Name="TimelineDurationText"
                    Margin="8,0,0,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    IsHitTestVisible="False"
                    Value="60 s" />
                <TextBlock
                    Margin="0,0,8,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    FontSize="12"
                    IsHitTestVisible="False"
                    Text="0" />

                <!--
                    LiveGraph has one movable highlight presenter. Transfer Speed
                    needs a second overlay for the simultaneous upload series.
                -->
                <Grid
                    x:Name="UploadHighlightOverlay"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="UploadHighlightTransform" />
                    </Grid.RenderTransform>
                    <Line
                        VerticalAlignment="Top"
                        Opacity="0.65"
                        Stroke="#FF0078D4"
                        StrokeDashArray="3,3"
                        StrokeThickness="1"
                        X1="0"
                        X2="10000" />
                    <Border
                        Margin="0,-15,10,0"
                        Padding="8,3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <effects:AnimatedNumber
                            x:Name="UploadHighlightValueText"
                            FontSize="12"
                            Value="↑ —" />
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
