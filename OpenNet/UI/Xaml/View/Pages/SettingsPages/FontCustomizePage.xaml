<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.FontCustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass"
    mc:Ignorable="d">

    <ScrollView Margin="24">
        <StackPanel
            MaxWidth="1000"
            HorizontalAlignment="Stretch"
            Spacing="16">
            <TextBlock
                x:Uid="FontCustomizeTitle"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Text size" />
            <TextBlock
                x:Uid="FontCustomizeDescription"
                Text="Adjust application text size. Changes apply immediately and preserve Windows accessibility text scaling."
                TextWrapping="Wrap" />
            <essential:SettingsCard
                x:Uid="FontCustomizeScale"
                Description="80%–200%; default 100%"
                Header="Text size">
                <Grid
                    MinWidth="260"
                    MaxWidth="400"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <ouxct:MaterialSwap>
                        <ouxct:MaterialSwap.Native>
                            <Slider
                                x:Name="MaterialNative_214"
                                AutomationProperties.Name="Text size"
                                LargeChange="0.1"
                                Maximum="2"
                                Minimum="0.8"
                                SmallChange="0.05"
                                StepFrequency="0.05"
                                Value="{x:Bind ouxct:Typography.Current.Scale, Mode=TwoWay}" />
                        </ouxct:MaterialSwap.Native>
                        <ouxct:MaterialSwap.Glass>
                            <wl:LiquidGlassSlider ouxct:MaterialControlState.IsManaged="True" />
                        </ouxct:MaterialSwap.Glass>
                    </ouxct:MaterialSwap>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind ouxct:Typography.FormatScale(ouxct:Typography.Current.Scale), Mode=OneWay}"
                        TextAlignment="Right" />
                </Grid>
            </essential:SettingsCard>
            <essential:SettingsCard x:Uid="FontCustomizePreview" Header="Preview">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="FontCustomizePreviewHeading"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="OpenNet — readable at every size"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Uid="FontCustomizePreviewBody"
                        Text="Download tasks, network details, and settings follow the same text-size preference."
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Uid="FontCustomizePreviewCaption"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="Caption and secondary information"
                        TextWrapping="Wrap" />
                </StackPanel>
            </essential:SettingsCard>
            <wl:LiquidGlassButton
                x:Name="MaterialNative_215"
                x:Uid="FontCustomizeReset"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True"
                Click="Reset_Click"
                Content="Reset to 100%" />
        </StackPanel>
    </ScrollView>
</Page>
