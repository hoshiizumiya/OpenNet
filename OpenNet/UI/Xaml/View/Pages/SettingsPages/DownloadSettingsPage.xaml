<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.DownloadSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalAlignment="Top">
        <StackPanel Margin="24,20,24,24" Spacing="{StaticResource SettingsCardSpacing}">

            <!--  Section: Default Save Path  -->
            <TextBlock x:Uid="DL_Section_SaveLocation" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <essential:SettingsCard x:Uid="DL_DefaultSavePath">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8B7;" />
                </essential:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Uid="DL_DefaultSavePathTextBox"
                        AutomationProperties.AutomationId="DL_DefaultSavePathTextBox"
                        LostFocus="OnSettingChanged" x:Name="DefaultSavePathTextBox" Width="360"
                        ouxct:ControlAppearance.IsEnabled="True" />
                    <Button
                        x:Uid="DL_BrowseSavePath"
                        AutomationProperties.AutomationId="DL_BrowseSavePath"
                        Click="BrowseSavePathButton_Click"
                        Content="Browse..." x:Name="BrowseSavePathButton"
                        ouxct:ControlAppearance.IsEnabled="True" />
                </StackPanel>
            </essential:SettingsCard>

            <essential:SettingsCard x:Uid="DL_PreallocateStorage">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEDA2;" />
                </essential:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    Loaded="MaterialToggle_Loaded"
                    Toggled="OnSettingChanged" x:Name="PreallocateStorageToggle"
                    ouxct:ControlAppearance.IsEnabled="True" />
            </essential:SettingsCard>

            <!--  Section: Behaviour  -->
            <TextBlock x:Uid="DL_Section_Behaviour" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

            <essential:SettingsCard x:Uid="DL_AutoStartDownloads">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE768;" />
                </essential:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    Loaded="MaterialToggle_Loaded"
                    Toggled="OnSettingChanged" x:Name="AutoStartDownloadsToggle"
                    ouxct:ControlAppearance.IsEnabled="True" />
            </essential:SettingsCard>

            <essential:SettingsCard x:Uid="DL_RecheckBeforeResume">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D5;" />
                </essential:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    Loaded="MaterialToggle_Loaded"
                    Toggled="OnSettingChanged" x:Name="RecheckBeforeResumeToggle"
                    ouxct:ControlAppearance.IsEnabled="True" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="DL_HttpP2PPreferred"
                Description="New HTTP tasks try the verified libtorrent HTTP/P2P path first and fall back to aria2 when canonical metadata is unavailable."
                Header="Prefer P2P acceleration for HTTP downloads">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </essential:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    Loaded="MaterialToggle_Loaded"
                    Toggled="OnSettingChanged" x:Name="HttpP2PPreferredToggle"
                    ouxct:ControlAppearance.IsEnabled="True" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="DL_Aria2Connections"
                Description="Connections used for each HTTP download"
                Header="HTTP download connections">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </essential:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="Aria2ConnectionsNumberBox"
                    Maximum="16"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    ValueChanged="OnSettingChanged" />
            </essential:SettingsCard>

            <essential:SettingsExpander x:Uid="DL_MoveCompleted">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE8DE;" />
                </essential:SettingsExpander.HeaderIcon>
                <ToggleSwitch
                    Loaded="MaterialToggle_Loaded"
                    Toggled="OnSettingChanged" x:Name="MoveCompletedToggle"
                    ouxct:ControlAppearance.IsEnabled="True" />
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard x:Uid="DL_MoveCompletedPath">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Uid="DL_MoveCompletedPathTextBox"
                                AutomationProperties.AutomationId="DL_MoveCompletedPathTextBox"
                                LostFocus="OnSettingChanged" x:Name="MoveCompletedPathTextBox" Width="360"
                                ouxct:ControlAppearance.IsEnabled="True" />
                            <Button
                                x:Uid="DL_BrowseMovePath"
                                AutomationProperties.AutomationId="DL_BrowseMovePath"
                                Click="BrowseMovePathButton_Click"
                                Content="Browse..." x:Name="BrowseMovePathButton"
                                ouxct:ControlAppearance.IsEnabled="True" />
                        </StackPanel>
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

        </StackPanel>
    </ScrollViewer>

</Page>
