<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.BittorrentSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!--  Header  -->
                <TextBlock x:Uid="BT_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="BT_Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <!--  Connection  -->
                <TextBlock x:Uid="BT_Section_Connection" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_ConnectionsLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE839;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="ConnectionsLimitNumberBox"
                        Maximum="65535"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsExpander x:Uid="BT_Protocol">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_IncomingTcp">
                            <ToggleSwitch x:Name="EnableIncomingTcpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_OutgoingTcp">
                            <ToggleSwitch x:Name="EnableOutgoingTcpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_IncomingUtp">
                            <ToggleSwitch x:Name="EnableIncomingUtpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_OutgoingUtp">
                            <ToggleSwitch x:Name="EnableOutgoingUtpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_MultiConnPerIp">
                            <ToggleSwitch x:Name="AllowMultipleConnectionsPerIpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsCard x:Uid="BT_AnonymousMode">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AnonymousModeToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Discovery  -->
                <TextBlock x:Uid="BT_Section_Discovery" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_EnableDht">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE909;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="EnableDhtToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_EnableLsd">
                    <ToggleSwitch x:Name="EnableLsdToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_EnableUpnp">
                    <ToggleSwitch x:Name="EnableUpnpToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_EnableNatpmp">
                    <ToggleSwitch x:Name="EnableNatpmpToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard
                    x:Uid="BT_UpnpLeaseDuration"
                    Description="Use 0 for a permanent mapping. A finite lease is refreshed at 75% of its duration."
                    Header="UPnP lease duration (seconds)">
                    <NumberBox
                        x:Name="UpnpLeaseDurationNumberBox"
                        Maximum="86400"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Tracker  -->
                <TextBlock x:Uid="BT_Section_Tracker" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_AnnounceAllTiers">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AnnounceToAllTiersToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_AnnounceAllTrackers">
                    <ToggleSwitch x:Name="AnnounceToAllTrackersToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Limits  -->
                <TextBlock x:Uid="BT_Section_Limits" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_ActiveDownloads">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="ActiveDownloadsNumberBox"
                        Maximum="9999"
                        Minimum="-1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_ActiveSeeds">
                    <NumberBox
                        x:Name="ActiveSeedsNumberBox"
                        Maximum="9999"
                        Minimum="-1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_ActiveLimit">
                    <NumberBox
                        x:Name="ActiveLimitNumberBox"
                        Maximum="9999"
                        Minimum="-1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Speed Limits  -->
                <TextBlock x:Uid="BT_Section_SpeedLimits" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_DownloadRateLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="DownloadRateLimitNumberBox"
                        Maximum="999999"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_UploadRateLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE898;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="UploadRateLimitNumberBox"
                        Maximum="999999"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Seeding  -->
                <TextBlock x:Uid="BT_Section_Seeding" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_SeedRatioLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="SeedRatioLimitNumberBox"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="0.1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_SeedTimeLimit">
                    <NumberBox
                        x:Name="SeedTimeLimitNumberBox"
                        Maximum="99999"
                        Minimum="0"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Peer  -->
                <TextBlock x:Uid="BT_Section_Peer" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsExpander x:Uid="BT_Timeouts">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_PeerTimeout">
                            <NumberBox
                                x:Name="PeerTimeoutNumberBox"
                                Maximum="600"
                                Minimum="5"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_HandshakeTimeout">
                            <NumberBox
                                x:Name="HandshakeTimeoutNumberBox"
                                Maximum="120"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsCard x:Uid="BT_CloseRedundant">
                    <ToggleSwitch x:Name="CloseRedundantConnectionsToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Disk I/O  -->
                <TextBlock x:Uid="BT_Section_DiskIO" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_AioThreads">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="AioThreadsNumberBox"
                        Maximum="64"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_CheckingMemUsage">
                    <NumberBox
                        x:Name="CheckingMemUsageNumberBox"
                        Maximum="2048"
                        Minimum="1"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Identity  -->
                <TextBlock x:Uid="BT_Section_Identity" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_UserAgent">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </essential:SettingsCard.HeaderIcon>
                    <TextBox
                        x:Name="UserAgentTextBox"
                        x:Uid="ViewBittorrentSettingsPageTextBox"
                        MinWidth="220"
                        LostFocus="OnSettingChanged"
                        PlaceholderText="libtorrent/2.0.11" />
                </essential:SettingsCard>

                <!--  Encryption  -->
                <TextBlock x:Uid="BT_Section_Encryption" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_EncryptionPolicy">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="EncryptionPolicyComboBox"
                        MinWidth="180"
                        SelectionChanged="OnSettingChanged">
                        <ComboBoxItem x:Uid="BT_Enc_Forced" Tag="0" />
                        <ComboBoxItem x:Uid="BT_Enc_Enabled" Tag="1" />
                        <ComboBoxItem x:Uid="BT_Enc_Disabled" Tag="2" />
                    </ComboBox>
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_PreferRc4">
                    <ToggleSwitch x:Name="PreferRc4Toggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Proxy  -->
                <TextBlock x:Uid="BT_Section_Proxy" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_ProxyType">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ProxyTypeComboBox"
                        MinWidth="180"
                        SelectionChanged="OnSettingChanged">
                        <ComboBoxItem x:Uid="BT_Proxy_None" Tag="0" />
                        <ComboBoxItem x:Uid="BT_Proxy_Socks4" Tag="1" />
                        <ComboBoxItem x:Uid="BT_Proxy_Socks5" Tag="2" />
                        <ComboBoxItem x:Uid="BT_Proxy_Socks5Pw" Tag="3" />
                        <ComboBoxItem x:Uid="BT_Proxy_Http" Tag="4" />
                        <ComboBoxItem x:Uid="BT_Proxy_HttpPw" Tag="5" />
                    </ComboBox>
                </essential:SettingsCard>

                <essential:SettingsExpander x:Uid="BT_ProxyDetails">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_ProxyHostname">
                            <TextBox
                                x:Name="ProxyHostnameTextBox"
                                x:Uid="ViewBittorrentSettingsPageTextBox"
                                MinWidth="200"
                                LostFocus="OnSettingChanged"
                                PlaceholderText="proxy.example.com" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyPort">
                            <NumberBox
                                x:Name="ProxyPortNumberBox"
                                Maximum="65535"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyUsername">
                            <TextBox
                                x:Name="ProxyUsernameTextBox"
                                MinWidth="200"
                                LostFocus="OnSettingChanged"
                                PlaceholderText="" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyPassword">
                            <PasswordBox
                                x:Name="ProxyPasswordBox"
                                MinWidth="200"
                                LostFocus="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyPeerConn">
                            <ToggleSwitch x:Name="ProxyPeerConnectionsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyTrackerConn">
                            <ToggleSwitch x:Name="ProxyTrackerConnectionsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <!--  libtorrent Advanced  -->
                <TextBlock
                    x:Uid="ViewBittorrentSettingsPageTextBlock"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Advanced libtorrent" />

                <essential:SettingsCard
                    x:Uid="ViewBittorrentSettingsPageSettingsCard"
                    Description="Maximum number of peers in peer list (default: 4000)"
                    Header="Max Peer List Size">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE716;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="MaxPeerListSizeNumberBox"
                        Maximum="100000"
                        Minimum="100"
                        SpinButtonPlacementMode="Compact"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard
                    x:Uid="ViewBittorrentSettingsPageSettingsCard"
                    Description="Client identification string sent to peers"
                    Header="Peer Fingerprint">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AF;" />
                    </essential:SettingsCard.HeaderIcon>
                    <TextBox
                        x:Name="PeerFingerprintTextBox"
                        x:Uid="ViewBittorrentSettingsPageTextBox"
                        MinWidth="180"
                        LostFocus="OnSettingChanged"
                        PlaceholderText="-ON0100-" />
                </essential:SettingsCard>

                <essential:SettingsExpander Description="Settings shared by the native UI, qBittorrent WebUI and VueTorrent" Header="Advanced performance, network and tracker">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard Header="Hashing threads">
                            <NumberBox
                                x:Name="HashingThreadsNumberBox"
                                Maximum="64"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="File pool size">
                            <NumberBox
                                x:Name="FilePoolSizeNumberBox"
                                Maximum="10000"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Disk queue size (KiB)">
                            <NumberBox
                                x:Name="DiskQueueSizeNumberBox"
                                Maximum="1048576"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Use piece extent affinity">
                            <ToggleSwitch x:Name="PieceExtentAffinityToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Send upload piece suggestions">
                            <ToggleSwitch x:Name="UploadSuggestionsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Send buffer watermark (KiB)">
                            <NumberBox
                                x:Name="SendBufferWatermarkNumberBox"
                                Maximum="1048576"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Send buffer low watermark (KiB)">
                            <NumberBox
                                x:Name="SendBufferLowWatermarkNumberBox"
                                Maximum="1048576"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Send buffer watermark factor (%)">
                            <NumberBox
                                x:Name="SendBufferWatermarkFactorNumberBox"
                                Maximum="1000"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsExpander Description="Connection scheduling, socket and peer policies" Header="Advanced network behavior">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard Header="Outgoing connections per second">
                            <NumberBox
                                x:Name="ConnectionSpeedNumberBox"
                                Maximum="10000"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Allow outgoing connections when seeding">
                            <ToggleSwitch x:Name="SeedingOutgoingConnectionsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Socket send buffer size (KiB)">
                            <NumberBox
                                x:Name="SocketSendBufferSizeNumberBox"
                                Maximum="1048576"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Socket receive buffer size (KiB)">
                            <NumberBox
                                x:Name="SocketReceiveBufferSizeNumberBox"
                                Maximum="1048576"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Socket backlog size">
                            <NumberBox
                                x:Name="SocketBacklogSizeNumberBox"
                                Maximum="10000"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="μTP/TCP mixed mode">
                            <ComboBox
                                x:Name="MixedModeComboBox"
                                SelectedIndex="0"
                                SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Prefer TCP" />
                                <ComboBoxItem Content="Peer proportional" />
                            </ComboBox>
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Hostname cache TTL (seconds)">
                            <NumberBox
                                x:Name="HostnameCacheTtlNumberBox"
                                Maximum="86400"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Validate HTTPS tracker certificates">
                            <ToggleSwitch x:Name="ValidateHttpsTrackersToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="SSRF mitigation">
                            <ToggleSwitch x:Name="SsrfMitigationToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Block peers on privileged ports">
                            <ToggleSwitch x:Name="BlockPrivilegedPortsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Upload slots behavior">
                            <ComboBox
                                x:Name="UploadSlotsBehaviorComboBox"
                                SelectedIndex="0"
                                SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Fixed slots" />
                                <ComboBoxItem Content="Upload rate based" />
                            </ComboBox>
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Upload choking algorithm">
                            <ComboBox
                                x:Name="UploadChokingAlgorithmComboBox"
                                SelectedIndex="1"
                                SelectionChanged="OnSettingChanged">
                                <ComboBoxItem Content="Round-robin" />
                                <ComboBoxItem Content="Fastest upload" />
                                <ComboBoxItem Content="Anti-leech" />
                            </ComboBox>
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsExpander Description="Announce identity, tracker concurrency and peer turnover" Header="Advanced tracker behavior">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard Header="DHT bootstrap nodes">
                            <TextBox
                                x:Name="DhtBootstrapNodesTextBox"
                                MinWidth="240"
                                LostFocus="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="IP reported to trackers">
                            <TextBox
                                x:Name="AnnounceIpTextBox"
                                MinWidth="180"
                                LostFocus="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Port reported to trackers">
                            <NumberBox
                                x:Name="AnnouncePortNumberBox"
                                Maximum="65535"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Maximum concurrent HTTP announces">
                            <NumberBox
                                x:Name="MaxConcurrentHttpAnnouncesNumberBox"
                                Maximum="10000"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Stop tracker timeout (seconds)">
                            <NumberBox
                                x:Name="StopTrackerTimeoutNumberBox"
                                Maximum="3600"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Peer turnover disconnect (%)">
                            <NumberBox
                                x:Name="PeerTurnoverNumberBox"
                                Maximum="100"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Peer turnover threshold (%)">
                            <NumberBox
                                x:Name="PeerTurnoverCutoffNumberBox"
                                Maximum="100"
                                Minimum="0"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Peer turnover interval (seconds)">
                            <NumberBox
                                x:Name="PeerTurnoverIntervalNumberBox"
                                Maximum="86400"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard Header="Maximum outstanding requests per peer">
                            <NumberBox
                                x:Name="RequestQueueSizeNumberBox"
                                Maximum="100000"
                                Minimum="1"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsExpander
                    x:Uid="ViewBittorrentSettingsPageSettingsExpander"
                    Description="Default behavior for new downloads"
                    Header="Download Defaults">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="ViewBittorrentSettingsPageSettingsCard" Header="Default Save Path">
                            <TextBox
                                x:Name="DefaultSavePathTextBox"
                                x:Uid="ViewBittorrentSettingsPageTextBox"
                                MinWidth="300"
                                LostFocus="OnSettingChanged"
                                PlaceholderText="Downloads folder" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="ViewBittorrentSettingsPageSettingsCard" Header="Pre-allocate Storage">
                            <ToggleSwitch x:Name="PreallocateStorageToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="ViewBittorrentSettingsPageSettingsCard" Header="Auto-start Downloads">
                            <ToggleSwitch x:Name="AutoStartDownloadsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="ViewBittorrentSettingsPageSettingsCard" Header="Move Completed Downloads">
                            <ToggleSwitch x:Name="MoveCompletedToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="ViewBittorrentSettingsPageSettingsCard" Header="Move Completed Path">
                            <TextBox
                                x:Name="MoveCompletedPathTextBox"
                                MinWidth="300"
                                LostFocus="OnSettingChanged"
                                PlaceholderText="" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
