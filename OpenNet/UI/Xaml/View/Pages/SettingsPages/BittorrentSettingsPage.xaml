<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.BittorrentSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!--  Header  -->
                <TextBlock x:Uid="BT_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="BT_Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}" />

                <!--  Connection  -->
                <TextBlock x:Uid="BT_Section_Connection" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_ConnectionsLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE839;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="ConnectionsLimitNumberBox"
                        Maximum="65535"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsExpander x:Uid="BT_Protocol">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_IncomingTcp">
                            <ToggleSwitch x:Name="EnableIncomingTcpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_OutgoingTcp">
                            <ToggleSwitch x:Name="EnableOutgoingTcpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_IncomingUtp">
                            <ToggleSwitch x:Name="EnableIncomingUtpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_OutgoingUtp">
                            <ToggleSwitch x:Name="EnableOutgoingUtpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_MultiConnPerIp">
                            <ToggleSwitch x:Name="AllowMultipleConnectionsPerIpToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsCard x:Uid="BT_AnonymousMode">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AnonymousModeToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Discovery  -->
                <TextBlock x:Uid="BT_Section_Discovery" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_EnableDht">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE909;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="EnableDhtToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_EnableLsd">
                    <ToggleSwitch x:Name="EnableLsdToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_EnableUpnp">
                    <ToggleSwitch x:Name="EnableUpnpToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_EnableNatpmp">
                    <ToggleSwitch x:Name="EnableNatpmpToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_ApplyIpFilterToDht">
                    <ToggleSwitch x:Name="ApplyIpFilterToDhtToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard
                    x:Uid="BT_UpnpLeaseDuration"
                    Description="Use 0 for a permanent mapping. A finite lease is refreshed at 75% of its duration."
                    Header="UPnP lease duration (seconds)">
                    <NumberBox
                        x:Name="UpnpLeaseDurationNumberBox"
                        Maximum="86400"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Tracker  -->
                <TextBlock x:Uid="BT_Section_Tracker" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_AnnounceAllTiers">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="AnnounceToAllTiersToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_AnnounceAllTrackers">
                    <ToggleSwitch x:Name="AnnounceToAllTrackersToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_NatPmpGateway">
                    <TextBox
                        x:Name="NatPmpGatewayTextBox"
                        MinWidth="200"
                        LostFocus="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_NatPmpLeaseDuration">
                    <NumberBox
                        x:Name="NatPmpLeaseDurationNumberBox"
                        Maximum="86400"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsExpander x:Uid="BT_WebTorrent">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="EnableWebTorrentToggle" Toggled="OnSettingChanged" />
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_WebTorrentStunServer" IsEnabled="{Binding IsOn, ElementName=EnableWebTorrentToggle, Mode=OneWay}">
                            <TextBox
                                x:Name="WebTorrentStunServerTextBox"
                                MinWidth="220"
                                LostFocus="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_WebTorrentOffers" IsEnabled="{Binding IsOn, ElementName=EnableWebTorrentToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="MaxWebTorrentOffersNumberBox"
                                Maximum="100"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_WebTorrentTimeout" IsEnabled="{Binding IsOn, ElementName=EnableWebTorrentToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="WebTorrentConnectionTimeoutNumberBox"
                                Maximum="3600"
                                Minimum="5"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_WebSocketAnnounceInterval" IsEnabled="{Binding IsOn, ElementName=EnableWebTorrentToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="MinWebSocketAnnounceIntervalNumberBox"
                                Maximum="3600"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <!--  Limits  -->
                <TextBlock x:Uid="BT_Section_Limits" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_QueueingEnabled">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8EF;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="QueueingEnabledToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_ActiveDownloads" IsEnabled="{Binding IsOn, ElementName=QueueingEnabledToggle, Mode=OneWay}">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="ActiveDownloadsNumberBox"
                        Maximum="9999"
                        Minimum="-1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_ActiveSeeds" IsEnabled="{Binding IsOn, ElementName=QueueingEnabledToggle, Mode=OneWay}">
                    <NumberBox
                        x:Name="ActiveSeedsNumberBox"
                        Maximum="9999"
                        Minimum="-1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_ActiveLimit" IsEnabled="{Binding IsOn, ElementName=QueueingEnabledToggle, Mode=OneWay}">
                    <NumberBox
                        x:Name="ActiveLimitNumberBox"
                        Maximum="9999"
                        Minimum="-1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Speed Limits  -->
                <TextBlock x:Uid="BT_Section_SpeedLimits" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_DownloadRateLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE896;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="DownloadRateLimitNumberBox"
                        Maximum="999999"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_UploadRateLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE898;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="UploadRateLimitNumberBox"
                        Maximum="999999"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Seeding  -->
                <TextBlock x:Uid="BT_Section_Seeding" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_SeedRatioLimit">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72C;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="SeedRatioLimitNumberBox"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="0.1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_SeedTimeLimit">
                    <NumberBox
                        x:Name="SeedTimeLimitNumberBox"
                        Maximum="99999"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Peer  -->
                <TextBlock x:Uid="BT_Section_Peer" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsExpander x:Uid="BT_Timeouts">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE916;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_PeerTimeout">
                            <NumberBox
                                x:Name="PeerTimeoutNumberBox"
                                Maximum="600"
                                Minimum="5"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_HandshakeTimeout">
                            <NumberBox
                                x:Name="HandshakeTimeoutNumberBox"
                                Maximum="120"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsCard x:Uid="BT_CloseRedundant">
                    <ToggleSwitch x:Name="CloseRedundantConnectionsToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Disk I/O  -->
                <TextBlock x:Uid="BT_Section_DiskIO" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_AioThreads">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="AioThreadsNumberBox"
                        Maximum="64"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_CheckingMemUsage">
                    <NumberBox
                        x:Name="CheckingMemUsageNumberBox"
                        Maximum="2048"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard
                    x:Uid="BT_DiskQueueSize"
                    Description="Maximum memory used by queued disk operations; 0 selects the engine default"
                    Header="Disk I/O queue memory (KiB)">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEDA2;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="DiskQueueSizeNumberBox"
                        Maximum="1048576"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_DisableV1HashesForHybrid">
                    <ToggleSwitch x:Name="DisableV1HashesForHybridToggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_PartFileDirectory">
                    <TextBox
                        x:Name="PartFileDirectoryTextBox"
                        MinWidth="220"
                        LostFocus="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_MaxTorrentDirectoryDepth">
                    <NumberBox
                        x:Name="MaxTorrentDirectoryDepthNumberBox"
                        Maximum="1000"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Identity  -->
                <TextBlock x:Uid="BT_Section_Identity" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_UserAgent">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE77B;" />
                    </essential:SettingsCard.HeaderIcon>
                    <TextBox
                        x:Name="UserAgentTextBox"
                        x:Uid="BT_UserAgentInput"
                        MinWidth="220"
                        LostFocus="OnSettingChanged"
                        PlaceholderText="libtorrent/2.1.1" />
                </essential:SettingsCard>

                <!--  Encryption  -->
                <TextBlock x:Uid="BT_Section_Encryption" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_EncryptionPolicy">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="EncryptionPolicyComboBox"
                        MinWidth="180"
                        essential:ComboBoxHelper.AcrylicWorkaround="True"
                        SelectionChanged="OnSettingChanged">
                        <ComboBoxItem x:Uid="BT_Enc_Forced" Tag="0" />
                        <ComboBoxItem x:Uid="BT_Enc_Enabled" Tag="1" />
                        <ComboBoxItem x:Uid="BT_Enc_Disabled" Tag="2" />
                    </ComboBox>
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="BT_PreferRc4">
                    <ToggleSwitch x:Name="PreferRc4Toggle" Toggled="OnSettingChanged" />
                </essential:SettingsCard>

                <!--  Proxy  -->
                <TextBlock x:Uid="BT_Section_Proxy" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="BT_ProxyType">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE968;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ComboBox
                        x:Name="ProxyTypeComboBox"
                        MinWidth="180"
                        essential:ComboBoxHelper.AcrylicWorkaround="True"
                        SelectionChanged="OnSettingChanged">
                        <ComboBoxItem x:Uid="BT_Proxy_None" Tag="0" />
                        <ComboBoxItem x:Uid="BT_Proxy_Socks4" Tag="1" />
                        <ComboBoxItem x:Uid="BT_Proxy_Socks5" Tag="2" />
                        <ComboBoxItem x:Uid="BT_Proxy_Socks5Pw" Tag="3" />
                        <ComboBoxItem x:Uid="BT_Proxy_Http" Tag="4" />
                        <ComboBoxItem x:Uid="BT_Proxy_HttpPw" Tag="5" />
                        <ComboBoxItem x:Uid="BT_Proxy_I2p" Tag="6" />
                    </ComboBox>
                </essential:SettingsCard>

                <essential:SettingsExpander x:Uid="BT_ProxyDetails">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_ProxyHostname">
                            <TextBox
                                x:Name="ProxyHostnameTextBox"
                                x:Uid="BT_ProxyHostnameInput"
                                MinWidth="200"
                                LostFocus="OnSettingChanged"
                                PlaceholderText="proxy.example.com" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyPort">
                            <NumberBox
                                x:Name="ProxyPortNumberBox"
                                Maximum="65535"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyUsername">
                            <TextBox
                                x:Name="ProxyUsernameTextBox"
                                MinWidth="200"
                                LostFocus="OnSettingChanged"
                                PlaceholderText="" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyPassword">
                            <PasswordBox
                                x:Name="ProxyPasswordBox"
                                MinWidth="200"
                                LostFocus="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyPeerConn">
                            <ToggleSwitch x:Name="ProxyPeerConnectionsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxyTrackerConn">
                            <ToggleSwitch x:Name="ProxyTrackerConnectionsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_ProxySendHostInConnect">
                            <ToggleSwitch x:Name="ProxySendHostInConnectToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsExpander x:Uid="BT_I2p">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="EnableI2pToggle" Toggled="OnSettingChanged" />
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_I2pHostname" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <TextBox
                                x:Name="I2pHostnameTextBox"
                                MinWidth="200"
                                LostFocus="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pPort" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="I2pPortNumberBox"
                                Maximum="65535"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pMixedMode" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <ToggleSwitch x:Name="AllowI2pMixedToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pInboundQuantity" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="I2pInboundQuantityNumberBox"
                                Maximum="16"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pOutboundQuantity" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="I2pOutboundQuantityNumberBox"
                                Maximum="16"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pInboundLength" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="I2pInboundLengthNumberBox"
                                Maximum="7"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pOutboundLength" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="I2pOutboundLengthNumberBox"
                                Maximum="7"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pInboundVariance" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="I2pInboundVarianceNumberBox"
                                Maximum="7"
                                Minimum="-7"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_I2pOutboundVariance" IsEnabled="{Binding IsOn, ElementName=EnableI2pToggle, Mode=OneWay}">
                            <NumberBox
                                x:Name="I2pOutboundVarianceNumberBox"
                                Maximum="7"
                                Minimum="-7"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <!--  libtorrent Advanced  -->
                <TextBlock
                    x:Uid="BT_AdvancedSectionHeader"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Advanced libtorrent" />

                <essential:SettingsCard
                    x:Uid="BT_MaxPeerListSize"
                    Description="Maximum number of peers in peer list (default: 4000)"
                    Header="Max Peer List Size">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE716;" />
                    </essential:SettingsCard.HeaderIcon>
                    <NumberBox
                        x:Name="MaxPeerListSizeNumberBox"
                        Maximum="100000"
                        Minimum="100"
                        SpinButtonPlacementMode="Inline"
                        ValueChanged="OnSettingChanged" />
                </essential:SettingsCard>

                <essential:SettingsCard
                    x:Uid="BT_PeerFingerprint"
                    Description="Client identification string sent to peers"
                    Header="Peer Fingerprint">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8AF;" />
                    </essential:SettingsCard.HeaderIcon>
                    <TextBox
                        x:Name="PeerFingerprintTextBox"
                        x:Uid="BT_PeerFingerprintInput"
                        MinWidth="180"
                        LostFocus="OnSettingChanged"
                        PlaceholderText="-ON0100-" />
                </essential:SettingsCard>

                <essential:SettingsExpander
                    x:Uid="BT_AdvancedPerformance"
                    Description="Settings shared by the native UI, qBittorrent WebUI and VueTorrent"
                    Header="Advanced performance, network and tracker">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE950;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard x:Uid="BT_HashingThreads" Header="Hashing threads">
                            <NumberBox
                                x:Name="HashingThreadsNumberBox"
                                Maximum="64"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_FilePoolSize" Header="File pool size">
                            <NumberBox
                                x:Name="FilePoolSizeNumberBox"
                                Maximum="10000"
                                Minimum="1"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_PieceExtentAffinity" Header="Use piece extent affinity">
                            <ToggleSwitch x:Name="PieceExtentAffinityToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_UploadSuggestions" Header="Send upload piece suggestions">
                            <ToggleSwitch x:Name="UploadSuggestionsToggle" Toggled="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_SendBufferWatermark" Header="Send buffer watermark (KiB)">
                            <NumberBox
                                x:Name="SendBufferWatermarkNumberBox"
                                Maximum="1048576"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_SendBufferLowWatermark" Header="Send buffer low watermark (KiB)">
                            <NumberBox
                                x:Name="SendBufferLowWatermarkNumberBox"
                                Maximum="1048576"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard x:Uid="BT_SendBufferWatermarkFactor" Header="Send buffer watermark factor (%)">
                            <NumberBox
                                x:Name="SendBufferWatermarkFactorNumberBox"
                                Maximum="1000"
                                Minimum="0"
                                SpinButtonPlacementMode="Inline"
                                ValueChanged="OnSettingChanged" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

