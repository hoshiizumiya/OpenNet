<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.MainSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:pages="using:OpenNet.UI.Xaml.View.Pages"
    xmlns:wl="using:WinUI.LiquidGlass"
    Loaded="MainSettingsPage_Loaded"
    NavigationCacheMode="Disabled"
    PointerPressed="MainSettingsPage_PointerPressed"
    mc:Ignorable="d">

    <NavigationView
        x:Name="SettingsNavView"
        essential:NavigationViewHelper.AcrylicWorkaround="True"
        CompactPaneLength="70"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        OpenPaneLength="200"
        PaneDisplayMode="Left"
        SelectionChanged="SettingsNavView_SelectionChanged">
        <NavigationView.Resources>
            <!-- Align the expanded header with the settings content without
                 translating the BreadcrumbBar outside its layout slot. -->
            <Thickness x:Key="NavigationViewHeaderMargin">24,32,24,0</Thickness>
        </NavigationView.Resources>
        <NavigationView.PaneCustomContent>
            <essential:SwitchPresenter x:Name="SettingsSearchBoxMaterialHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" ouxct:ControlAppearance.IsMaterialHost="True" Value="{x:Bind ouxct:MaterialControlState.BoxInt32(ouxct:MaterialControlState.Current.SearchBoxMaterial), Mode=OneWay}" Margin="8,8,8,12">
                <essential:Case><essential:Case.Value><x:Int32>0</x:Int32></essential:Case.Value>
                    <AutoSuggestBox
                x:Uid="SettingsSearchBox"
                essential:AutoSuggestBoxHelper.AcrylicWorkaround="True"
                AutomationProperties.AutomationId="SettingsSearchBox"
                PlaceholderText="Search settings"
                QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                TextChanged="SettingsSearchBox_TextChanged" x:Name="SettingsSearchBox">
                <AutoSuggestBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </AutoSuggestBox.QueryIcon>
            </AutoSuggestBox>
                </essential:Case>
                <essential:Case><essential:Case.Value><x:Int32>1</x:Int32></essential:Case.Value>
                    <wl:LiquidGlassSearchBox
                x:Uid="SettingsSearchBox"
                AutomationProperties.AutomationId="SettingsSearchBox"
                PlaceholderText="Search settings"
                QuerySubmitted="SettingsSearchBox_QuerySubmitted"
                TextChanged="SettingsSearchBox_TextChanged" x:Name="SettingsSearchBoxGlass" ouxct:MaterialControlState.IsManaged="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <wl:LiquidGlassSearchBox.QueryIcon>
                    <SymbolIcon Symbol="Find" />
                </wl:LiquidGlassSearchBox.QueryIcon>
            </wl:LiquidGlassSearchBox>
                </essential:Case>
            </essential:SwitchPresenter>
        </NavigationView.PaneCustomContent>
        <NavigationView.Header>
            <BreadcrumbBar
                x:Name="MainSettingsPageBar"
                VerticalAlignment="Center"
                VerticalContentAlignment="Center"
                x:FieldModifier="Public"
                ItemClicked="SettingsBar_ItemClicked"
                ItemsSource="{x:Bind SettingsBarItems}">
                <BreadcrumbBar.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            FontSize="24"
                            TextWrapping="NoWrap"
                            Text="{x:Bind}" />
                    </DataTemplate>
                </BreadcrumbBar.ItemTemplate>
            </BreadcrumbBar>
        </NavigationView.Header>

        <NavigationView.MenuItems>
            <NavigationViewItem
                x:Name="GeneralNavItem"
                x:Uid="SettingsGeneralNavItem"
                AutomationProperties.AutomationId="SettingsGeneralNavItem"
                Content="General"
                Icon="{essential:FontIcon Glyph=&#xE713;}"
                Tag="{essential:TypeName Type=local:SettingsPage}">
                <!--<NavigationViewItem.InfoBadge>
                    <InfoBadge />
                </NavigationViewItem.InfoBadge>-->
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem
                x:Name="BitTorrentNavItem"
                x:Uid="SettingsBitTorrentNavItem"
                AutomationProperties.AutomationId="SettingsBitTorrentNavItem"
                Content="BitTorrent"
                IsExpanded="True"
                Tag="{essential:TypeName Type=local:BittorrentSettingsPage}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE703;" />
                </NavigationViewItem.Icon>
                <NavigationViewItem.MenuItems>
                    <NavigationViewItem
                        x:Name="NetworkNavItem"
                        x:Uid="SettingsNetworkNavItem"
                        AutomationProperties.AutomationId="SettingsNetworkNavItem"
                        Content="Network"
                        Tag="{essential:TypeName Type=local:BittorrentSettingsPage}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE968;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="TrackerNavItem"
                        x:Uid="SettingsTrackerNavItem"
                        AutomationProperties.AutomationId="SettingsTrackerNavItem"
                        Content="Tracker"
                        Tag="{essential:TypeName Type=pages:NetworkSettingsPage}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE774;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="IPFilterNavItem"
                        x:Uid="SettingsIPFilterNavItem"
                        AutomationProperties.AutomationId="SettingsIPFilterNavItem"
                        Content="IP Filter"
                        Tag="{essential:TypeName Type=local:IPFilterSettingsPage}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8D7;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem
                        x:Name="ClientFilterNavItem"
                        x:Uid="ClientFilterNavItem"
                        AutomationProperties.AutomationId="ClientFilterNavItem"
                        Content="Client Filter"
                        Tag="{essential:TypeName Type=local:ClientFilterSettingsPage}">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE71C;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="DownloadBehaviorNavItem"
                x:Uid="SettingsDownloadNavItem"
                AutomationProperties.AutomationId="SettingsDownloadNavItem"
                Content="DownloadBehavior"
                Tag="{essential:TypeName Type=local:DownloadSettingsPage}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE896;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="WebUINavItem"
                x:Uid="SettingsWebUINavItem"
                AutomationProperties.AutomationId="SettingsWebUINavItem"
                Content="Web UI"
                Tag="{essential:TypeName Type=local:WebUISettingsPage}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE774;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem
                x:Name="AppearanceNavItem"
                x:Uid="Appearance"
                AutomationProperties.AutomationId="Appearance"
                Content="Appearance"
                Tag="{essential:TypeName Type=local:ThemesSettingsPage}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE771;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemSeparator />

            <NavigationViewItem
                x:Name="AboutNavItem"
                x:Uid="SettingsAboutNavItem"
                AutomationProperties.AutomationId="SettingsAboutNavItem"
                Content="About"
                Tag="{essential:TypeName Type=local:AboutPage}">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE946;" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <Frame x:Name="SettingsFrame" Navigated="SettingsFrame_Navigated">
            <Frame.ContentTransitions>
                <TransitionCollection>
                    <NavigationThemeTransition />
                </TransitionCollection>
            </Frame.ContentTransitions>
        </Frame>
    </NavigationView>
</Page>
