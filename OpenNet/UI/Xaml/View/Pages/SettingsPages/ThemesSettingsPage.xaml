<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.ThemesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!--  Merge external resource dictionaries  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/CustomThemeBrushes.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Page.Resources>

    <ScrollView Margin="24">
        <StackPanel MinWidth="300" Spacing="{StaticResource SettingsCardSpacing}">
            <!--<essential:SettingsCard
                x:Name="SoftPersonalization"
                x:Uid="SoftPersonalization"
                Margin="0,3,0,3"
                IsClickEnabled="True">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon FontSize="12" Glyph="&#xE771;" />
                </essential:SettingsCard.HeaderIcon>

            </essential:SettingsCard>-->

            <TextBlock
                Padding="10"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Appearance" />

            <!--  Background  -->
            <essential:SettingsExpander
                x:Uid="ViewThemesSettingsPageBackgroundExpander"
                Description="应用的背景类型"
                Header="背景"
                IsExpanded="True">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xef1f;" />
                </essential:SettingsExpander.HeaderIcon>
                <ComboBox
                    x:Name="BackgroundComboBox"
                    MinWidth="150"
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectionChanged="BackgroundComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundStatic" Content="Static" />
                    <ComboBoxItem
                        x:Name="MicaComboBoxItem"
                        x:Uid="ViewThemesSettingsPageBackgroundMica"
                        Content="Mica" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundCustomMica" Content="Custom Mica" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundAcrylic" Content="Acrylic" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundCustomAcrylic" Content="Custom Acrylic" />
                </ComboBox>
                <essential:SettingsExpander.Items>
                    <!--  Acrylic  -->
                    <essential:SettingsCard
                        x:Name="AcrylicTypeCard"
                        x:Uid="ViewThemesSettingsPageAcrylicTypeCard"
                        Description="背景的亚克力效果模式"
                        Header="亚克力类型"
                        HeaderIcon="{essential:FontIcon Glyph=&#xF5EF;}"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <ComboBox
                            x:Name="AcrylicTypeComboBox"
                            MinWidth="150"
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="AcrylicTypeComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageAcrylicTypeDefault" Content="Default" />
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageAcrylicTypeBase" Content="Base" />
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageAcrylicTypeThin" Content="Thin" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <!--  Mica  -->
                    <essential:SettingsCard
                        x:Name="MicaTypeCard"
                        x:Uid="ViewThemesSettingsPageMicaTypeCard"
                        Description="背景的 Mica 效果模式"
                        Header="Mica 类型"
                        HeaderIcon="{essential:FontIcon Glyph=&#xF5EF;}"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <ComboBox
                            x:Name="MicaTypeComboBox"
                            MinWidth="150"
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="MicaTypeComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageMicaTypeBase" Content="Base" />
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageMicaTypeBaseAlt" Content="Alt" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <!--  TenMica (Fallback)  -->
                    <essential:SettingsCard
                        x:Uid="ViewThemesSettingsPageMicaErrorFallback"
                        Description="Enable fallback when Mica is unavailable (Win10)"
                        Header="Mica error fallback"
                        IsClickEnabled="False"
                        IsEnabled="{x:Bind MicaComboBoxItem.IsSelected, Mode=OneWay}">
                        <ToggleSwitch
                            x:Name="BackdropFallbackSwitch"
                            IsOn="False"
                            Toggled="BackdropFallbackSwitch_Toggled" />
                    </essential:SettingsCard>
                    <!--  Theme color custom  -->
                    <essential:SettingsCard
                        x:Name="SoftBackground"
                        x:Uid="SoftBackgroundColors"
                        Click="NavigateToThemeSettingBackdropCustomizePageButton_Click"
                        Description="Choose your accent color and personalize it"
                        Header="Colors Style"
                        IsClickEnabled="True">
                        <essential:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </essential:SettingsCard.HeaderIcon>

                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <!--  图片背景  -->
            <essential:SettingsExpander
                x:Name="ImageBackgroundExpander"
                x:Uid="ViewThemesSettingsPageImageBackgroundExpander"
                Description="在背景层添加自定义图片"
                Header="图片背景"
                IsExpanded="True">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xee71;" />
                </essential:SettingsExpander.HeaderIcon>
                <ComboBox
                    x:Name="ImageModeComboBox"
                    MinWidth="150"
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectionChanged="ImageModeComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageImageModeNone" Content="None" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageImageModeSingle" Content="Single image" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageImageModeFolder" Content="Local folder" />
                </ComboBox>
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard
                        x:Name="ImageSourceCard"
                        x:Uid="ViewThemesSettingsPageSetImageCard"
                        ActionIcon="&#xE8A7;"
                        Click="SetImageButton_Click"
                        Description="Choose a single image or a folder containing images"
                        Header="Background image source"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <TextBlock
                            x:Name="ImagePathText"
                            MaxWidth="360"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="ClearImageCard"
                        x:Uid="ViewThemesSettingsPageClearImageCard"
                        Click="ClearImageButton_Click"
                        Description="清除已经设置的图片背景"
                        Header="清除背景"
                        IsActionIconVisible="True"
                        IsClickEnabled="True" />
                    <essential:SettingsCard
                        x:Name="ImageStretchCard"
                        x:Uid="ViewThemesSettingsPageImageStretchCard"
                        Description="背景中图片大小的设置方式"
                        Header="图片拉伸模式"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <ComboBox
                            x:Name="ImageStretchComboBox"
                            Width="Auto"
                            MinWidth="150"
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="ImageStretchComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxNone" Content="None" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxFill" Content="Fill" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxUniform" Content="Uniform" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxUniformToFill" Content="Uniform To Fill" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="ImageOpacityCard"
                        x:Uid="ViewThemesSettingsPageImageOpacityCard"
                        Description="图片在背景中的透明度，会覆盖窗口色"
                        Header="透明度"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Slider
                                x:Name="ImageOpacitySlider"
                                Width="300"
                                Margin="0,0,10,0"
                                essential:SliderHelper.AcrylicWorkaround="True"
                                Maximum="100"
                                Minimum="0"
                                ValueChanged="ImageOpacitySlider_ValueChanged"
                                Value="20" />
                        </StackPanel>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="BackgroundRotationCard"
                        x:Uid="ViewThemesSettingsPageBackgroundRotationCard"
                        Description="How often a new file is selected when a local folder is used"
                        Header="Rotation interval"
                        IsClickEnabled="False">
                        <NumberBox
                            x:Name="BackgroundRotationMinutesBox"
                            x:Uid="ViewThemesSettingsPageBackgroundRotationMinutesBox"
                            Width="140"
                            Header="Minutes"
                            Maximum="1440"
                            Minimum="1"
                            SpinButtonPlacementMode="Compact"
                            ValueChanged="BackgroundRotationMinutesBox_ValueChanged" />
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <!--  视频背景  -->
            <essential:SettingsExpander
                x:Name="VideoBackgroundExpander"
                x:Uid="ViewThemesSettingsPageVideoBackgroundExpander"
                Description="Play a local video behind the main content"
                Header="Video background"
                IsExpanded="False">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE714;" />
                </essential:SettingsExpander.HeaderIcon>
                <ComboBox
                    x:Name="VideoModeComboBox"
                    MinWidth="150"
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectionChanged="VideoModeComboBox_SelectionChanged">
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageVideoModeNone" Content="None" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageVideoModeSingle" Content="Single video" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageVideoModeFolder" Content="Local folder" />
                </ComboBox>
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard
                        x:Name="VideoSourceCard"
                        x:Uid="ViewThemesSettingsPageVideoSourceCard"
                        ActionIcon="&#xE8A7;"
                        Click="SetVideoButton_Click"
                        Description="Choose a video or a folder containing videos"
                        Header="Background video source"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <TextBlock
                            x:Name="VideoPathText"
                            MaxWidth="360"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="ClearVideoCard"
                        x:Uid="ViewThemesSettingsPageClearVideoCard"
                        Click="ClearVideoButton_Click"
                        Description="Stop playback and clear the configured video source"
                        Header="Clear video background"
                        IsActionIconVisible="True"
                        IsClickEnabled="True" />
                    <essential:SettingsCard
                        x:Name="VideoMutedCard"
                        x:Uid="ViewThemesSettingsPageVideoMutedCard"
                        Header="Mute background video"
                        HeaderIcon="{essential:FontIcon Glyph=&#xE8D6;}">
                        <ToggleSwitch x:Name="VideoMutedSwitch" Toggled="VideoMutedSwitch_Toggled" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="VideoLoopingCard"
                        x:Uid="ViewThemesSettingsPageVideoLoopingCard"
                        Header="Loop video"
                        HeaderIcon="{essential:FontIcon Glyph=&#xE8ED;}">
                        <ToggleSwitch x:Name="VideoLoopingSwitch" Toggled="VideoLoopingSwitch_Toggled" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="VideoStretchCard"
                        x:Uid="ViewThemesSettingsPageVideoStretchCard"
                        Description="How the video fills the window"
                        Header="Video stretch mode"
                        IsClickEnabled="False">
                        <ComboBox
                            x:Name="VideoStretchComboBox"
                            MinWidth="150"
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="VideoStretchComboBox_SelectionChanged">
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxNone" Content="None" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxFill" Content="Fill" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxUniform" Content="Uniform" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxUniformToFill" Content="Uniform To Fill" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="VideoOpacityCard"
                        x:Uid="ViewThemesSettingsPageVideoOpacityCard"
                        Description="Video opacity above the image/backdrop layer"
                        Header="Video opacity"
                        IsClickEnabled="False">
                        <Slider
                            x:Name="VideoOpacitySlider"
                            Width="300"
                            essential:SliderHelper.AcrylicWorkaround="True"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="VideoOpacitySlider_ValueChanged" />
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Font" />

            <essential:SettingsCard
                x:Name="FontSetting"
                x:Uid="ViewThemesSettingsPageFontSetting"
                Click="NavigateToThemeSettingFontSettingPageButton_Click"
                Description="Font size"
                Header="Font Setting"
                HeaderIcon="{essential:FontIcon Glyph=&#xE8D2;,
                                                FontFamily=Segoe Fluent Icons}"
                IsClickEnabled="True" />

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>

    </ScrollView>
</Page>
