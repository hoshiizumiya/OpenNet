<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.ThemesSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <!--  Merge external resource dictionaries  -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Styles/SettingsStyles.xaml" />
                <ResourceDictionary Source="ms-appx:///Styles/CustomThemeBrushes.xaml" />
                <ouxct:MaterialSettingsResources />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </Page.Resources>

    <ScrollView Margin="24">
        <StackPanel MinWidth="300" Spacing="{StaticResource SettingsCardSpacing}">
            <!--<essential:SettingsCard
                x:Name="SoftPersonalization"
                x:Uid="SoftPersonalization"
                Margin="0,3,0,3"
                IsClickEnabled="True">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon FontSize="12" Glyph="&#xE771;" />
                </essential:SettingsCard.HeaderIcon>

            </essential:SettingsCard>-->

            <!--<TextBlock
                x:Uid="ThemesAppearanceSectionHeader"
                Padding="10"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Appearance" />-->

            <TextBlock
                x:Uid="TaskProgressAppearanceHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Task progress" />
            <essential:SettingsExpander
                x:Uid="TaskProgressExpander"
                Description="Choose where the highlight appears and customize its colors."
                Header="Task progress effects"
                IsExpanded="False">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE9CE;" />
                </essential:SettingsExpander.HeaderIcon>
                <ToggleSwitch x:Uid="TaskProgressEffectsSwitch" IsOn="{x:Bind ViewModel.ProgressEffectsEnabled, Mode=TwoWay}" x:Name="MaterialNative_250"
                    ouxct:ControlAppearance.IsEnabled="True" />
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard
                        x:Uid="TaskProgressScopeCard"
                        Description="Choose the progress cell or the full task row."
                        Header="Highlight area">
                        <ComboBox SelectedIndex="{x:Bind ViewModel.ProgressEffectScope, Mode=TwoWay}" x:Name="GlassPresenter_3555" MinWidth="175"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <ComboBoxItem x:Uid="TaskProgressScopeColumn" Content="Progress cell" />
                            <ComboBoxItem x:Uid="TaskProgressScopeRow" Content="Entire task row" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Uid="TaskProgressPreviewCard"
                        Description="A sample download using the selected colors and area."
                        Header="Preview">
                        <Grid
                            Height="42"
                            MinWidth="280"
                            MaxWidth="370"
                            ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <essential:ProgressBarEx
                                Grid.ColumnSpan="3"
                                Margin="0,2,0,2"
                                Background="Transparent"
                                BaseColor="{x:Bind ViewModel.ProgressBaseColor, Mode=OneWay}"
                                CornerRadius="8"
                                HighColor="{x:Bind ViewModel.DownloadProgressColor, Mode=OneWay}"
                                IsHitTestVisible="False"
                                Opacity="0.65"
                                Percent="58"
                                Visibility="{x:Bind ViewModel.ProgressRowPreviewVisibility, Mode=OneWay}" />
                            <TextBlock
                                x:Uid="TaskProgressPreviewName"
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="Example download" />
                            <TextBlock
                                x:Uid="TaskProgressPreviewSize"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                Text="42 MiB" />
                            <Grid Grid.Column="2">
                                <essential:ProgressBarEx
                                    Height="24"
                                    Background="Transparent"
                                    BaseColor="{x:Bind ViewModel.ProgressBaseColor, Mode=OneWay}"
                                    CornerRadius="6"
                                    HighColor="{x:Bind ViewModel.DownloadProgressColor, Mode=OneWay}"
                                    IsHitTestVisible="False"
                                    Percent="58"
                                    Visibility="{x:Bind ViewModel.ProgressColumnPreviewVisibility, Mode=OneWay}" />
                                <TextBlock
                                    Margin="4,0,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Canvas.ZIndex="1"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    IsHitTestVisible="False"
                                    Text="58%" />
                            </Grid>
                        </Grid>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Uid="TaskProgressDownloadColorCard"
                        Description="Color for HTTP and BitTorrent downloads."
                        Header="Download highlight">
                        <Button x:Uid="TaskProgressChooseDownloadColor" Content="Choose color" x:Name="GlassPresenter_7633"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <Button.Flyout>
                        <Flyout>
                            <ColorPicker
                                x:Uid="TaskProgressDownloadColorPicker"
                                IsAlphaEnabled="False"
                                IsAlphaSliderVisible="False"
                                IsAlphaTextInputVisible="False"
                                Color="{x:Bind ViewModel.DownloadProgressColor, Mode=TwoWay}" />
                        </Flyout>
                            </Button.Flyout>
                        </Button>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Uid="TaskProgressSeedingColorCard"
                        Description="Color for BitTorrent upload after download completion."
                        Header="Seeding highlight">
                        <Button x:Uid="TaskProgressChooseSeedingColor" Content="Choose color" x:Name="GlassPresenter_8669"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <Button.Flyout>
                        <Flyout>
                            <ColorPicker
                                x:Uid="TaskProgressSeedingColorPicker"
                                IsAlphaEnabled="False"
                                IsAlphaSliderVisible="False"
                                IsAlphaTextInputVisible="False"
                                Color="{x:Bind ViewModel.SeedingProgressColor, Mode=TwoWay}" />
                        </Flyout>
                            </Button.Flyout>
                        </Button>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Uid="TaskProgressCheckingColorCard"
                        Description="Color while a BitTorrent task checks its files."
                        Header="Verification highlight">
                        <Button x:Uid="TaskProgressChooseCheckingColor" Content="Choose color" x:Name="GlassPresenter_9701"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <Button.Flyout>
                        <Flyout>
                            <ColorPicker
                                x:Uid="TaskProgressCheckingColorPicker"
                                IsAlphaEnabled="False"
                                IsAlphaSliderVisible="False"
                                IsAlphaTextInputVisible="False"
                                Color="{x:Bind ViewModel.CheckingProgressColor, Mode=TwoWay}" />
                        </Flyout>
                            </Button.Flyout>
                        </Button>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Uid="TaskProgressBaseColorCard"
                        Description="Color behind the highlight; transparent by default."
                        Header="Base color">
                        <Button x:Uid="TaskProgressChooseBaseColor" Content="Choose color" x:Name="GlassPresenter_10724"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <Button.Flyout>
                        <Flyout>
                            <ColorPicker
                                x:Uid="TaskProgressBaseColorPicker"
                                IsAlphaEnabled="True"
                                IsAlphaSliderVisible="True"
                                IsAlphaTextInputVisible="True"
                                Color="{x:Bind ViewModel.ProgressBaseColor, Mode=TwoWay}" />
                        </Flyout>
                            </Button.Flyout>
                        </Button>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Uid="TaskProgressResetCard"
                        Description="Restore the default area and colors."
                        Header="Default appearance">
                        <Button
                            x:Uid="TaskProgressResetButton"
                            Command="{x:Bind ViewModel.ResetProgressAppearanceCommand}"
                            Content="Restore defaults" x:Name="GlassPresenter_11721"
                            ouxct:ControlAppearance.IsEnabled="True" />
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <essential:SettingsCard
                x:Uid="GlassControlsNavigation"
                Header="Liquid glass controls"
                Description="Choose the material and enabled control types, with interactive previews."
                IsClickEnabled="True"
                Click="OpenGlassControls">
                <essential:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></essential:SettingsCard.HeaderIcon>
            </essential:SettingsCard>
            <essential:SettingsCard
                x:Uid="GlassEffectsNavigation"
                Header="Liquid glass effects"
                Description="Customize and restore each control type's optics independently."
                IsClickEnabled="True"
                Click="OpenGlassEffects">
                <essential:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE771;" /></essential:SettingsCard.HeaderIcon>
            </essential:SettingsCard>

            <!--  Background  -->
            <essential:SettingsExpander
                x:Uid="ViewThemesSettingsPageBackgroundExpander"
                Description="App Background Type"
                Header="Background"
                IsExpanded="True">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xef1f;" />
                </essential:SettingsExpander.HeaderIcon>
                <ComboBox
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectionChanged="BackgroundComboBox_SelectionChanged" x:Name="BackgroundComboBox" MinWidth="150"
                    ouxct:ControlAppearance.IsEnabled="True">
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundStatic" Content="Static" />
                    <ComboBoxItem
                x:Name="MicaComboBoxItem"
                x:Uid="ViewThemesSettingsPageBackgroundMica"
                Content="Mica" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundCustomMica" Content="Custom Mica" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundAcrylic" Content="Acrylic" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageBackgroundCustomAcrylic" Content="Custom Acrylic" />
                </ComboBox>
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard
                        x:Uid="ViewThemesSettingsPageApplyBackgroundToSecondaryWindowsCard"
                        Description="Apply the selected backdrop to auxiliary windows"
                        Header="Apply to other windows"
                        IsClickEnabled="False">
                        <essential:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE737;" />
                        </essential:SettingsCard.HeaderIcon>
                        <ToggleSwitch
                            Loaded="ApplyBackgroundToSecondaryWindowsSwitch_Loaded"
                            Toggled="ApplyBackgroundToSecondaryWindowsSwitch_Changed" x:Name="ApplyBackgroundToSecondaryWindowsSwitch"
                            ouxct:ControlAppearance.IsEnabled="True" />
                    </essential:SettingsCard>
                    <!--  Acrylic  -->
                    <essential:SettingsCard
                        x:Name="AcrylicTypeCard"
                        x:Uid="ViewThemesSettingsPageAcrylicTypeCard"
                        Description="Background Acrylic Effect Mode"
                        Header="Acrylic Type"
                        HeaderIcon="{essential:FontIcon Glyph=&#xF5EF;}"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <ComboBox
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="AcrylicTypeComboBox_SelectionChanged" x:Name="AcrylicTypeComboBox" MinWidth="150"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageAcrylicTypeDefault" Content="Default" />
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageAcrylicTypeBase" Content="Base" />
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageAcrylicTypeThin" Content="Thin" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <!--  Mica  -->
                    <essential:SettingsCard
                        x:Name="MicaTypeCard"
                        x:Uid="ViewThemesSettingsPageMicaTypeCard"
                        Description="Background Mica Effect Mode"
                        Header="Mica Type"
                        HeaderIcon="{essential:FontIcon Glyph=&#xF5EF;}"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <ComboBox
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="MicaTypeComboBox_SelectionChanged" x:Name="MicaTypeComboBox" MinWidth="150"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageMicaTypeBase" Content="Base" />
                            <ComboBoxItem x:Uid="ViewThemesSettingsPageMicaTypeBaseAlt" Content="Alt" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <!--  TenMica (Fallback)  -->
                    <essential:SettingsCard
                        x:Uid="ViewThemesSettingsPageMicaErrorFallback"
                        Description="Enable fallback when Mica is unavailable (Win10)"
                        Header="Mica error fallback"
                        IsClickEnabled="False"
                        IsEnabled="{x:Bind MicaComboBoxItem.IsSelected, Mode=OneWay}">
                        <ToggleSwitch
                            Loaded="BackdropFallbackSwitch_Loaded"
                            Toggled="BackdropFallbackSwitch_Changed" x:Name="BackdropFallbackSwitch"
                            ouxct:ControlAppearance.IsEnabled="True" />
                    </essential:SettingsCard>
                    <!--  Theme color custom  -->
                    <essential:SettingsCard
                        x:Name="SoftBackground"
                        x:Uid="SoftBackgroundColors"
                        Click="NavigateToThemeSettingBackdropCustomizePageButton_Click"
                        Description="Choose your accent color and personalize it"
                        Header="Colors Style"
                        IsClickEnabled="True">
                        <essential:SettingsCard.HeaderIcon>
                            <FontIcon Glyph="&#xE790;" />
                        </essential:SettingsCard.HeaderIcon>

                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <essential:SettingsCard
                x:Uid="ViewThemesSettingsPageAnimatedDigitsCard"
                Description="Animate TextBlock values when their numeric content changes"
                Header="Animated numbers"
                IsClickEnabled="False">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE9D2;" />
                </essential:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    IsOn="True"
                    Loaded="AnimatedDigitsControl_Loaded"
                    Toggled="AnimatedDigitsSwitch_Changed" x:Name="AnimatedDigitsSwitch"
                    ouxct:ControlAppearance.IsEnabled="True" />
            </essential:SettingsCard>

            <!--  图片背景 Image Background  -->
            <essential:SettingsExpander
                x:Name="ImageBackgroundExpander"
                x:Uid="ViewThemesSettingsPageImageBackgroundExpander"
                Description="Show a local image behind the main content"
                Header="Image Background"
                IsExpanded="True">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon
                        FontFamily="Segoe Fluent Icons"
                        FontSize="16"
                        Glyph="&#xee71;" />
                </essential:SettingsExpander.HeaderIcon>
                <ComboBox
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectionChanged="ImageModeComboBox_SelectionChanged" x:Name="ImageModeComboBox" MinWidth="150"
                    ouxct:ControlAppearance.IsEnabled="True">
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageImageModeNone" Content="None" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageImageModeSingle" Content="Single image" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageImageModeFolder" Content="Local folder" />
                </ComboBox>
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard
                        x:Name="ImageSourceCard"
                        x:Uid="ViewThemesSettingsPageSetImageCard"
                        ActionIcon="&#xE8A7;"
                        Click="SetImageButton_Click"
                        Description="Choose a single image or a folder containing images"
                        Header="Background image source"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <TextBlock
                            x:Name="ImagePathText"
                            MaxWidth="360"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="ClearImageCard"
                        x:Uid="ViewThemesSettingsPageClearImageCard"
                        Click="ClearImageButton_Click"
                        Description="清除已经设置的图片背景"
                        Header="清除背景"
                        IsActionIconVisible="True"
                        IsClickEnabled="True" />
                    <essential:SettingsCard
                        x:Name="ImageStretchCard"
                        x:Uid="ViewThemesSettingsPageImageStretchCard"
                        Description="The way the image is stretched within the background"
                        Header="Image Stretch Mode"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <ComboBox
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="ImageStretchComboBox_SelectionChanged" x:Name="ImageStretchComboBox" Width="Auto" MinWidth="150"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxNone" Content="None" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxFill" Content="Fill" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxUniform" Content="Uniform" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageImageStretchComboBoxUniformToFill" Content="Uniform To Fill" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="ImageOpacityCard"
                        x:Uid="ViewThemesSettingsPageImageOpacityCard"
                        Description="The opacity of the image within the background, which will override the window color"
                        Header="Opacity"
                        IsActionIconVisible="False"
                        IsClickEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <Slider
                                essential:SliderHelper.AcrylicWorkaround="True"
                                Loaded="ImageOpacitySlider_Loaded"
                                Maximum="100"
                                Minimum="0"
                                ValueChanged="ImageOpacitySlider_ValueChanged" x:Name="ImageOpacitySlider" Width="300"
                                ouxct:ControlAppearance.IsEnabled="True"
                                Margin="0,0,10,0" />
                        </StackPanel>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="BackgroundRotationCard"
                        x:Uid="ViewThemesSettingsPageBackgroundRotationCard"
                        Description="How often a new file is selected when a local folder is used"
                        Header="Rotation interval"
                        IsClickEnabled="False">
                        <NumberBox
                            x:Name="BackgroundRotationMinutesBox"
                            x:Uid="ViewThemesSettingsPageBackgroundRotationMinutesBox"
                            Width="140"
                            AutomationProperties.AutomationId="ViewThemesSettingsPageBackgroundRotationMinutesBox"
                            Header="Minutes"
                            Maximum="1440"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline"
                            ValueChanged="BackgroundRotationMinutesBox_ValueChanged" />
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <!--  视频背景  -->
            <essential:SettingsExpander
                x:Name="VideoBackgroundExpander"
                x:Uid="ViewThemesSettingsPageVideoBackgroundExpander"
                Description="Play a local video behind the main content"
                Header="Video background"
                IsExpanded="False">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE714;" />
                </essential:SettingsExpander.HeaderIcon>
                <ComboBox
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectionChanged="VideoModeComboBox_SelectionChanged" x:Name="VideoModeComboBox" MinWidth="150"
                    ouxct:ControlAppearance.IsEnabled="True">
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageVideoModeNone" Content="None" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageVideoModeSingle" Content="Single video" />
                    <ComboBoxItem x:Uid="ViewThemesSettingsPageVideoModeFolder" Content="Local folder" />
                </ComboBox>
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard
                        x:Name="VideoSourceCard"
                        x:Uid="ViewThemesSettingsPageVideoSourceCard"
                        ActionIcon="&#xE8A7;"
                        Click="SetVideoButton_Click"
                        Description="Choose a video or a folder containing videos"
                        Header="Background video source"
                        IsActionIconVisible="True"
                        IsClickEnabled="True">
                        <TextBlock
                            x:Name="VideoPathText"
                            MaxWidth="360"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="ClearVideoCard"
                        x:Uid="ViewThemesSettingsPageClearVideoCard"
                        Click="ClearVideoButton_Click"
                        Description="Stop playback and clear the configured video source"
                        Header="Clear video background"
                        IsActionIconVisible="True"
                        IsClickEnabled="True" />
                    <essential:SettingsCard
                        x:Name="VideoMutedCard"
                        x:Uid="ViewThemesSettingsPageVideoMutedCard"
                        Header="Mute background video"
                        HeaderIcon="{essential:FontIcon Glyph=&#xE8D6;}">
                        <ToggleSwitch
                            Loaded="VideoMutedSwitch_Loaded"
                            Toggled="VideoMutedSwitch_Changed" x:Name="VideoMutedSwitch"
                            ouxct:ControlAppearance.IsEnabled="True" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="VideoLoopingCard"
                        x:Uid="ViewThemesSettingsPageVideoLoopingCard"
                        Header="Loop video"
                        HeaderIcon="{essential:FontIcon Glyph=&#xE8ED;}">
                        <ToggleSwitch
                            Loaded="VideoLoopingSwitch_Loaded"
                            Toggled="VideoLoopingSwitch_Changed" x:Name="VideoLoopingSwitch"
                            ouxct:ControlAppearance.IsEnabled="True" />
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="VideoStretchCard"
                        x:Uid="ViewThemesSettingsPageVideoStretchCard"
                        Description="How the video fills the window"
                        Header="Video stretch mode"
                        IsClickEnabled="False">
                        <ComboBox
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectionChanged="VideoStretchComboBox_SelectionChanged" x:Name="VideoStretchComboBox" MinWidth="150"
                            ouxct:ControlAppearance.IsEnabled="True">
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxNone" Content="None" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxFill" Content="Fill" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxUniform" Content="Uniform" />
                            <ComboBoxItem x:Uid="ViewThemeSettingsPageVideoStretchComboBoxUniformToFill" Content="Uniform To Fill" />
                        </ComboBox>
                    </essential:SettingsCard>
                    <essential:SettingsCard
                        x:Name="VideoOpacityCard"
                        x:Uid="ViewThemesSettingsPageVideoOpacityCard"
                        Description="Video opacity above the image/backdrop layer"
                        Header="Video opacity"
                        IsClickEnabled="False">
                        <Slider
                            essential:SliderHelper.AcrylicWorkaround="True"
                            Loaded="VideoOpacitySlider_Loaded"
                            Maximum="100"
                            Minimum="0"
                            ValueChanged="VideoOpacitySlider_ValueChanged" x:Name="VideoOpacitySlider" Width="300"
                            ouxct:ControlAppearance.IsEnabled="True" />
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <TextBlock
                x:Uid="ThemesFontSectionHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Font" />

            <!--  TODO  -->
            <essential:SettingsCard
                x:Name="FontSetting"
                x:Uid="ViewThemesSettingsPageFontSetting"
                Click="NavigateToThemeSettingFontSettingPageButton_Click"
                Description="Font custom (Not available currently. Please go to Windows Settings to configure)"
                Header="Font Setting"
                HeaderIcon="{essential:FontIcon Glyph=&#xE8D2;,
                                                FontFamily=Segoe Fluent Icons}"
                IsClickEnabled="True"
                IsEnabled="False" />

            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>

    </ScrollView>
</Page>
