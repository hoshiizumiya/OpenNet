<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.ClientFilterSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <TextBlock x:Uid="CF_Title" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Uid="CF_Subtitle"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />

                <TextBlock x:Uid="CF_Section_General" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsCard x:Uid="CF_Enable">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE71C;" />
                    </essential:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="EnableFilterToggle" Toggled="OnEnableToggled" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="CF_RuleCount">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </essential:SettingsCard.HeaderIcon>
                    <TextBlock x:Name="RuleCountText" Text="0" />
                </essential:SettingsCard>

                <essential:SettingsCard x:Uid="CF_RuntimeBlocks">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE72E;" />
                    </essential:SettingsCard.HeaderIcon>
                    <TextBlock x:Name="RuntimeBlocksText" Text="0" />
                </essential:SettingsCard>

                <TextBlock x:Uid="CF_Section_Create" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsExpander x:Uid="CF_AddRule">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE710;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <Button
                        x:Uid="CF_AddBtn"
                        AutomationProperties.AutomationId="CF_AddBtn"
                        Click="OnAddRuleClick" />
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard>
                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox
                                    x:Name="PatternTextBox"
                                    x:Uid="CF_Pattern"
                                    MinWidth="300"
                                    AutomationProperties.AutomationId="CF_Pattern" />
                                <ComboBox
                                    x:Name="MatchTypeComboBox"
                                    x:Uid="CF_MatchType"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="CF_MatchType"
                                    SelectedIndex="0">
                                    <ComboBoxItem x:Uid="CF_MatchContains" />
                                    <ComboBoxItem x:Uid="CF_MatchExact" />
                                    <ComboBoxItem x:Uid="CF_MatchWildcard" />
                                    <ComboBoxItem x:Uid="CF_MatchRegex" />
                                </ComboBox>
                                <TextBox
                                    x:Name="DescriptionTextBox"
                                    x:Uid="CF_Description"
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    AutomationProperties.AutomationId="CF_Description" />
                                <ToggleSwitch
                                    x:Name="CaseSensitiveToggle"
                                    x:Uid="CF_CaseSensitive"
                                    Grid.Row="2"
                                    Grid.ColumnSpan="2"
                                    AutomationProperties.AutomationId="CF_CaseSensitive" />
                            </Grid>
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsCard x:Uid="CF_Test">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE721;" />
                    </essential:SettingsCard.HeaderIcon>
                    <StackPanel MinWidth="440" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="TestClientTextBox"
                                x:Uid="CF_TestInput"
                                MinWidth="320"
                                AutomationProperties.AutomationId="CF_TestInput" />
                            <Button
                                x:Uid="CF_TestBtn"
                                AutomationProperties.AutomationId="CF_TestBtn"
                                Click="OnTestClick" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TestResultText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </essential:SettingsCard>

                <TextBlock x:Uid="CF_Section_Manage" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsExpander x:Uid="CF_RuleManager">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE70F;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <Button
                        x:Uid="CF_RefreshBtn"
                        AutomationProperties.AutomationId="CF_RefreshBtn"
                        Click="OnRefreshClick" />
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard>
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="360" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBox
                                    x:Name="RuleSearchTextBox"
                                    x:Uid="CF_Search"
                                    AutomationProperties.AutomationId="CF_Search"
                                    TextChanged="OnRuleSearchTextChanged" />
                                <TextBlock
                                    x:Name="RulesShownText"
                                    Grid.Row="1"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <ListView
                                    x:Name="RulesList"
                                    Grid.Row="2"
                                    SelectionChanged="OnRuleSelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip essential:ToolTipHelper.AcrylicWorkaround="True" Content="{Binding}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <StackPanel
                                    Grid.Row="3"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <Button
                                        x:Name="ToggleSelectedRuleButton"
                                        x:Uid="CF_ToggleRuleBtn"
                                        AutomationProperties.AutomationId="CF_ToggleRuleBtn"
                                        Click="OnToggleRuleClick"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="EditSelectedRuleButton"
                                        x:Uid="CF_EditRuleBtn"
                                        AutomationProperties.AutomationId="CF_EditRuleBtn"
                                        Click="OnEditRuleClick"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="DeleteSelectedRuleButton"
                                        x:Uid="CF_DeleteRuleBtn"
                                        AutomationProperties.AutomationId="CF_DeleteRuleBtn"
                                        Click="OnDeleteRuleClick"
                                        IsEnabled="False" />
                                </StackPanel>
                            </Grid>
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsCard x:Uid="CF_ImportExport">
                    <essential:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </essential:SettingsCard.HeaderIcon>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button
                            x:Uid="CF_ImportBtn"
                            AutomationProperties.AutomationId="CF_ImportBtn"
                            Click="OnImportClick" />
                        <Button
                            x:Uid="CF_ExportBtn"
                            AutomationProperties.AutomationId="CF_ExportBtn"
                            Click="OnExportClick" />
                        <Button
                            x:Uid="CF_ClearRulesBtn"
                            AutomationProperties.AutomationId="CF_ClearRulesBtn"
                            Click="OnClearRulesClick" />
                    </StackPanel>
                </essential:SettingsCard>

                <TextBlock x:Uid="CF_Section_History" Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" />

                <essential:SettingsExpander x:Uid="CF_History">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE81C;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <Button
                        x:Uid="CF_RefreshHistoryBtn"
                        AutomationProperties.AutomationId="CF_RefreshHistoryBtn"
                        Click="OnRefreshClick" />
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard>
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="300" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ListView
                                    x:Name="HistoryList"
                                    IsItemClickEnabled="False"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                IsTextSelectionEnabled="True"
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis">
                                                <ToolTipService.ToolTip>
                                                    <ToolTip essential:ToolTipHelper.AcrylicWorkaround="True" Content="{Binding}" />
                                                </ToolTipService.ToolTip>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button
                                    x:Uid="CF_ClearHistoryBtn"
                                    Grid.Row="1"
                                    HorizontalAlignment="Right"
                                    AutomationProperties.AutomationId="CF_ClearHistoryBtn"
                                    Click="OnClearHistoryClick" />
                            </Grid>
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <InfoBar
                    x:Name="StatusInfoBar"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Success" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
