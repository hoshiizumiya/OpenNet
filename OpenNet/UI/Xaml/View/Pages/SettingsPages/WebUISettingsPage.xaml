<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.WebUISettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:liquid="using:WinUI.LiquidGlass"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalAlignment="Top">
        <StackPanel Margin="24,20,24,32" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock
                x:Uid="WebUISettingsTitle"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Web UI" />
            <TextBlock
                x:Uid="WebUISettingsDescription"
                Margin="0,0,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Use the bundled qBittorrent WebUI from a browser or any qBittorrent Web API compatible client."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />

            <essential:SettingsCard
                x:Uid="WebUISettingsEnabledCard"
                Description="Allow browser and compatible API clients to connect to OpenNet."
                Header="Enable Web UI">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE774;" />
                </essential:SettingsCard.HeaderIcon>
                <essential:SwitchPresenter Value="{Binding StyleIndex, Source={StaticResource MaterialControlState}, Mode=OneWay}">
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>0</x:Int32>
                        </essential:Case.Value>
                        <ToggleSwitch
                            x:Name="EnableWebUIToggle"
                            IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}"
                            Loaded="OnMaterialToggleLoaded"
                            Toggled="OnMaterialToggleChanged" />
                    </essential:Case>
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>1</x:Int32>
                        </essential:Case.Value>
                        <liquid:LiquidGlassToggleSwitch
                            x:Name="EnableWebUIGlassToggle"
                            Click="OnMaterialToggleChanged"
                            IsOn="{x:Bind ViewModel.Enabled, Mode=TwoWay}"
                            Loaded="OnMaterialToggleLoaded" />
                    </essential:Case>
                </essential:SwitchPresenter>
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsFrontendCard"
                Description="Both frontends use the same OpenNet/qBittorrent-compatible API and settings store."
                Header="Frontend">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </essential:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="FrontendComboBox"
                    MinWidth="220"
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectedIndex="0">
                    <ComboBoxItem Content="qBittorrent WebUI" />
                    <ComboBoxItem Content="VueTorrent" />
                </ComboBox>
            </essential:SettingsCard>

            <TextBlock
                x:Uid="WebUISettingsConnectionHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Connection" />

            <essential:SettingsCard
                x:Uid="WebUISettingsAddressCard"
                Description="The IP address accepted by the embedded HTTP server."
                Header="Listen address">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </essential:SettingsCard.HeaderIcon>
                <TextBox
                    x:Name="AddressTextBox"
                    MinWidth="240"
                    AutomationProperties.AutomationId="WebUISettingsAddress"
                    PlaceholderText="127.0.0.1" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsPortCard"
                Description="Changes are applied automatically to the embedded Web UI."
                Header="Port">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE839;" />
                </essential:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="PortNumberBox"
                    MinWidth="160"
                    AutomationProperties.AutomationId="WebUISettingsPort"
                    Maximum="65535"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsFollowLanguageCard"
                Description="Keep the Web UI locale synchronized with OpenNet's application language."
                Header="Follow application language">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C1;" />
                </essential:SettingsCard.HeaderIcon>
                <essential:SwitchPresenter Value="{Binding StyleIndex, Source={StaticResource MaterialControlState}, Mode=OneWay}">
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>0</x:Int32>
                        </essential:Case.Value>
                        <ToggleSwitch
                            x:Name="FollowApplicationLanguageToggle"
                            AutomationProperties.AutomationId="WebUISettingsFollowLanguage"
                            Loaded="OnMaterialToggleLoaded"
                            Toggled="OnMaterialToggleChanged" />
                    </essential:Case>
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>1</x:Int32>
                        </essential:Case.Value>
                        <liquid:LiquidGlassToggleSwitch
                            x:Name="FollowApplicationLanguageGlassToggle"
                            AutomationProperties.AutomationId="WebUISettingsFollowLanguage"
                            Click="OnMaterialToggleChanged"
                            Loaded="OnMaterialToggleLoaded" />
                    </essential:Case>
                </essential:SwitchPresenter>
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsLocaleCard"
                Description="Used only when following the application language is turned off."
                Header="Locale">
                <TextBox
                    x:Name="LocaleTextBox"
                    x:Uid="WebUISettingsLocale"
                    MinWidth="180"
                    AutomationProperties.AutomationId="WebUISettingsLocale"
                    PlaceholderText="en" />
            </essential:SettingsCard>

            <TextBlock
                x:Uid="WebUISettingsAuthenticationHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Authentication" />

            <essential:SettingsCard
                x:Uid="WebUISettingsUsernameCard"
                Description="At least 3 characters; a colon is not allowed."
                Header="Username">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE77B;" />
                </essential:SettingsCard.HeaderIcon>
                <TextBox
                    x:Name="UsernameTextBox"
                    MinWidth="240"
                    AutomationProperties.AutomationId="WebUISettingsUsername" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsPasswordCard"
                Description="At least 6 characters. Existing browser sessions are cleared when settings are applied."
                Header="Password">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </essential:SettingsCard.HeaderIcon>
                <PasswordBox
                    x:Name="PasswordInput"
                    MinWidth="240"
                    AutomationProperties.AutomationId="WebUISettingsPassword"
                    PasswordRevealMode="Peek" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsApiKeyCard"
                Description="Optional bearer token for API clients. Treat it like a password."
                Header="API key">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D7;" />
                </essential:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PasswordBox
                        x:Name="ApiKeyInput"
                        MinWidth="240"
                        AutomationProperties.AutomationId="WebUISettingsApiKey"
                        Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}"
                        PasswordRevealMode="Peek" />
                    <Button
                        x:Uid="WebUISettingsGenerateApiKey"
                        AutomationProperties.AutomationId="WebUISettingsGenerateApiKey"
                        Click="OnGenerateApiKeyClick"
                        Content="Generate" />
                    <Button
                        x:Name="CopyApiKeyButton"
                        x:Uid="WebUISettingsCopyApiKey"
                        AutomationProperties.AutomationId="WebUISettingsCopyApiKey"
                        Click="OnCopyApiKeyClick"
                        Content="Copy"
                        IsEnabled="{x:Bind ViewModel.HasApiKey, Mode=OneWay}" />
                    <Button
                        x:Name="ClearApiKeyButton"
                        x:Uid="WebUISettingsClearApiKey"
                        AutomationProperties.AutomationId="WebUISettingsClearApiKey"
                        Click="OnClearApiKeyClick"
                        Content="Clear"
                        IsEnabled="{x:Bind ViewModel.HasApiKey, Mode=OneWay}" />
                </StackPanel>
            </essential:SettingsCard>

            <TextBlock
                x:Uid="WebUISettingsSecurityHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Sessions and security" />

            <essential:SettingsExpander
                x:Uid="WebUISettingsSessionExpander"
                Description="Control local authentication, session lifetime and failed-login bans."
                Header="Authentication policy">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </essential:SettingsExpander.HeaderIcon>
                <essential:SwitchPresenter Value="{Binding StyleIndex, Source={StaticResource MaterialControlState}, Mode=OneWay}">
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>0</x:Int32>
                        </essential:Case.Value>
                        <ToggleSwitch
                            x:Name="BypassLocalAuthToggle"
                            x:Uid="WebUISettingsBypassLocalAuth"
                            Header="Bypass authentication on localhost"
                            Loaded="OnMaterialToggleLoaded"
                            Toggled="OnMaterialToggleChanged" />
                    </essential:Case>
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>1</x:Int32>
                        </essential:Case.Value>
                        <liquid:LiquidGlassToggleSwitch
                            x:Name="BypassLocalAuthGlassToggle"
                            x:Uid="WebUISettingsBypassLocalAuth"
                            Click="OnMaterialToggleChanged"
                            Header="Bypass authentication on localhost"
                            Loaded="OnMaterialToggleLoaded" />
                    </essential:Case>
                </essential:SwitchPresenter>
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard x:Uid="WebUISettingsSessionTimeoutCard" Header="Session timeout (seconds)">
                        <NumberBox
                            x:Name="SessionTimeoutNumberBox"
                            Maximum="86400"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline" />
                    </essential:SettingsCard>
                    <essential:SettingsCard x:Uid="WebUISettingsSessionLimitCard" Header="Session count limit">
                        <NumberBox
                            x:Name="SessionCountLimitNumberBox"
                            Maximum="1000"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline" />
                    </essential:SettingsCard>
                    <essential:SettingsCard x:Uid="WebUISettingsMaxFailuresCard" Header="Ban after consecutive failures">
                        <NumberBox
                            x:Name="MaxAuthFailuresNumberBox"
                            Maximum="100"
                            Minimum="0"
                            SpinButtonPlacementMode="Inline" />
                    </essential:SettingsCard>
                    <essential:SettingsCard x:Uid="WebUISettingsBanDurationCard" Header="Ban duration (seconds)">
                        <NumberBox
                            x:Name="BanDurationNumberBox"
                            Maximum="86400"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline" />
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <essential:SettingsExpander
                x:Uid="WebUISettingsRequestSecurityExpander"
                Description="Protect browser sessions against forged requests and DNS rebinding."
                Header="Request protection">
                <essential:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xE83D;" />
                </essential:SettingsExpander.HeaderIcon>
                <essential:SwitchPresenter Value="{Binding StyleIndex, Source={StaticResource MaterialControlState}, Mode=OneWay}">
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>0</x:Int32>
                        </essential:Case.Value>
                        <ToggleSwitch
                            x:Name="CsrfProtectionToggle"
                            x:Uid="WebUISettingsCsrfProtection"
                            Header="CSRF protection"
                            Loaded="OnMaterialToggleLoaded"
                            Toggled="OnMaterialToggleChanged" />
                    </essential:Case>
                    <essential:Case>
                        <essential:Case.Value>
                            <x:Int32>1</x:Int32>
                        </essential:Case.Value>
                        <liquid:LiquidGlassToggleSwitch
                            x:Name="CsrfProtectionGlassToggle"
                            x:Uid="WebUISettingsCsrfProtection"
                            Click="OnMaterialToggleChanged"
                            Header="CSRF protection"
                            Loaded="OnMaterialToggleLoaded" />
                    </essential:Case>
                </essential:SwitchPresenter>
                <essential:SettingsExpander.Items>
                    <essential:SettingsCard x:Uid="WebUISettingsHostValidationCard" Header="Host header validation">
                        <essential:SwitchPresenter Value="{Binding StyleIndex, Source={StaticResource MaterialControlState}, Mode=OneWay}">
                            <essential:Case>
                                <essential:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </essential:Case.Value>
                                <ToggleSwitch
                                    x:Name="HostValidationToggle"
                                    Loaded="OnMaterialToggleLoaded"
                                    Toggled="OnMaterialToggleChanged" />
                            </essential:Case>
                            <essential:Case>
                                <essential:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </essential:Case.Value>
                                <liquid:LiquidGlassToggleSwitch
                                    x:Name="HostValidationGlassToggle"
                                    Click="OnMaterialToggleChanged"
                                    Loaded="OnMaterialToggleLoaded" />
                            </essential:Case>
                        </essential:SwitchPresenter>
                    </essential:SettingsCard>
                    <essential:SettingsCard x:Uid="WebUISettingsSecureCookieCard" Header="Secure cookie flag">
                        <essential:SwitchPresenter Value="{Binding StyleIndex, Source={StaticResource MaterialControlState}, Mode=OneWay}">
                            <essential:Case>
                                <essential:Case.Value>
                                    <x:Int32>0</x:Int32>
                                </essential:Case.Value>
                                <ToggleSwitch
                                    x:Name="SecureCookieToggle"
                                    Loaded="OnMaterialToggleLoaded"
                                    Toggled="OnMaterialToggleChanged" />
                            </essential:Case>
                            <essential:Case>
                                <essential:Case.Value>
                                    <x:Int32>1</x:Int32>
                                </essential:Case.Value>
                                <liquid:LiquidGlassToggleSwitch
                                    x:Name="SecureCookieGlassToggle"
                                    Click="OnMaterialToggleChanged"
                                    Loaded="OnMaterialToggleLoaded" />
                            </essential:Case>
                        </essential:SwitchPresenter>
                    </essential:SettingsCard>
                    <essential:SettingsCard x:Uid="WebUISettingsDomainsCard" Header="Allowed server domains">
                        <TextBox
                            x:Name="DomainListTextBox"
                            MinWidth="280"
                            PlaceholderText="* or domain1;domain2" />
                    </essential:SettingsCard>
                </essential:SettingsExpander.Items>
            </essential:SettingsExpander>

            <StackPanel
                Margin="0,24,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="OpenWebUIButton"
                    x:Uid="WebUISettingsOpen"
                    AutomationProperties.AutomationId="WebUISettingsOpen"
                    Click="OnOpenWebUIClick"
                    Content="Open Web UI"
                    IsEnabled="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                    Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
