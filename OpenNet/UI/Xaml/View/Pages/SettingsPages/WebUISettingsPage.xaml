<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.WebUISettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="1,30,0,6" />
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalAlignment="Top">
        <StackPanel Margin="24,20,24,32" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock
                x:Uid="WebUISettingsTitle"
                Style="{StaticResource TitleTextBlockStyle}"
                Text="Web UI" />
            <TextBlock
                x:Uid="WebUISettingsDescription"
                Margin="0,0,0,8"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Use the bundled qBittorrent WebUI from a browser or any qBittorrent Web API compatible client."
                TextWrapping="Wrap" />

            <InfoBar
                x:Name="StatusInfoBar"
                IsClosable="False"
                IsOpen="True"
                Severity="Informational" />

            <essential:SettingsCard
                x:Uid="WebUISettingsFrontendCard"
                Description="Both frontends use the same OpenNet/qBittorrent-compatible API and settings store."
                Header="Frontend">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8A5;" />
                </essential:SettingsCard.HeaderIcon>
                <ComboBox
                    x:Name="FrontendComboBox"
                    MinWidth="220"
                    essential:ComboBoxHelper.AcrylicWorkaround="True"
                    SelectedIndex="0">
                    <ComboBoxItem Content="qBittorrent WebUI" />
                    <ComboBoxItem Content="VueTorrent (WinUI theme)" />
                </ComboBox>
            </essential:SettingsCard>

            <TextBlock
                x:Uid="WebUISettingsConnectionHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Connection" />

            <essential:SettingsCard
                x:Uid="WebUISettingsAddressCard"
                Description="The IP address accepted by the embedded HTTP server."
                Header="Listen address">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE968;" />
                </essential:SettingsCard.HeaderIcon>
                <TextBox
                    x:Name="AddressTextBox"
                    MinWidth="240"
                    AutomationProperties.AutomationId="WebUISettingsAddress"
                    PlaceholderText="127.0.0.1" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsPortCard"
                Description="Restarting the Web UI applies a new port immediately."
                Header="Port">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE839;" />
                </essential:SettingsCard.HeaderIcon>
                <NumberBox
                    x:Name="PortNumberBox"
                    MinWidth="160"
                    AutomationProperties.AutomationId="WebUISettingsPort"
                    Maximum="65535"
                    Minimum="1"
                    SpinButtonPlacementMode="Inline" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsFollowLanguageCard"
                Description="Keep the Web UI locale synchronized with OpenNet's application language."
                Header="Follow application language">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8C1;" />
                </essential:SettingsCard.HeaderIcon>
                <ToggleSwitch
                    x:Name="FollowApplicationLanguageToggle"
                    AutomationProperties.AutomationId="WebUISettingsFollowLanguage"
                    Toggled="OnFollowApplicationLanguageToggled" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsLocaleCard"
                Description="Used only when following the application language is turned off."
                Header="Locale">
                <TextBox
                    x:Name="LocaleTextBox"
                    x:Uid="WebUISettingsLocale"
                    MinWidth="180"
                    AutomationProperties.AutomationId="WebUISettingsLocale"
                    PlaceholderText="en" />
            </essential:SettingsCard>

            <TextBlock
                x:Uid="WebUISettingsAuthenticationHeader"
                Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                Text="Authentication" />

            <essential:SettingsCard
                x:Uid="WebUISettingsUsernameCard"
                Description="At least 3 characters; a colon is not allowed."
                Header="Username">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE77B;" />
                </essential:SettingsCard.HeaderIcon>
                <TextBox
                    x:Name="UsernameTextBox"
                    MinWidth="240"
                    AutomationProperties.AutomationId="WebUISettingsUsername" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsPasswordCard"
                Description="At least 6 characters. Existing browser sessions are cleared when settings are applied."
                Header="Password">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE72E;" />
                </essential:SettingsCard.HeaderIcon>
                <PasswordBox
                    x:Name="PasswordInput"
                    MinWidth="240"
                    AutomationProperties.AutomationId="WebUISettingsPassword"
                    PasswordRevealMode="Peek" />
            </essential:SettingsCard>

            <essential:SettingsCard
                x:Uid="WebUISettingsApiKeyCard"
                Description="Optional bearer token for API clients. Treat it like a password."
                Header="API key">
                <essential:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8D7;" />
                </essential:SettingsCard.HeaderIcon>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <PasswordBox
                        x:Name="ApiKeyInput"
                        MinWidth="240"
                        AutomationProperties.AutomationId="WebUISettingsApiKey"
                        PasswordRevealMode="Peek" />
                    <Button
                        x:Uid="WebUISettingsGenerateApiKey"
                        AutomationProperties.AutomationId="WebUISettingsGenerateApiKey"
                        Click="OnGenerateApiKeyClick"
                        Content="Generate" />
                    <Button
                        x:Uid="WebUISettingsCopyApiKey"
                        AutomationProperties.AutomationId="WebUISettingsCopyApiKey"
                        Click="OnCopyApiKeyClick"
                        Content="Copy" />
                    <Button
                        x:Uid="WebUISettingsClearApiKey"
                        AutomationProperties.AutomationId="WebUISettingsClearApiKey"
                        Click="OnClearApiKeyClick"
                        Content="Clear" />
                </StackPanel>
            </essential:SettingsCard>

            <StackPanel
                Margin="0,24,0,0"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="SaveButton"
                    x:Uid="WebUISettingsSave"
                    AutomationProperties.AutomationId="WebUISettingsSave"
                    Click="OnSaveClick"
                    Content="Save and restart Web UI"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Uid="WebUISettingsOpen"
                    AutomationProperties.AutomationId="WebUISettingsOpen"
                    Click="OnOpenWebUIClick"
                    Content="Open Web UI" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
