<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.SettingsPages.ThemeSettingBackdropCustomizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:OpenNet.UI.Xaml.Control.Card"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass"
    xmlns:xwc="using:XamlToolkit.WinUI.Controls"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <ScrollView>
        <StackPanel
            Margin="24"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Spacing="16">
            <StackPanel.Resources>
                <Style BasedOn="{StaticResource DefaultSliderStyle}" TargetType="Slider">
                    <Setter Property="Maximum" Value="1" />
                    <Setter Property="Minimum" Value="0" />
                    <Setter Property="StepFrequency" Value="0.01" />
                </Style>
            </StackPanel.Resources>
            <xwc:WrapPanel
                HorizontalSpacing="16"
                Orientation="Horizontal"
                VerticalSpacing="16">
                <controls:TitleCard x:Uid="ViewThemeSettingFallbackColorCard" Title="Window lost focus fallback color">
                    <controls:TitleCard.Content>
                        <xwc:ColorPicker x:Name="FallbackColorPicker" ColorChanged="BackdropValueChanged" />
                    </controls:TitleCard.Content>
                </controls:TitleCard>
                <controls:TitleCard x:Uid="ViewThemeSettingTintColorCard" Title="Tint color:">
                    <controls:TitleCard.Content>
                        <xwc:ColorPicker x:Name="TintColorPicker" ColorChanged="BackdropValueChanged" />
                    </controls:TitleCard.Content>
                </controls:TitleCard>

            </xwc:WrapPanel>

            <ouxct:MaterialSwap>
                <ouxct:MaterialSwap.Native>
                    <Slider
                        x:Name="LuminosityOpacitySlider"
                        x:Uid="ViewThemeSettingLuminosityOpacitySlider"
                        essential:SliderHelper.AcrylicWorkaround="True"
                        AutomationProperties.AutomationId="ViewThemeSettingLuminosityOpacitySlider"
                        Header="LuminosityOpacity"
                        Loaded="MaterialControl_Loaded"
                        ValueChanged="BackdropValueChanged" />
                </ouxct:MaterialSwap.Native>
                <ouxct:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider ouxct:MaterialControlState.IsManaged="True" Loaded="LuminosityOpacitySliderMaterialLoaded" />
                </ouxct:MaterialSwap.Glass>
            </ouxct:MaterialSwap>

            <ouxct:MaterialSwap>
                <ouxct:MaterialSwap.Native>
                    <Slider
                        x:Name="TintOpacitySlider"
                        x:Uid="ViewThemeSettingTintOpacitySlider"
                        essential:SliderHelper.AcrylicWorkaround="True"
                        AutomationProperties.AutomationId="ViewThemeSettingTintOpacitySlider"
                        Header="TintOpacity"
                        Loaded="MaterialControl_Loaded"
                        ValueChanged="BackdropValueChanged" />
                </ouxct:MaterialSwap.Native>
                <ouxct:MaterialSwap.Glass>
                    <wl:LiquidGlassSlider ouxct:MaterialControlState.IsManaged="True" Loaded="TintOpacitySliderMaterialLoaded" />
                </ouxct:MaterialSwap.Glass>
            </ouxct:MaterialSwap>

            <wl:LiquidGlassToggleSwitch
                x:Name="EnableSwitch"
                x:Uid="ViewThemeSettingEnableAcrylicSwitch"
                ouxct:ControlAppearance.IsEnabled="True"
                ouxct:MaterialControlState.IsManaged="True"
                AutomationProperties.AutomationId="ViewThemeSettingEnableAcrylicSwitch"
                Checked="BackdropValueChanged"
                Header="Enable acrylic when window is inactive"
                Loaded="MaterialControl_Loaded"
                Unchecked="BackdropValueChanged" />
        </StackPanel>
    </ScrollView>
</Page>
