<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskPeersListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:controls="using:XamlToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:segment="using:OpenNet.UI.Xaml.Control.Progress.HttpSegment"
    xmlns:svg="using:WinUI3Package.Svg"
    xmlns:vm="using:OpenNet.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/AcrylicBrush_ResourceDictionary.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Progress/HttpSegment/HttpSegmentProgressBar_ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Peer list  -->
        <controls:HeaderedTreeView
            x:Name="PeersTreeView"
            Grid.Row="1"
            SelectionMode="Single">
            <controls:HeaderedTreeView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        x:Name="BanPeer1hItem"
                        x:Uid="BanPeer1hItem"
                        AutomationProperties.AutomationId="BanPeer1hItem"
                        Click="BanPeer1h_Click"
                        Text="Ban IP for 1 hour" />
                    <MenuFlyoutItem
                        x:Name="BanPeer24hItem"
                        x:Uid="BanPeer24hItem"
                        AutomationProperties.AutomationId="BanPeer24hItem"
                        Click="BanPeer24h_Click"
                        Text="Ban IP for 24 hours" />
                    <MenuFlyoutItem
                        x:Name="BanPeerPermanentItem"
                        x:Uid="BanPeerPermanentItem"
                        AutomationProperties.AutomationId="BanPeerPermanentItem"
                        Click="BanPeerPermanent_Click"
                        Text="Ban IP permanently" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="UnbanPeerItem"
                        x:Uid="UnbanPeerItem"
                        AutomationProperties.AutomationId="UnbanPeerItem"
                        Click="UnbanPeer_Click"
                        Text="Unban IP" />
                </MenuFlyout>
            </controls:HeaderedTreeView.ContextFlyout>
            <!--  Column Headers  -->
            <controls:HeaderedTreeView.Header>
                <Border
                    Padding="8,4,0,4"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    CornerRadius="4"
                    RightTapped="ColumnHeader_RightTapped">
                    <Border.ContextFlyout>
                        <MenuFlyout Opening="ColumnMenu_Opening">
                            <MenuFlyoutItem
                                x:Name="AutoSizeSelectedColumnItem"
                                x:Uid="ViewPageTasksColumnAutoSizeSelectedWidth"
                                Click="AutoSizeSelectedColumn_Click"
                                Text="Auto Size Selected Column's Width to Fit" />
                            <MenuFlyoutItem
                                x:Uid="ViewPageTasksColumnAutoSizeAllWidth"
                                Click="AutoSizeAllColumns_Click"
                                Text="Auto Size All Columns' Width to Fit" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_IP"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="IP"
                                Text="IP" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Location"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Location"
                                Text="Location" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Progress"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Progress"
                                Text="Progress" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_DLSpeed"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="DLSpeed"
                                Text="DL Speed" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_ULSpeed"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="ULSpeed"
                                Text="UL Speed" />
                            <ToggleMenuFlyoutItem
                                x:Uid="CommonTextDownloaded"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Downloaded"
                                Text="Downloaded" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Uploaded"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Uploaded"
                                Text="Uploaded" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Client"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Client"
                                Text="Client" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Status"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Status"
                                Text="Status" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Reason"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Reason"
                                Text="Reason" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Protocol"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Protocol"
                                Text="Protocol" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Initiator"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Initiator"
                                Text="Initiator" />
                            <ToggleMenuFlyoutItem
                                x:Uid="PeerMenu_Source"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Source"
                                Text="Source" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Uid="CommonTextResetColumns"
                                Click="ResetColumns_Click"
                                Text="Reset Columns and Sorting" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StickyHeaderBehavior />
                    </interactivity:Interaction.Behaviors>
                    <labs:DataTable ColumnSpacing="16" PointerPressed="ColumnHeader_PointerPressed">
                        <labs:DataColumn x:Name="ColPeerIP" CanResize="True">
                            <Button
                                x:Name="SortPeerIpButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="IP">
                                <TextBlock
                                    x:Uid="PeerHeader_IP"
                                    Text="IP"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerLocation" CanResize="True">
                            <Button
                                x:Name="SortPeerLocationButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Location">
                                <TextBlock
                                    x:Uid="PeerHeader_Location"
                                    Text="Location"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerProgress" CanResize="True">
                            <Button
                                x:Name="SortPeerProgressButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Progress">
                                <TextBlock
                                    x:Uid="PeerHeader_Progress"
                                    Text="Progress"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerDLSpeed" CanResize="True">
                            <Button
                                x:Name="SortPeerDlSpeedButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="DLSpeed">
                                <TextBlock
                                    x:Uid="PeerHeader_DLSpeed"
                                    Text="DL Speed"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerULSpeed" CanResize="True">
                            <Button
                                x:Name="SortPeerUlSpeedButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="ULSpeed">
                                <TextBlock
                                    x:Uid="PeerHeader_ULSpeed"
                                    Text="UL Speed"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerDownloaded" CanResize="True">
                            <Button
                                x:Name="SortPeerDownloadedButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Downloaded">
                                <TextBlock
                                    x:Uid="CommonTextDownloaded"
                                    Text="Downloaded"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerUploaded" CanResize="True">
                            <Button
                                x:Name="SortPeerUploadedButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Uploaded">
                                <TextBlock
                                    x:Uid="PeerHeader_Uploaded"
                                    Text="Uploaded"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerClient" CanResize="True">
                            <Button
                                x:Name="SortPeerClientButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Client">
                                <TextBlock
                                    x:Uid="PeerHeader_Client"
                                    Text="Client"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerStatus" CanResize="True">
                            <Button
                                x:Name="SortPeerStatusButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Status">
                                <TextBlock
                                    x:Uid="PeerHeader_PeerStatus"
                                    Text="Status"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerReason" CanResize="True">
                            <Button
                                x:Name="SortPeerReasonButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Reason">
                                <TextBlock
                                    x:Uid="PeerHeader_Reason"
                                    Text="Reason"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerProtocol" CanResize="True">
                            <Button
                                x:Name="SortPeerProtocolButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Protocol">
                                <TextBlock
                                    x:Uid="PeerHeader_Protocol"
                                    Text="Protocol"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerInitiator" CanResize="True">
                            <Button
                                x:Name="SortPeerInitiatorButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Initiator">
                                <TextBlock
                                    x:Uid="PeerHeader_Initiator"
                                    Text="Initiator"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColPeerSource" CanResize="True">
                            <Button
                                x:Name="SortPeerSourceButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Source">
                                <TextBlock
                                    x:Uid="PeerHeader_Source"
                                    Text="Source"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                    </labs:DataTable>

                </Border>
            </controls:HeaderedTreeView.Header>
            <controls:HeaderedTreeView.ItemTemplate>
                <DataTemplate x:DataType="vm:PeerDisplayItem">
                    <muxc:TreeViewItem
                        HorizontalContentAlignment="Stretch"
                        IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                        ItemsSource="{x:Bind Children}">
                        <muxc:TreeViewItem.Transitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </muxc:TreeViewItem.Transitions>
                        <labs:DataRow HorizontalAlignment="Left" Loaded="PeerDataRow_Loaded">
                            <labs:DataRow.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </labs:DataRow.Resources>
                            <TextBlock Text="{x:Bind IP, Mode=OneWay}" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    x:Name="PeerFlagImage"
                                    Width="18"
                                    Height="14"
                                    VerticalAlignment="Center">
                                    <Image.Source>
                                        <svg:SvgImageSource BindSizeTo="{x:Bind PeerFlagImage}" StringSource="{x:Bind FlagSvg, Mode=OneWay}" />
                                    </Image.Source>
                                </Image>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Location, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid MinWidth="120">
                                <Grid Visibility="{x:Bind RangeProgressVisibility, Mode=OneWay}">
                                    <segment:RangePieceBar
                                        Height="12"
                                        IsRangeMode="True"
                                        RangeEnd="{x:Bind SegmentEnd, Mode=OneWay}"
                                        RangeStart="{x:Bind SegmentStart, Mode=OneWay}"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="{x:Bind Progress, Mode=OneWay}" />
                                </Grid>
                                <Grid Visibility="{x:Bind LinearProgressVisibility, Mode=OneWay}">
                                    <ProgressBar
                                        Height="4"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Value="{x:Bind ProgressValue, Mode=OneWay}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="10"
                                        Text="{x:Bind Progress, Mode=OneWay}" />
                                </Grid>
                            </Grid>
                            <TextBlock Text="{x:Bind DLSpeed, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind ULSpeed, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Downloaded, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Uploaded, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Client, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind PeerStatus, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Reason, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Protocol, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Initiator, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Source, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </labs:DataRow>
                    </muxc:TreeViewItem>
                </DataTemplate>
            </controls:HeaderedTreeView.ItemTemplate>
        </controls:HeaderedTreeView>

        <!--  Empty state when no task selected or no peers  -->
        <TextBlock
            x:Name="EmptyStateText"
            x:Uid="PeersList_EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No peers connected"
            Visibility="Collapsed" />
    </Grid>
</Page>
