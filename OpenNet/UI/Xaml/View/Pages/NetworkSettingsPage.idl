import "ViewModels/NetworkSettingsViewModel.idl";

namespace OpenNet.UI.Xaml.View.Pages
{
    [default_interface]
    runtimeclass NetworkSettingsPage : Microsoft.UI.Xaml.Controls.Page
    {
        NetworkSettingsPage();
        OpenNet.ViewModels.NetworkSettingsViewModel ViewModel { get; };

        Microsoft.UI.Xaml.Controls.ToggleSwitch EnableLSDToggle;
        Microsoft.UI.Xaml.Controls.ToggleSwitch EnablePEXToggle;
        Microsoft.UI.Xaml.Controls.ToggleSwitch EnableDHTToggle;
        Microsoft.UI.Xaml.Controls.ComboBox PresetTrackerListComboBox;
        Microsoft.UI.Xaml.Controls.TextBox SubscriptionUrlTextBox;
        Microsoft.UI.Xaml.Controls.TextBox SubscriptionNameTextBox;
        Microsoft.UI.Xaml.Controls.TextBox NewTrackerTextBox;
        Microsoft.UI.Xaml.Controls.ToggleSwitch AutoAddTrackersToggle;

        // Tracker properties
        Windows.Foundation.Collections.IObservableVector<String> TrackerList{ get; };
        Windows.Foundation.Collections.IObservableVector<String> SubscriptionList{ get; };
    }
}