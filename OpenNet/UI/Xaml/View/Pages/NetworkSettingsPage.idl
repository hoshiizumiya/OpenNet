import "ViewModels/NetworkSettingsViewModel.idl";

namespace OpenNet.UI.Xaml.View.Pages
{
    [default_interface]
    runtimeclass NetworkSettingsPage : Microsoft.UI.Xaml.Controls.Page
    {
        NetworkSettingsPage();
        OpenNet.ViewModels.NetworkSettingsViewModel ViewModel { get; };

        WinUI.LiquidGlass.LiquidGlassToggleSwitch EnableLSDToggle;
        WinUI.LiquidGlass.LiquidGlassToggleSwitch EnablePEXToggle;
        WinUI.LiquidGlass.LiquidGlassToggleSwitch EnableDHTToggle;
        WinUI.LiquidGlass.LiquidGlassComboBox PresetTrackerListComboBox;
        WinUI.LiquidGlass.LiquidGlassTextBox SubscriptionUrlTextBox;
        WinUI.LiquidGlass.LiquidGlassTextBox SubscriptionNameTextBox;
        WinUI.LiquidGlass.LiquidGlassTextBox NewTrackerTextBox;
        WinUI.LiquidGlass.LiquidGlassToggleSwitch AutoAddTrackersToggle;

        // Tracker properties
        Windows.Foundation.Collections.IObservableVector<String> TrackerList{ get; };
        Windows.Foundation.Collections.IObservableVector<String> SubscriptionList{ get; };
    }
}
