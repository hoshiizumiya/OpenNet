<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OpenNet.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  File list  -->
        <ListView
            x:Name="FilesListView"
            Grid.Row="1"
            SelectionMode="None">
            <ListView.Header>
                <Border
                    Padding="8,4,0,4"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    CornerRadius="4"
                    RightTapped="ColumnHeader_RightTapped">
                    <Border.ContextFlyout>
                        <MenuFlyout Opening="ColumnMenu_Opening">
                            <MenuFlyoutItem
                                x:Name="AutoSizeSelectedColumnItem"
                                Click="AutoSizeSelectedColumn_Click"
                                Text="Auto Size Selected Column's Width to Fit" />
                            <MenuFlyoutItem Click="AutoSizeAllColumns_Click" Text="Auto Size All Columns' Width to Fit" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Path"
                                Text="File" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Size"
                                Text="Size" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Progress"
                                Text="Progress" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Done"
                                Text="Done" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Priority"
                                Text="Priority" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="ResetColumns_Click" Text="Reset Columns and Sorting" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StickyHeaderBehavior />
                    </interactivity:Interaction.Behaviors>
                    <labs:DataTable ColumnSpacing="16">
                        <labs:DataColumn x:Name="ColFileName" CanResize="True">
                            <Button
                                x:Name="SortFileNameButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="Path">
                                <TextBlock
                                    x:Uid="FileHeader_Path"
                                    Text="File"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFileSize" CanResize="True">
                            <Button
                                x:Name="SortFileSizeButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="Size">
                                <TextBlock
                                    x:Uid="FileHeader_Size"
                                    Text="Size"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFileProgress" CanResize="True">
                            <Button
                                x:Name="SortFileProgressButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="Progress">
                                <TextBlock
                                    x:Uid="FileHeader_Progress"
                                    Text="Progress"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFileDone" CanResize="True">
                            <Button
                                x:Name="SortFileDoneButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="Done">
                                <TextBlock
                                    x:Uid="FileHeader_Done"
                                    Text="Done"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFilePriority" CanResize="True">
                            <Button
                                x:Name="SortFilePriorityButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource SubtleButtonStyle}"
                                Tag="Priority">
                                <TextBlock
                                    x:Uid="FileHeader_Priority"
                                    Text="Priority"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                    </labs:DataTable>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileDisplayItem">
                    <labs:DataRow HorizontalAlignment="Left">
                        <TextBlock
                            Text="{x:Bind Path}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path}" />
                        <TextBlock Text="{x:Bind Size}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Value="{x:Bind ProgressValue}" />
                        <TextBlock Text="{x:Bind Done}" TextTrimming="CharacterEllipsis" />
                        <ComboBox
                            MinWidth="80"
                            HorizontalAlignment="Stretch"
                            SelectedIndex="{x:Bind PriorityIndex, Mode=OneWay}"
                            SelectionChanged="FilePriority_SelectionChanged"
                            Tag="{x:Bind FileIndex}">
                            <ComboBoxItem x:Uid="FilePriority_Skip" Content="Skip" />
                            <ComboBoxItem x:Uid="FilePriority_Low" Content="Low" />
                            <ComboBoxItem x:Uid="FilePriority_Normal" Content="Normal" />
                            <ComboBoxItem x:Uid="FilePriority_High" Content="High" />
                        </ComboBox>
                    </labs:DataRow>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <TextBlock
            x:Name="EmptyStateText"
            x:Uid="FilesList_EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No file information available"
            Visibility="Collapsed" />
    </Grid>
</Page>
