<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OpenNet.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/AcrylicBrush_ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ContentDialog x:Name="RenameFileDialog" DefaultButton="Primary">
                <TextBox x:Name="RenameFileTextBox" />
            </ContentDialog>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  File list  -->
        <ListView
            x:Name="FilesListView"
            Grid.Row="1"
            DoubleTapped="FilesListView_DoubleTapped"
            RightTapped="FilesListView_RightTapped"
            SelectionMode="Single">
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ContextFlyout>
                <MenuFlyout Opening="FileContextMenu_Opening">
                    <MenuFlyoutItem
                        x:Name="OpenFileMenuItem"
                        x:Uid="TasksContextOpenFile"
                        Click="OpenFile_Click"
                        Text="Open File" />
                    <MenuFlyoutItem
                        x:Name="PlayFileMenuItem"
                        x:Uid="ViewTaskFilesPageMenuItemPlayFile"
                        Click="PlayFile_Click"
                        Text="Play File" />
                    <MenuFlyoutItem
                        x:Name="OpenFileLocationMenuItem"
                        x:Uid="OpenFileLocationMenuItem"
                        Click="OpenFileLocation_Click"
                        Text="Open File Location" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="RenameFileMenuItem"
                        x:Uid="RenameTaskMenuItem"
                        Click="RenameFile_ClickAsync"
                        Text="Rename..." />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.Header>
                <Border
                    Padding="8,4,0,4"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    CornerRadius="4"
                    RightTapped="ColumnHeader_RightTapped">
                    <Border.ContextFlyout>
                        <MenuFlyout Opening="ColumnMenu_Opening">
                            <MenuFlyoutItem
                                x:Name="AutoSizeSelectedColumnItem"
                                x:Uid="ViewPageTasksColumnAutoSizeSelectedWidth"
                                Click="AutoSizeSelectedColumn_Click"
                                Text="Auto Size Selected Column's Width to Fit" />
                            <MenuFlyoutItem
                                x:Uid="ViewPageTasksColumnAutoSizeAllWidth"
                                Click="AutoSizeAllColumns_Click"
                                Text="Auto Size All Columns' Width to Fit" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem
                                x:Uid="FileHeader_Path"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Path"
                                Text="File" />
                            <ToggleMenuFlyoutItem
                                x:Uid="FileHeader_Size"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Size"
                                Text="Size" />
                            <ToggleMenuFlyoutItem
                                x:Uid="FileHeader_Progress"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Progress"
                                Text="Progress" />
                            <ToggleMenuFlyoutItem
                                x:Uid="FileHeader_Done"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Done"
                                Text="Done" />
                            <ToggleMenuFlyoutItem
                                x:Uid="FileHeader_Priority"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Priority"
                                Text="Priority" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Uid="CommonTextResetColumns"
                                Click="ResetColumns_Click"
                                Text="Reset Columns and Sorting" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StickyHeaderBehavior />
                    </interactivity:Interaction.Behaviors>
                    <labs:DataTable ColumnSpacing="16" Loaded="DataTable_Loaded">
                        <labs:DataColumn x:Name="ColFileName" CanResize="True">
                            <Button
                                x:Name="SortFileNameButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Path">
                                <TextBlock
                                    x:Uid="FileHeader_Path"
                                    Text="File"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFileSize" CanResize="True">
                            <Button
                                x:Name="SortFileSizeButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Size">
                                <TextBlock
                                    x:Uid="FileHeader_Size"
                                    Text="Size"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFileProgress" CanResize="True">
                            <Button
                                x:Name="SortFileProgressButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Progress">
                                <TextBlock
                                    x:Uid="FileHeader_Progress"
                                    Text="Progress"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFileDone" CanResize="True">
                            <Button
                                x:Name="SortFileDoneButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Done">
                                <TextBlock
                                    x:Uid="FileHeader_Done"
                                    Text="Done"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColFilePriority" CanResize="True">
                            <Button
                                x:Name="SortFilePriorityButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Priority">
                                <TextBlock
                                    x:Uid="FileHeader_Priority"
                                    Text="Priority"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                    </labs:DataTable>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FileDisplayItem">
                    <labs:DataRow HorizontalAlignment="Left" Loaded="FileDataRow_Loaded">
                        <labs:DataRow.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </labs:DataRow.Resources>
                        <TextBlock Text="{x:Bind Path, Mode=OneWay}" TextTrimming="CharacterEllipsis">
                            <ToolTipService.ToolTip>
                                <ToolTip essential:ToolTipHelper.AcrylicWorkaround="True" Content="{x:Bind Path, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <TextBlock Text="{x:Bind Size, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                            Margin="4,0"
                            VerticalAlignment="Center"
                            Maximum="100"
                            Value="{x:Bind ProgressValue, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind Done, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <ComboBox
                            MinWidth="80"
                            HorizontalAlignment="Stretch"
                            essential:ComboBoxHelper.AcrylicWorkaround="True"
                            SelectedIndex="{x:Bind PriorityIndex, Mode=OneWay}"
                            SelectionChanged="FilePriority_SelectionChanged"
                            Tag="{x:Bind FileIndex}">
                            <ComboBoxItem x:Uid="FilePriority_Skip" Content="Skip" />
                            <ComboBoxItem x:Uid="FilePriority_Low" Content="Low" />
                            <ComboBoxItem x:Uid="FilePriority_Normal" Content="Normal" />
                            <ComboBoxItem x:Uid="FilePriority_High" Content="High" />
                        </ComboBox>
                    </labs:DataRow>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <TextBlock
            x:Name="EmptyStateText"
            x:Uid="FilesList_EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No file information available"
            Visibility="Collapsed" />
    </Grid>
</Page>
