<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.NetworkSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:control="using:OpenNet.UI.Xaml.Control"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="NetworkSettingsPageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!--  I think we don't need a Page Header, BreadcrumbBar is OK and enough  -->
                <!--<TextBlock
                    Margin="0,0,0,16"
                    Style="{StaticResource TitleTextBlockStyle}"
                    Text="Network Settings" />-->

                <!--  Custom Tracker Section  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Custom Trackers" />

                <essential:SettingsExpander Description="Manage your custom tracker list" Header="Custom Trackers">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE774;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <Button
                        Click="RefreshTrackersButton_Click"
                        Content="Refresh"
                        ToolTipService.ToolTip="Refresh all trackers" />
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard
                            x:Uid="ViewSettingsPageAutoAddTrackers"
                            Description="Append every enabled custom and subscribed tracker when a new BitTorrent task is first added"
                            Header="Automatically add custom trackers">
                            <ToggleSwitch x:Name="AutoAddTrackersToggle" Toggled="AutoAddTrackersToggle_Toggled" />
                        </essential:SettingsCard>
                        <essential:SettingsCard ContentAlignment="Left" Header="Add tracker">
                            <Grid MinWidth="400">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="NewTrackerTextBox"
                                    x:Uid="ViewNetworkSettingsPageNewTrackerTextBox"
                                    PlaceholderText="Enter tracker URL (e.g., tracker.example.com:6969)" />
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="AddTrackerButton_Click"
                                    Content="Add"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </essential:SettingsCard>
                        <essential:SettingsCard ContentAlignment="Left" Header="Tracker list">
                            <ListView
                                x:Name="TrackerListView"
                                MaxHeight="300"
                                ItemsSource="{x:Bind TrackerList}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="1"
                                                Background="Transparent"
                                                Click="RemoveTrackerButton_Click"
                                                Tag="{x:Bind}">
                                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </essential:SettingsCard>
                        <essential:SettingsCard ContentAlignment="Left">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="These trackers will be automatically added to new torrents to help find peers."
                                TextWrapping="Wrap" />
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <!--  Tracker Subscription Section  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Tracker Subscriptions" />

                <essential:SettingsExpander Description="Subscribe to tracker lists from URLs (.txt format)" Header="Tracker Subscriptions">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard ContentAlignment="Left" Header="Add subscription">
                            <StackPanel MinWidth="400" Spacing="8">
                                <TextBox x:Name="SubscriptionNameTextBox" PlaceholderText="Subscription name (e.g., Public Trackers)" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SubscriptionUrlTextBox" PlaceholderText="Subscription URL (e.g., https://example.com/trackers.txt)" />
                                    <Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Click="AddSubscriptionButton_Click"
                                        Content="Subscribe"
                                        Style="{StaticResource AccentButtonStyle}" />
                                </Grid>
                            </StackPanel>
                        </essential:SettingsCard>
                        <essential:SettingsCard ContentAlignment="Left" Header="Active subscriptions">
                            <ListView
                                x:Name="SubscriptionListView"
                                MaxHeight="200"
                                ItemsSource="{x:Bind SubscriptionList}"
                                SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Grid Padding="8,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{x:Bind}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Button
                                                Grid.Column="1"
                                                Background="Transparent"
                                                Click="RemoveSubscriptionButton_Click"
                                                Tag="{x:Bind}">
                                                <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </essential:SettingsCard>
                        <essential:SettingsCard
                            ContentAlignment="Left"
                            Description="Choose a maintained XIU2 list and add it as a subscription"
                            Header="Recommended tracker lists">
                            <Grid MinWidth="400">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    x:Name="PresetTrackerListComboBox"
                                    HorizontalAlignment="Stretch"
                                    SelectedIndex="0">
                                    <ComboBoxItem
                                        x:Uid="ViewNetworkSettingsPageBestItem"
                                        Content="精选列表（best.txt）"
                                        Tag="https://cf.trackerslist.com/best.txt" />
                                    <ComboBoxItem
                                        x:Uid="ViewNetworkSettingsPageAllItem"
                                        Content="完整列表（all.txt）"
                                        Tag="https://cf.trackerslist.com/all.txt" />
                                    <ComboBoxItem
                                        x:Uid="ViewNetworkSettingsPageHttpItem"
                                        Content="HTTP(S) 列表（http.txt）"
                                        Tag="https://cf.trackerslist.com/http.txt" />
                                    <ComboBoxItem
                                        x:Uid="ViewNetworkSettingsPageNoHttpItem"
                                        Content="无 HTTP 列表（nohttp.txt）"
                                        Tag="https://cf.trackerslist.com/nohttp.txt" />
                                </ComboBox>
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="AddPresetTrackerListButton_Click"
                                    Content="Subscribe"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <!--  Connection Settings Section  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" Text="Connection" />

                <essential:SettingsExpander
                    Description="Configure the IPv4 and IPv6 endpoints used by libtorrent. Port 0 lets the operating system select an available port."
                    Header="BitTorrent listen endpoints">
                    <essential:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE839;" />
                    </essential:SettingsExpander.HeaderIcon>
                    <TextBlock
                        x:Name="ActualListenPortText"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Not listening" />
                    <essential:SettingsExpander.Items>
                        <essential:SettingsCard
                            ContentAlignment="Left"
                            Description="Use 0.0.0.0 to listen on every IPv4 interface."
                            Header="IPv4 endpoint">
                            <control:IpEndpointInput
                                x:Name="IPv4ListenEndpoint"
                                HorizontalAlignment="Stretch"
                                AllowAutomaticPort="True"
                                RequiredFamily="IPv4"
                                ValueChanged="ListenEndpoint_ValueChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard
                            ContentAlignment="Left"
                            Description="Use :: to listen on every IPv6 interface."
                            Header="IPv6 endpoint">
                            <control:IpEndpointInput
                                x:Name="IPv6ListenEndpoint"
                                HorizontalAlignment="Stretch"
                                Address="::"
                                AllowAutomaticPort="True"
                                RequiredFamily="IPv6"
                                ValueChanged="ListenEndpoint_ValueChanged" />
                        </essential:SettingsCard>
                        <essential:SettingsCard
                            ContentAlignment="Left"
                            Header="Runtime listener">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    x:Name="ActualListenEndpointText"
                                    FontWeight="SemiBold"
                                    Text="The BitTorrent engine is not running." />
                                <TextBlock
                                    x:Name="ActualListenStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </essential:SettingsCard>
                    </essential:SettingsExpander.Items>
                </essential:SettingsExpander>

                <essential:SettingsCard Description="Distributed Hash Table for decentralized peer discovery" Header="Enable DHT">
                    <ToggleSwitch x:Name="EnableDHTToggle" IsOn="True" />
                </essential:SettingsCard>

                <essential:SettingsCard Description="Exchange peer lists with connected peers" Header="Enable Peer Exchange (PEX)">
                    <ToggleSwitch x:Name="EnablePEXToggle" IsOn="True" />
                </essential:SettingsCard>

                <essential:SettingsCard Description="Discover peers on the local network" Header="Enable Local Peer Discovery (LSD)">
                    <ToggleSwitch x:Name="EnableLSDToggle" IsOn="True" />
                </essential:SettingsCard>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
