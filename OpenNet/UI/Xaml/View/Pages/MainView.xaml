<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxv="using:OpenNet.UI.Xaml.View"
    xmlns:settings="using:OpenNet.UI.Xaml.View.Pages.SettingsPages"
    xmlns:xtwa="using:XamlToolkit.WinUI.Animations"
    Loaded="MainView_Loaded"
    Unloaded="MainView_Unloaded"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary Source="ms-appx:///Styles/NavigationView.xaml" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  导航面板 / Navigation Panel  -->
        <NavigationView
            x:Name="NavView"
            x:Uid="NavView"
            Grid.Row="0"
            HighContrastAdjustment="None"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            Style="{StaticResource MainNavigationViewStyle}">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    x:Name="NavItem_Tasks"
                    x:Uid="NavItem_Tasks"
                    AutomationProperties.AutomationId="NavItem_Tasks"
                    Content="Tasks"
                    IsSelected="{x:Bind ViewModel.IsTasksPageSelected, Mode=TwoWay}"
                    Tag="{essential:TypeName Type=local:TasksPage}">
                    <NavigationViewItem.Icon>
                        <FontIcon xtwa:Implicit.Animations="{StaticResource IconOpacityAnim}" Glyph="{x:Bind ViewModel.TasksGlyph, Mode=OneWay}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

                <NavigationViewItem
                    x:Name="NavItem_RSS"
                    x:Uid="NavItem_RSS"
                    AutomationProperties.AutomationId="NavItem_RSS"
                    Content="RSS"
                    Tag="{essential:TypeName Type=local:RSSPage}">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>

            </NavigationView.MenuItems>

            <!--  Footer  -->
            <NavigationView.FooterMenuItems>
                <!--  More  -->
                <NavigationViewItem
                    x:Name="NavItem_More"
                    x:Uid="NavItem_More"
                    AutomationProperties.AutomationId="NavItem_More"
                    Content="More"
                    SelectsOnInvoked="False"
                    Tapped="NavItem_More_Tapped">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE700;" />
                    </NavigationViewItem.Icon>

                    <FlyoutBase.AttachedFlyout>
                        <Flyout
                            essential:FlyoutHelper.AcrylicWorkaround="True"
                            LightDismissOverlayMode="On"
                            Placement="RightEdgeAlignedBottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style BasedOn="{StaticResource DefaultFlyoutPresenterStyle}" TargetType="FlyoutPresenter">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="IsTabStop" Value="True" />
                                    <Setter Property="MaxWidth" Value="Infinity" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="TabNavigation" Value="Cycle" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <ouxv:ItemsCardPopupView />
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>

                </NavigationViewItem>
                <!--  Settings  -->
                <NavigationViewItem
                    x:Name="NavItem_Settings"
                    x:Uid="NavItem_Settings"
                    AutomationProperties.AutomationId="NavItem_Settings"
                    Tag="{essential:TypeName Type=settings:MainSettingsPage}">
                    <NavigationViewItem.Icon>
                        <AnimatedIcon
                            x:Name="AnimatedIcon"
                            PointerEntered="SettingButton_PointerEntered"
                            PointerExited="SettingButton_PointerExited">
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedSettingsVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource Glyph="&#xE713;" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </NavigationViewItem.Icon>

                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <NavigationView.Content>
                <Frame
                    x:Name="NavFrame"
                    Navigated="NavFrame_Navigated"
                    NavigationFailed="NavFrame_NavigationFailed" />
            </NavigationView.Content>
        </NavigationView>

        <!--  状态栏 / Status Bar  -->
        <Grid
            x:Uid="StatusBar"
            Grid.Row="1"
            Padding="12,6"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  Speed Display  -->
            <StackPanel
                Grid.Column="0"
                Margin="0,0,16,0"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="8">
                <essential:SwitchPresenter Padding="8" Value="{x:Bind ViewModel.SpeedLevel, Mode=OneWay}">
                    <essential:Case Value="Low">
                        <FontIcon FontSize="14" Glyph="&#xEC48;" />
                    </essential:Case>
                    <essential:Case Value="Medium">
                        <FontIcon FontSize="14" Glyph="&#xEC49;" />
                    </essential:Case>
                    <essential:Case Value="High">
                        <FontIcon FontSize="14" Glyph="&#xEC4A;" />
                    </essential:Case>
                </essential:SwitchPresenter>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{x:Bind ViewModel.CurrentTransferSpeedText, Mode=OneWay, FallbackValue='↓ 0 B/s  ↑ 0 B/s'}" />
            </StackPanel>

            <!--  Connection Status  -->
            <Border
                Grid.Column="1"
                Margin="0,0,16,0"
                Padding="8,4"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xF22C;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{x:Bind ViewModel.ConnectedPeersCount, Mode=OneWay, FallbackValue='0'}" />
                    <TextBlock
                        x:Uid="ViewTasksPageToggleMenuItem"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Peers" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Text="|" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="{x:Bind ViewModel.DhtNodeCount, Mode=OneWay, FallbackValue='0'}" />
                    <TextBlock
                        x:Uid="ViewMainViewDHTTextBlock"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="DHT" />
                </StackPanel>
            </Border>

            <StackPanel
                Grid.Column="2"
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="12">
                <!--  User Info  -->
                <StackPanel
                    Grid.Column="4"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE77B;" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{x:Bind ViewModel.UserName, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <!--  Port State  -->
            <Button
                Grid.Column="3"
                Margin="16,0,0,0"
                Padding="6,3"
                Click="PortState_Click"
                Style="{StaticResource SubtleButtonStyle}">
                <ToolTipService.ToolTip>
                    <ToolTip
                        x:Uid="ViewMainViewPortButtonToolTip"
                        essential:ToolTipHelper.AcrylicWorkaround="True"
                        Content="Show IPv4 and IPv6 port status" />
                </ToolTipService.ToolTip>
                <FlyoutBase.AttachedFlyout>
                    <Flyout essential:FlyoutHelper.AcrylicWorkaround="True" Placement="TopEdgeAlignedRight">
                        <StackPanel Width="320" Spacing="12">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Listening port reachability" />

                            <Grid ColumnSpacing="12" RowSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <essential:SwitchPresenter Padding="0" Value="{x:Bind ViewModel.IPv4PortState, Mode=OneWay}">
                                    <essential:Case Value="Open">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                    </essential:Case>
                                    <essential:Case Value="Blocked">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" />
                                    </essential:Case>
                                    <essential:Case Value="Timed out">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE823;" />
                                    </essential:Case>
                                    <essential:Case Value="Unavailable">
                                        <FontIcon Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE711;" />
                                    </essential:Case>
                                    <essential:Case Value="Unknown">
                                        <FontIcon Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE9CE;" />
                                    </essential:Case>
                                </essential:SwitchPresenter>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="IPv4" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Width="34"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="TCP" />
                                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.IPv4TcpPortState, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Width="34"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="UDP" />
                                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.IPv4UdpPortState, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Text="{x:Bind ViewModel.IPv4ListenPortText, Mode=OneWay}" />

                                <essential:SwitchPresenter
                                    Grid.Row="1"
                                    Padding="0"
                                    Value="{x:Bind ViewModel.IPv6PortState, Mode=OneWay}">
                                    <essential:Case Value="Open">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                    </essential:Case>
                                    <essential:Case Value="Blocked">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xE711;" />
                                    </essential:Case>
                                    <essential:Case Value="Timed out">
                                        <FontIcon Foreground="{ThemeResource SystemFillColorCautionBrush}" Glyph="&#xE823;" />
                                    </essential:Case>
                                    <essential:Case Value="Unavailable">
                                        <FontIcon Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE711;" />
                                    </essential:Case>
                                    <essential:Case Value="Unknown">
                                        <FontIcon Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE9CE;" />
                                    </essential:Case>
                                </essential:SwitchPresenter>
                                <StackPanel
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Spacing="2">
                                    <TextBlock FontWeight="SemiBold" Text="IPv6" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Width="34"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="TCP" />
                                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.IPv6TcpPortState, Mode=OneWay}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            Width="34"
                                            FontSize="12"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="UDP" />
                                        <TextBlock FontSize="12" Text="{x:Bind ViewModel.IPv6UdpPortState, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock
                                    Grid.Row="1"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    Text="{x:Bind ViewModel.IPv6ListenPortText, Mode=OneWay}" />
                            </Grid>

                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="OpenPortTestWindow_Click"
                                Content="Open full NAT and port test" />
                        </StackPanel>
                    </Flyout>
                </FlyoutBase.AttachedFlyout>
                <StackPanel
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <essential:SwitchPresenter Padding="0" Value="{x:Bind ViewModel.PortState, Mode=OneWay}">
                        <essential:Case Value="Unknown">
                            <FontIcon
                                FontFamily="Segoe UI Emoji"
                                FontSize="14"
                                Glyph="&#x1F7E4;" />
                        </essential:Case>
                        <essential:Case Value="Open">
                            <FontIcon
                                FontFamily="Segoe UI Emoji"
                                FontSize="14"
                                Glyph="&#x1F7E2;" />
                        </essential:Case>
                        <essential:Case Value="Blocked">
                            <FontIcon
                                FontFamily="Segoe UI Emoji"
                                FontSize="20"
                                Glyph="&#x1F7E1;">
                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        x:Uid="ViewMainViewToolTipText1"
                                        essential:ToolTipHelper.AcrylicWorkaround="True"
                                        Content="Port is blocked. Please check your router or firewall settings." />
                                </ToolTipService.ToolTip>
                            </FontIcon>
                        </essential:Case>
                    </essential:SwitchPresenter>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.ListenPortText, Mode=OneWay, FallbackValue='—'}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
