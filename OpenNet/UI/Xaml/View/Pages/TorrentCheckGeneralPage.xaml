<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TorrentCheckGeneralPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:controls="using:XamlToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:OpenNet.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <Style x:Key="FeatureCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="16,12,16,16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Page.Resources>
    <Grid
        Padding="16,0,16,16"
        VerticalAlignment="Stretch"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  Save Location Section  -->
                <Border
                    Grid.Row="0"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Spacing="8">
                        <TextBlock
                            x:Uid="AddMagnet_SaveLabel"
                            FontWeight="SemiBold"
                            Text="Save Location" />
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Uid="TorrentCheckGeneralPage_SavePathLabel"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Text="Save to:" />

                            <AutoSuggestBox
                                x:Name="TorrentCheckGeneralPageSavePath"
                                x:Uid="TorrentCheckGeneralPageSavePath"
                                Grid.Column="1"
                                PlaceholderText="Choose download location"
                                TextChanged="TorrentCheckGeneralPageSavePath_TextChanged">
                                <AutoSuggestBox.QueryIcon>
                                    <FontIcon HorizontalAlignment="Center" Glyph="&#xE70D;" />
                                </AutoSuggestBox.QueryIcon>
                            </AutoSuggestBox>

                            <Button
                                x:Uid="TorrentCheckGeneralPage_FolderPickerButton"
                                Grid.Column="2"
                                MinWidth="36"
                                AutomationProperties.AutomationId="TorrentCheckGeneralPage_FolderPickerButton"
                                Click="TorrentCheckGeneralPageFolderPicker_Click">
                                <ToolTipService.ToolTip>
                                    <ToolTip
                                        x:Uid="CommonContentBrowse"
                                        essential:ToolTipHelper.AcrylicWorkaround="True"
                                        Content="Browse..." />
                                </ToolTipService.ToolTip>
                                <Button.Content>
                                    <FontIcon Glyph="&#xEC50;" />
                                </Button.Content>
                            </Button>

                            <TextBlock
                                x:Uid="TorrentCheckGeneralPage_FileNameLabel"
                                Grid.Row="1"
                                Margin="0,0,4,0"
                                VerticalAlignment="Center"
                                Text="Save as:" />
                            <TextBox
                                x:Name="TorrentFileNameTextBox"
                                x:Uid="TorrentCheckGeneralPage_FileNameTextBox"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.AutomationId="TorrentCheckGeneralPage_FileNameTextBox" />

                            <CheckBox
                                x:Name="CreateSubfolderCheckBox"
                                x:Uid="TorrentCheckGeneralPage_CreateSubfolderCheckBox"
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="2"
                                AutomationProperties.AutomationId="TorrentCheckGeneralPage_CreateSubfolderCheckBox"
                                Content="Create subfolder"
                                IsChecked="{x:Bind ViewModel.CreateSubfolder, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Torrent Content Section  -->
                <Border
                    Grid.Row="1"
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <essential:SwitchPresenter
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Value="{x:Bind ViewModel.MetadataState, Mode=OneWay}">
                        <essential:Case Value="Loading">
                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="12">
                                <ProgressRing
                                    Width="48"
                                    Height="48"
                                    IsActive="True"
                                    IsIndeterminate="True" />
                                <TextBlock
                                    x:Uid="ViewTorrentCheckGeneralPageTextBlock"
                                    HorizontalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Downloading magnet metadata" />
                                <TextBlock
                                    MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.MetadataStatus, Mode=OneWay}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="ViewTorrentCheckGeneralPageTextBlock"
                                    MaxWidth="520"
                                    HorizontalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="You can configure the save location and trackers now, or add the task immediately. Metadata will continue downloading in the task list."
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </essential:Case>
                        <essential:Case Value="Ready">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    x:Uid="TorrentCheckGeneralPage_TorrentContentTitle"
                                    FontWeight="SemiBold"
                                    Text="Torrent Content" />

                                <!--  Torrent Info Summary  -->
                                <Grid
                                    Grid.Row="1"
                                    ColumnSpacing="8"
                                    RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock x:Uid="TorrentCheckGeneralPage_TorrentNameLabel" Text="Name:" />
                                    <TextBlock
                                        x:Name="TorrentNameText"
                                        Grid.Column="1"
                                        Text=""
                                        TextTrimming="CharacterEllipsis" />

                                    <TextBlock
                                        x:Uid="TorrentCheckGeneralPage_TorrentSizeLabel"
                                        Grid.Row="1"
                                        Text="Total Size:" />
                                    <TextBlock
                                        x:Name="TorrentSizeText"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Text="" />

                                    <TextBlock
                                        x:Uid="TorrentCheckGeneralPage_SelectedSizeLabel"
                                        Grid.Row="2"
                                        Text="Selected:" />
                                    <TextBlock
                                        x:Name="SelectedSizeText"
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Text="" />
                                </Grid>

                                <!--  Disk Space Info  -->
                                <Border
                                    Grid.Row="2"
                                    Padding="12"
                                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!--  HardDrive Icon  -->
                                        <FontIcon
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            FontSize="20"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Glyph="&#xEDA2;" />
                                        <!--  Progress Bar showing disk usage - fixed width container  -->
                                        <Grid Grid.Column="1" MinWidth="200">
                                            <ProgressBar
                                                x:Name="DiskSpaceProgressBar"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Center"
                                                IsIndeterminate="False"
                                                Maximum="100"
                                                ShowError="False"
                                                ShowPaused="False"
                                                Value="0" />
                                        </Grid>
                                        <!--  Space info  -->
                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="16">
                                            <!--  Required space  -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    x:Uid="TorrentCheckGeneralPage_DiskSpaceRequired"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Required:" />
                                                <TextBlock
                                                    x:Name="DiskSpaceText"
                                                    MinWidth="80"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="--" />
                                            </StackPanel>
                                            <!--  Free space  -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    x:Uid="TorrentCheckGeneralPage_DiskSpaceFree"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Free:" />
                                                <TextBlock
                                                    x:Name="FreeSpaceText"
                                                    MinWidth="80"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="--" />
                                            </StackPanel>
                                            <!--  Total space  -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock
                                                    x:Uid="TorrentCheckGeneralPage_DiskSpaceTotal"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Total:" />
                                                <TextBlock
                                                    x:Name="TotalSpaceText"
                                                    MinWidth="80"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Text="--" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Expander
                                    x:Uid="TorrentDetailsExpander"
                                    Grid.Row="3"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="TorrentDetailsExpander"
                                    Header="Torrent details">
                                    <Grid
                                        Padding="12,8"
                                        ColumnSpacing="12"
                                        RowSpacing="6">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Uid="TorrentDetailsInfoHash" Text="Info hash:" />
                                        <TextBlock
                                            x:Name="TorrentInfoHashText"
                                            Grid.Column="1"
                                            FontFamily="Consolas"
                                            IsTextSelectionEnabled="True"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Uid="TorrentDetailsCreator"
                                            Grid.Row="1"
                                            Text="Created by:" />
                                        <TextBlock
                                            x:Name="TorrentCreatorText"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            IsTextSelectionEnabled="True" />
                                        <TextBlock
                                            x:Uid="TorrentDetailsCreatedOn"
                                            Grid.Row="2"
                                            Text="Created on:" />
                                        <TextBlock
                                            x:Name="TorrentCreationDateText"
                                            Grid.Row="2"
                                            Grid.Column="1"
                                            IsTextSelectionEnabled="True" />
                                        <TextBlock
                                            x:Uid="TorrentDetailsPieces"
                                            Grid.Row="3"
                                            Text="Pieces:" />
                                        <TextBlock
                                            x:Name="TorrentPieceInfoText"
                                            Grid.Row="3"
                                            Grid.Column="1"
                                            IsTextSelectionEnabled="True" />
                                        <TextBlock
                                            x:Uid="TorrentDetailsComment"
                                            Grid.Row="4"
                                            Text="Comment:" />
                                        <TextBlock
                                            x:Name="TorrentCommentText"
                                            Grid.Row="4"
                                            Grid.Column="1"
                                            IsTextSelectionEnabled="True"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Expander>

                                <!--  File List using HeaderedTreeView with DataTable  -->
                                <Border
                                    Grid.Row="4"
                                    Padding="0"
                                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="2">
                                    <controls:HeaderedTreeView
                                        x:Name="TorrentFileTreeView"
                                        ItemsSource="{x:Bind ViewModel.FileTree}"
                                        SelectionMode="None">
                                        <controls:HeaderedTreeView.Header>
                                            <Border
                                                Padding="8,4,0,4"
                                                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                                                CornerRadius="4">
                                                <interactivity:Interaction.Behaviors>
                                                    <behaviors:StickyHeaderBehavior />
                                                </interactivity:Interaction.Behaviors>
                                                <labs:DataTable ColumnSpacing="8">
                                                    <!--  File Name column - Star width (fills remaining space)  -->
                                                    <labs:DataColumn
                                                        x:Name="ColCheckFileName"
                                                        CanResize="True"
                                                        DesiredWidth="*">
                                                        <TextBlock
                                                            x:Uid="TorrentCheckGeneralPage_ListHeader_FileName"
                                                            FontWeight="SemiBold"
                                                            Text="File Name" />
                                                    </labs:DataColumn>
                                                    <!--  Size column  -->
                                                    <labs:DataColumn
                                                        x:Name="ColCheckSize"
                                                        CanResize="True"
                                                        DesiredWidth="160">
                                                        <TextBlock
                                                            x:Uid="TorrentCheckGeneralPage_ListHeader_Size"
                                                            FontWeight="SemiBold"
                                                            Text="Size" />
                                                    </labs:DataColumn>
                                                    <!--  Priority column  -->
                                                    <labs:DataColumn
                                                        x:Name="ColCheckPriority"
                                                        CanResize="True"
                                                        DesiredWidth="160">
                                                        <TextBlock
                                                            x:Uid="TorrentCheckGeneralPage_ListHeader_Priority"
                                                            FontWeight="SemiBold"
                                                            Text="Priority" />
                                                    </labs:DataColumn>
                                                </labs:DataTable>
                                            </Border>
                                        </controls:HeaderedTreeView.Header>
                                        <controls:HeaderedTreeView.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TorrentFileNodeViewModel">
                                                <muxc:TreeViewItem
                                                    HorizontalContentAlignment="Stretch"
                                                    AllowDrop="False"
                                                    CanDrag="False"
                                                    IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                                    ItemsSource="{x:Bind Children}">
                                                    <labs:DataRow CanDrag="False">
                                                        <!--  File name with icon  -->
                                                        <Grid ColumnSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <!--  Checkbox for selection  -->
                                                            <CheckBox
                                                                Width="Auto"
                                                                MinWidth="0"
                                                                Click="FileCheckBox_Click"
                                                                IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                                                            <FontIcon
                                                                x:Name="TorrentMDFileTypePreviewFontIcon"
                                                                Grid.Column="1"
                                                                VerticalAlignment="Center"
                                                                FontFamily="{x:Bind NodeFontFamily}"
                                                                FontSize="16"
                                                                Glyph="{x:Bind NodeGlyph}" />
                                                            <TextBlock
                                                                Grid.Column="2"
                                                                VerticalAlignment="Center"
                                                                Text="{x:Bind Name}"
                                                                TextTrimming="CharacterEllipsis">
                                                                <ToolTipService.ToolTip>
                                                                    <ToolTip essential:ToolTipHelper.AcrylicWorkaround="True" Content="{x:Bind FullPath}" />
                                                                </ToolTipService.ToolTip>
                                                            </TextBlock>
                                                        </Grid>
                                                        <!--  Size  -->
                                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind SizeText}" />
                                                        <!--  Priority  -->
                                                        <TextBlock VerticalAlignment="Center" Text="{x:Bind PriorityText}" />

                                                    </labs:DataRow>
                                                </muxc:TreeViewItem>
                                            </DataTemplate>
                                        </controls:HeaderedTreeView.ItemTemplate>
                                        <!--<controls:HeaderedTreeView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                    </Style>
                                </controls:HeaderedTreeView.ItemContainerStyle>-->
                                    </controls:HeaderedTreeView>
                                </Border>
                            </Grid>
                        </essential:Case>
                    </essential:SwitchPresenter>
                </Border>
            </Grid>
        </Grid>

        <!--  Bottom Filter Bar  -->
        <Grid
            Grid.Row="1"
            VerticalAlignment="Bottom"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                HorizontalAlignment="Left"
                Orientation="Horizontal"
                Spacing="4">
                <CheckBox
                    x:Name="SelectAllFilterCheckBox"
                    x:Uid="TorrentCheckGeneralPage_Filter_SelectAll"
                    MinHeight="12"
                    AutomationProperties.AutomationId="TorrentCheckGeneralPage_Filter_SelectAll"
                    Checked="SelectAllCheckBox_Checked"
                    Content="Select All"
                    IsChecked="True"
                    Unchecked="SelectAllCheckBox_Unchecked" />
                <CheckBox
                    x:Name="VideoFilterCheckBox"
                    x:Uid="TorrentCheckGeneralPage_Filter_Video"
                    AutomationProperties.AutomationId="TorrentCheckGeneralPage_Filter_Video"
                    Checked="FilterCheckBox_Checked"
                    Content="Video"
                    Tag=".mp4,.mkv,.avi,.mov,.wmv"
                    Unchecked="FilterCheckBox_Unchecked" />
                <CheckBox
                    x:Name="AudioFilterCheckBox"
                    x:Uid="TorrentCheckGeneralPage_Filter_Audio"
                    AutomationProperties.AutomationId="TorrentCheckGeneralPage_Filter_Audio"
                    Checked="FilterCheckBox_Checked"
                    Content="Audio"
                    Tag=".mp3,.flac,.wav,.aac,.ogg"
                    Unchecked="FilterCheckBox_Unchecked" />
                <CheckBox
                    x:Name="PictureFilterCheckBox"
                    x:Uid="TorrentCheckGeneralPage_Filter_Picture"
                    AutomationProperties.AutomationId="TorrentCheckGeneralPage_Filter_Picture"
                    Checked="FilterCheckBox_Checked"
                    Content="Picture"
                    Tag=".jpg,.jpeg,.png,.gif,.bmp,.webp"
                    Unchecked="FilterCheckBox_Unchecked" />
                <CheckBox
                    x:Name="OtherFilterCheckBox"
                    x:Uid="TorrentCheckGeneralPage_Filter_Other"
                    AutomationProperties.AutomationId="TorrentCheckGeneralPage_Filter_Other"
                    Checked="FilterCheckBox_Checked"
                    Content="Other"
                    IsChecked="True"
                    Tag="other"
                    Unchecked="FilterCheckBox_Unchecked" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
