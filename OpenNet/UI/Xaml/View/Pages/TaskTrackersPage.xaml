<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskTrackersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:effects="using:OpenNet.UI.Xaml.Control.Effect"
    xmlns:essential="using:WinUI3Package"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:segment="using:OpenNet.UI.Xaml.Control.Progress.HttpSegment"
    xmlns:vm="using:OpenNet.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/AnimatedNumber_ResourceDictionary.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/AcrylicBrush_ResourceDictionary.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Progress/HttpSegment/HttpSegmentProgressBar_ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="0,8,0,0">
        <ListView x:Name="TrackersListView" SelectionMode="Single">
            <ListView.ContextFlyout>
                <MenuFlyout Opening="TrackerMenu_Opening">
                    <MenuFlyoutItem
                        x:Uid="ViewTaskTrackersPageText1"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText1"
                        Click="EditTrackers_Click"
                        Text="Edit trackers..." />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Name="UpdateTrackerMenuItem"
                        x:Uid="ViewTaskTrackersPageText2"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText2"
                        Click="UpdateTracker_Click"
                        Text="Update tracker" />
                    <MenuFlyoutItem
                        x:Uid="ViewTaskTrackersPageText3"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText3"
                        Click="RemoveTracker_Click"
                        Text="Remove tracker" />
                    <MenuFlyoutItem
                        x:Uid="ViewTaskTrackersPageText4"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText4"
                        Click="ViewLog_Click"
                        Text="View log" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="ViewTaskTrackersPageText5"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText5"
                        Click="ClearTrackerLog_Click"
                        Text="Clear log" />
                    <MenuFlyoutItem
                        x:Uid="ViewTaskTrackersPageText6"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText6"
                        Click="ClearTaskTrackerLogs_Click"
                        Text="Clear log in all trackers" />
                    <MenuFlyoutItem
                        x:Uid="ViewTaskTrackersPageText7"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText7"
                        Click="ClearAllTrackerLogs_Click"
                        Text="Clear log in trackers of all tasks" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        x:Uid="ViewTaskTrackersPageText8"
                        AutomationProperties.AutomationId="ViewTaskTrackersPageText8"
                        Click="RemoveUnreachableTrackers_Click"
                        Text="Remove all unreachable trackers..." />
                </MenuFlyout>
            </ListView.ContextFlyout>
            <ListView.Header>
                <Border
                    Padding="8,4,0,4"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    CornerRadius="4"
                    RightTapped="ColumnHeader_RightTapped">
                    <Border.ContextFlyout>
                        <MenuFlyout Opening="ColumnMenu_Opening">
                            <MenuFlyoutItem
                                x:Name="AutoSizeSelectedColumnItem"
                                x:Uid="ViewPageTasksColumnAutoSizeSelectedWidth"
                                AutomationProperties.AutomationId="ViewPageTasksColumnAutoSizeSelectedWidth"
                                Click="AutoSizeSelectedColumn_Click"
                                Text="Auto Fit Selected Column" />
                            <MenuFlyoutItem
                                x:Uid="ViewPageTasksColumnAutoSizeAllWidth"
                                AutomationProperties.AutomationId="ViewPageTasksColumnAutoSizeAllWidth"
                                Click="AutoSizeAllColumns_Click"
                                Text="Auto Fit All Columns" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText11"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="URL"
                                Text="Tracker URL" />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText12"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Log"
                                Text="Log" />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText13"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Retries"
                                Text="Retries" />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText14"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="TimeRemaining"
                                Text="Time remaining" />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText15"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Seeders"
                                Text="Seeders" />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText16"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Leechers"
                                Text="Leechers" />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText17"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Downloaded"
                                Text="Downloaded" />
                            <ToggleMenuFlyoutItem
                                x:Uid="ViewTaskTrackersPageText18"
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Status"
                                Text="Status" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Uid="CommonTextResetColumns"
                                AutomationProperties.AutomationId="CommonTextResetColumns"
                                Click="ResetColumns_Click"
                                Text="Reset Columns and Sorting" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StickyHeaderBehavior />
                    </interactivity:Interaction.Behaviors>
                    <labs:DataTable ColumnSpacing="16">
                        <labs:DataColumn x:Name="ColTrackerURL" CanResize="True">
                            <Button
                                x:Name="SortTrackerUrlButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="URL">
                                <TextBlock
                                    x:Name="TrackerUrlHeaderText"
                                    x:Uid="ViewTaskTrackersPageText11"
                                    Text="Tracker URL"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerLog" DesiredWidth="48">
                            <Button
                                x:Name="SortTrackerLogButton"
                                FontWeight="SemiBold"
                                IsEnabled="False"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Log">
                                <TextBlock
                                    x:Name="TrackerLogHeaderText"
                                    x:Uid="ViewTaskTrackersPageText12"
                                    Text="Log" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerRetries" CanResize="True">
                            <Button
                                x:Name="SortTrackerRetriesButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Retries">
                                <TextBlock
                                    x:Name="TrackerRetriesHeaderText"
                                    x:Uid="ViewTaskTrackersPageText13"
                                    Text="Retries"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerTimeRemaining" CanResize="True">
                            <Button
                                x:Name="SortTrackerTimeRemainingButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="TimeRemaining">
                                <TextBlock
                                    x:Name="TrackerTimeHeaderText"
                                    x:Uid="ViewTaskTrackersPageText14"
                                    Text="Time remaining"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerSeeders" CanResize="True">
                            <Button
                                x:Name="SortTrackerSeedersButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Seeders">
                                <TextBlock
                                    x:Name="TrackerSeedersHeaderText"
                                    x:Uid="ViewTaskTrackersPageText15"
                                    Text="Seeders"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerLeechers" CanResize="True">
                            <Button
                                x:Name="SortTrackerLeechersButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Leechers">
                                <TextBlock
                                    x:Name="TrackerLeechersHeaderText"
                                    x:Uid="ViewTaskTrackersPageText16"
                                    Text="Leechers"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerDownloaded" CanResize="True">
                            <Button
                                x:Name="SortTrackerDownloadedButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Downloaded">
                                <TextBlock
                                    x:Name="TrackerDownloadedHeaderText"
                                    x:Uid="CommonTextDownloaded"
                                    Text="Downloaded"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerStatus" CanResize="True">
                            <Button
                                x:Name="SortTrackerStatusButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Status">
                                <TextBlock
                                    x:Name="TrackerStatusHeaderText"
                                    x:Uid="ViewTaskTrackersPageText18"
                                    Text="Status"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                    </labs:DataTable>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackerDisplayItem">
                    <labs:DataRow
                        HorizontalAlignment="Left"
                        Loaded="TrackerDataRow_Loaded"
                        RightTapped="TrackerRow_RightTapped">
                        <labs:DataRow.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </labs:DataRow.Resources>
                        <TextBlock
                            MaxLines="1"
                            Text="{x:Bind URL, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">
                            <ToolTipService.ToolTip>
                                <ToolTip essential:ToolTipHelper.AcrylicWorkaround="True" Content="{x:Bind URL, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <Button
                            Padding="8,2"
                            Click="TrackerLogButton_Click"
                            Style="{StaticResource SubtleButtonStyle}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind TrackerProgressVisibility, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE946;" />
                        </Button>
                        <effects:AnimatedNumber VerticalAlignment="Center" Value="{x:Bind Retries, Mode=OneWay}" />
                        <effects:AnimatedNumber VerticalAlignment="Center" Value="{x:Bind TimeRemaining, Mode=OneWay}" />
                        <effects:AnimatedNumber VerticalAlignment="Center" Value="{x:Bind Seeders, Mode=OneWay}" />
                        <Grid>
                            <effects:AnimatedNumber
                                VerticalAlignment="Center"
                                Visibility="{x:Bind TrackerProgressVisibility, Mode=OneWay}"
                                Value="{x:Bind Leechers, Mode=OneWay}" />
                            <Grid MinWidth="140" Visibility="{x:Bind HttpProgressVisibility, Mode=OneWay}">
                                <segment:RangePieceBar Height="10" Pieces="{x:Bind ProgressPieces, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Text="{x:Bind ProgressText, Mode=OneWay}" />
                            </Grid>
                        </Grid>
                        <effects:AnimatedNumber VerticalAlignment="Center" Value="{x:Bind Downloaded, Mode=OneWay}" />
                        <TextBlock
                            MaxLines="1"
                            Text="{x:Bind Status, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">
                            <ToolTipService.ToolTip>
                                <ToolTip essential:ToolTipHelper.AcrylicWorkaround="True" Content="{x:Bind Status, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </TextBlock>
                    </labs:DataRow>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            x:Name="EmptyStatePanel"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="Collapsed">
            <FontIcon
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Glyph="&#xE774;" />
            <TextBlock
                x:Name="EmptyStateText"
                x:Uid="ViewTaskTrackersPageText28"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="No trackers" />
            <Button
                x:Uid="ViewTaskTrackersPageText29"
                HorizontalAlignment="Center"
                AutomationProperties.AutomationId="ViewTaskTrackersPageText29"
                Click="EditTrackers_Click"
                Content="Add trackers" />
        </StackPanel>
    </Grid>
</Page>
