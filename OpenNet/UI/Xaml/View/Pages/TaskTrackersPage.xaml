<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskTrackersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OpenNet.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="0,8,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Tracker list  -->
        <ListView
            x:Name="TrackersListView"
            Grid.Row="1"
            SelectionMode="None">
            <ListView.Header>
                <Border
                    Padding="8,4,0,4"
                    Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                    CornerRadius="4"
                    RightTapped="ColumnHeader_RightTapped">
                    <Border.ContextFlyout>
                        <MenuFlyout Opening="ColumnMenu_Opening">
                            <MenuFlyoutItem
                                x:Name="AutoSizeSelectedColumnItem"
                                Click="AutoSizeSelectedColumn_Click"
                                Text="Auto Size Selected Column's Width to Fit" />
                            <MenuFlyoutItem Click="AutoSizeAllColumns_Click" Text="Auto Size All Columns' Width to Fit" />
                            <MenuFlyoutSeparator />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="URL"
                                Text="URL" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Tier"
                                Text="Tier" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Peers"
                                Text="Peers" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Status"
                                Text="Status" />
                            <ToggleMenuFlyoutItem
                                Click="ColumnVisibility_Click"
                                IsChecked="True"
                                Tag="Message"
                                Text="Message" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Click="ResetColumns_Click" Text="Reset Columns and Sorting" />
                        </MenuFlyout>
                    </Border.ContextFlyout>
                    <interactivity:Interaction.Behaviors>
                        <behaviors:StickyHeaderBehavior />
                    </interactivity:Interaction.Behaviors>
                    <labs:DataTable ColumnSpacing="16">
                        <labs:DataColumn x:Name="ColTrackerURL" CanResize="True">
                            <Button
                                x:Name="SortTrackerUrlButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="URL">
                                <TextBlock
                                    x:Uid="TrackerHeader_URL"
                                    Text="URL"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerTier" CanResize="True">
                            <Button
                                x:Name="SortTrackerTierButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Tier">
                                <TextBlock
                                    x:Uid="TrackerHeader_Tier"
                                    Text="Tier"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerPeers" CanResize="True">
                            <Button
                                x:Name="SortTrackerPeersButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Peers">
                                <TextBlock
                                    x:Uid="TrackerHeader_Peers"
                                    Text="Peers"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerStatus" CanResize="True">
                            <Button
                                x:Name="SortTrackerStatusButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Status">
                                <TextBlock
                                    x:Uid="TrackerHeader_Status"
                                    Text="Status"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                        <labs:DataColumn x:Name="ColTrackerMessage" CanResize="True">
                            <Button
                                x:Name="SortTrackerMessageButton"
                                Click="ColumnHeader_Click"
                                FontWeight="SemiBold"
                                Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                Tag="Message">
                                <TextBlock
                                    x:Uid="TrackerHeader_Message"
                                    Text="Message"
                                    TextTrimming="CharacterEllipsis" />
                            </Button>
                        </labs:DataColumn>
                    </labs:DataTable>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrackerDisplayItem">
                    <labs:DataRow HorizontalAlignment="Left">
                        <TextBlock Text="{x:Bind URL, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Tier, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Peers, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Status, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                    </labs:DataRow>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!--  Empty state  -->
        <TextBlock
            x:Name="EmptyStateText"
            x:Uid="TrackersList_EmptyState"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="No trackers"
            Visibility="Collapsed" />
    </Grid>
</Page>
