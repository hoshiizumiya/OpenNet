<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.NatToolsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="NatToolsPageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,30,0,6" />
            </Style.Setters>
        </Style>
    </Page.Resources>

    <ScrollViewer>
        <Grid Padding="24">
            <StackPanel HorizontalAlignment="Stretch" Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <!--  NAT Detection Section  -->
                <TextBlock
                    x:Uid="NatTools_NATDetection"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="NAT Type Detection" />

                <Button
                    x:Name="DetectNatButton"
                    x:Uid="NatTools_DetectButton"
                    AutomationProperties.AutomationId="NatTools_DetectButton"
                    Click="DetectNat_Click"
                    Content="Detect NAT Type" />

                <ProgressRing
                    x:Name="DetectingProgress"
                    Width="24"
                    Height="24"
                    Margin="0,8"
                    IsActive="False"
                    Visibility="Collapsed" />

                <StackPanel Margin="0,8,0,0" Spacing="4">
                    <TextBlock>
                        <Run x:Uid="NatTools_NATTypeLabel" Text="NAT Type: " />
                        <Run
                            x:Name="NatTypeText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="NatTools_PublicIPLabel" Text="Public IPv4: " />
                        <Run
                            x:Name="PublicIPText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="ViewNatToolsPageRun" Text="Public IPv6: " />
                        <Run
                            x:Name="PublicIPv6Text"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="ViewNatToolsPageRun" Text="Network Type: " />
                        <Run
                            x:Name="NetworkTypeText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="NatTools_UPnPLabel" Text="UPnP: " />
                        <Run
                            x:Name="UPnPText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="ViewNatToolsPageRun" Text="NAT-PMP: " />
                        <Run
                            x:Name="NatPmpText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="ViewNatToolsPageRun" Text="Listen Port: " />
                        <Run
                            x:Name="ListenPortText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="ViewNatToolsPageRun" Text="DHT Nodes: " />
                        <Run
                            x:Name="DhtNodesText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="ViewNatToolsPageRun" Text="Active Torrents: " />
                        <Run
                            x:Name="ActiveTorrentsText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                    <TextBlock>
                        <Run x:Uid="ViewNatToolsPageRun" Text="Connected Peers: " />
                        <Run
                            x:Name="ConnectedPeersText"
                            FontWeight="SemiBold"
                            Text="-" />
                    </TextBlock>
                </StackPanel>

                <!--  STUN Test Detail Table  -->
                <TextBlock
                    x:Uid="ViewNatToolsPageTextBlock"
                    Margin="0,24,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="STUN Test Details" />

                <Grid
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="180" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                        <ColumnDefinition Width="*" MinWidth="140" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header Row  -->
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="0"
                        Grid.Column="0"
                        Margin="0,0,0,8"
                        FontWeight="Bold"
                        Text="Test" />
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="8,0,0,8"
                        FontWeight="Bold"
                        Text="Server 1 (Same Port)" />
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="8,0,0,8"
                        FontWeight="Bold"
                        Text="Server 1 (Diff Port)" />
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="0"
                        Grid.Column="3"
                        Margin="8,0,0,8"
                        FontWeight="Bold"
                        Text="Server 2 (Same Port)" />

                    <!--  Row 1: STUN Binding  -->
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="1"
                        Grid.Column="0"
                        Margin="0,4"
                        Text="STUN Binding" />
                    <TextBlock
                        x:Name="StunTest1_1"
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="8,4"
                        Text="-" />
                    <TextBlock
                        x:Name="StunTest1_2"
                        Grid.Row="1"
                        Grid.Column="2"
                        Margin="8,4"
                        Text="-" />
                    <TextBlock
                        x:Name="StunTest1_3"
                        Grid.Row="1"
                        Grid.Column="3"
                        Margin="8,4"
                        Text="-" />

                    <!--  Row 2: Public IP  -->
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="2"
                        Grid.Column="0"
                        Margin="0,4"
                        Text="Public IP:Port" />
                    <TextBlock
                        x:Name="StunIP1_1"
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="8,4"
                        Text="-" />
                    <TextBlock
                        x:Name="StunIP1_2"
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="8,4"
                        Text="-" />
                    <TextBlock
                        x:Name="StunIP1_3"
                        Grid.Row="2"
                        Grid.Column="3"
                        Margin="8,4"
                        Text="-" />

                    <!--  Row 3: Latency  -->
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="3"
                        Grid.Column="0"
                        Margin="0,4"
                        Text="Latency" />
                    <TextBlock
                        x:Name="StunLatency1_1"
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="8,4"
                        Text="-" />
                    <TextBlock
                        x:Name="StunLatency1_2"
                        Grid.Row="3"
                        Grid.Column="2"
                        Margin="8,4"
                        Text="-" />
                    <TextBlock
                        x:Name="StunLatency1_3"
                        Grid.Row="3"
                        Grid.Column="3"
                        Margin="8,4"
                        Text="-" />

                    <!--  Row 4: Mapping Consistent  -->
                    <TextBlock
                        x:Uid="ViewNatToolsPageTextBlock"
                        Grid.Row="4"
                        Grid.Column="0"
                        Margin="0,4"
                        Text="Mapping Consistent" />
                    <TextBlock
                        x:Name="StunMapping"
                        Grid.Row="4"
                        Grid.Column="1"
                        Grid.ColumnSpan="3"
                        Margin="8,4"
                        FontWeight="SemiBold"
                        Text="-" />
                </Grid>

                <!--  The mapping service owns a dedicated UDP port.  -->
                <TextBlock
                    x:Uid="NatTools_MappingHeader"
                    Margin="0,24,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="UDP NAT Mapping" />
                <TextBlock
                    x:Uid="NatTools_MappingDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Keep a separate public UDP mapping open and forward incoming packets to the local torrent listener. A mapped address alone does not prove reachability."
                    TextWrapping="Wrap" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <NumberBox
                        x:Uid="NatTools_MappingPort"
                        Width="175"
                        Header="Mapping port (0 = automatic)"
                        Maximum="65535"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.MappingPort, Mode=TwoWay}" />
                    <NumberBox
                        x:Uid="NatTools_TargetPort"
                        Width="175"
                        Header="Target port (0 = torrent)"
                        Maximum="65535"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.TargetPort, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Uid="NatTools_StunHost"
                        Width="220"
                        Header="STUN server"
                        Text="{x:Bind ViewModel.StunHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox
                        x:Uid="NatTools_StunPort"
                        Width="110"
                        Header="STUN port"
                        Maximum="65535"
                        Minimum="1"
                        Value="{x:Bind ViewModel.StunPort, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Uid="NatTools_StartMapping"
                        Command="{x:Bind ViewModel.StartCommand}"
                        Content="Start mapping" />
                    <Button
                        x:Uid="NatTools_StopMapping"
                        Command="{x:Bind ViewModel.StopCommand}"
                        Content="Stop mapping" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Text="{x:Bind ViewModel.Status, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="NatTools_ObservedEndpoint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Observed mapping toward STUN:" />
                <TextBlock Text="{x:Bind ViewModel.PublicEndpoint, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Uid="NatTools_AllowFirewall"
                        Command="{x:Bind ViewModel.AllowFirewallCommand}"
                        Content="Allow this UDP port in Windows Firewall" />
                    <Button
                        x:Uid="NatTools_RemoveFirewall"
                        Command="{x:Bind ViewModel.RemoveFirewallCommand}"
                        Content="Remove OpenNet firewall rule" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.FirewallStatus, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  TCP mapping is intentionally manual and never follows WebUI state.  -->
                <TextBlock
                    x:Uid="NatTools_TcpMappingHeader"
                    Margin="0,24,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="TCP / WebUI NAT Mapping" />
                <TextBlock
                    x:Uid="NatTools_TcpMappingDescription"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Keep HTTP and TCP STUN connections on one source port, listen on that shared port, and relay inbound TCP connections to a loopback target."
                    TextWrapping="Wrap" />
                <InfoBar
                    x:Uid="NatTools_TcpMappingWarning"
                    Margin="0,8,0,0"
                    IsClosable="False"
                    IsOpen="True"
                    Message="This mode cannot provide exclusive ownership of the shared port. Bind a specific interface and expose only an authenticated target. No firewall rule is added automatically, and a STUN observation does not prove reachability."
                    Severity="Warning"
                    Title="Public TCP exposure is opt-in" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Uid="NatTools_TcpLocalAddress"
                        Width="175"
                        Header="Local IPv4 address"
                        PlaceholderText="192.168.1.10"
                        Text="{x:Bind ViewModel.TcpLocalAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox
                        x:Uid="NatTools_TcpMappingPort"
                        Width="175"
                        Header="Mapping port (0 = automatic)"
                        Maximum="65535"
                        Minimum="0"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.TcpMappingPort, Mode=TwoWay}" />
                    <NumberBox
                        x:Uid="NatTools_TcpTargetPort"
                        Width="175"
                        Header="Loopback target port"
                        Maximum="65535"
                        Minimum="1"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.TcpTargetPort, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <TextBox
                        x:Uid="NatTools_TcpKeepaliveHost"
                        Width="220"
                        Header="HTTP keepalive host"
                        Text="{x:Bind ViewModel.TcpKeepaliveHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox
                        x:Uid="NatTools_TcpKeepalivePort"
                        Width="110"
                        Header="HTTP port"
                        Maximum="65535"
                        Minimum="1"
                        Value="{x:Bind ViewModel.TcpKeepalivePort, Mode=TwoWay}" />
                    <TextBox
                        x:Uid="NatTools_TcpStunHost"
                        Width="220"
                        Header="TCP STUN server"
                        Text="{x:Bind ViewModel.TcpStunHost, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <NumberBox
                        x:Uid="NatTools_TcpStunPort"
                        Width="110"
                        Header="TCP STUN port"
                        Maximum="65535"
                        Minimum="1"
                        Value="{x:Bind ViewModel.TcpStunPort, Mode=TwoWay}" />
                </StackPanel>
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Uid="NatTools_StartTcpMapping"
                        Command="{x:Bind ViewModel.StartTcpCommand}"
                        Content="Start TCP mapping" />
                    <Button
                        x:Uid="NatTools_StopTcpMapping"
                        Command="{x:Bind ViewModel.StopTcpCommand}"
                        Content="Stop TCP mapping" />
                    <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IsTcpBusy, Mode=OneWay}" />
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Text="{x:Bind ViewModel.TcpStatus, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock
                    x:Uid="NatTools_TcpObservedEndpoint"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Observed TCP mapping toward STUN:" />
                <TextBlock Text="{x:Bind ViewModel.TcpPublicEndpoint, Mode=OneWay}" TextWrapping="Wrap" />
                <StackPanel Margin="0,8,0,0" Orientation="Horizontal" Spacing="8">
                    <Button
                        x:Uid="NatTools_AllowTcpFirewall"
                        Command="{x:Bind ViewModel.AllowTcpFirewallCommand}"
                        Content="Allow this TCP port in Windows Firewall" />
                    <Button
                        x:Uid="NatTools_RemoveTcpFirewall"
                        Command="{x:Bind ViewModel.RemoveTcpFirewallCommand}"
                        Content="Remove OpenNet TCP firewall rule" />
                </StackPanel>
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.TcpFirewallStatus, Mode=OneWay}"
                    TextWrapping="Wrap" />

                <!--  Port Accessibility Test Section  -->
                <TextBlock
                    x:Uid="NatTools_PortTest"
                    Margin="0,24,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Port Accessibility Test" />

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <NumberBox
                        x:Name="PortNumberBox"
                        x:Uid="NatTools_PortNumberBox"
                        Width="150"
                        AutomationProperties.AutomationId="NatTools_PortNumberBox"
                        Maximum="65535"
                        Minimum="1"
                        PlaceholderText="Port"
                        SpinButtonPlacementMode="Inline"
                        Value="{x:Bind ViewModel.ProbePort, Mode=TwoWay}" />
                    <Button
                        x:Name="TestPortButton"
                        x:Uid="NatTools_TestPortButton"
                        AutomationProperties.AutomationId="NatTools_TestPortButton"
                        Click="TestPort_Click"
                        Content="Test Port" />
                </StackPanel>

                <ProgressRing
                    x:Name="PortTestProgress"
                    Width="24"
                    Height="24"
                    Margin="0,8"
                    IsActive="False"
                    Visibility="Collapsed" />

                <TextBlock x:Name="PortTestResultText" Margin="0,4,0,0">
                    <Run x:Uid="NatTools_PortResultLabel" Text="Result: " />
                    <Run
                        x:Name="PortResultText"
                        FontWeight="SemiBold"
                        Text="-" />
                </TextBlock>

                <TextBlock
                    x:Name="PortMappedText"
                    Margin="0,2,0,0"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text=""
                    TextWrapping="Wrap" />

                <!--  STUN Servers Section  -->
                <TextBlock
                    x:Uid="NatTools_STUNServers"
                    Margin="0,24,0,6"
                    Style="{StaticResource SettingsSectionHeaderTextBlockStyle}"
                    Text="Recommended STUN Servers" />

                <ListView
                    x:Name="StunServersList"
                    MaxHeight="200"
                    SelectionMode="None" />

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
