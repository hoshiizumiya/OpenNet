<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskHttpConnectionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:segment="using:OpenNet.UI.Xaml.Control.Progress.HttpSegment"
    xmlns:vm="using:OpenNet.ViewModels"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/AcrylicBrush_ResourceDictionary.xaml" />
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Progress/HttpSegment/HttpSegmentProgressBar_ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="0,8,0,0">
        <ListView
            x:Name="ConnectionsListView"
            Background="Transparent"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.Header>
                <Border
                    Padding="8,4,0,4"
                    Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                    CornerRadius="4">
                    <labs:DataTable ColumnSpacing="16">
                        <labs:DataColumn CanResize="True" DesiredWidth="700">
                            <TextBlock FontWeight="SemiBold" Text="URL" />
                        </labs:DataColumn>
                        <labs:DataColumn CanResize="True" DesiredWidth="150">
                            <TextBlock FontWeight="SemiBold" Text="Download rate" />
                        </labs:DataColumn>
                        <labs:DataColumn CanResize="True" DesiredWidth="150">
                            <TextBlock FontWeight="SemiBold" Text="Download size" />
                        </labs:DataColumn>
                        <labs:DataColumn CanResize="True" DesiredWidth="500">
                            <TextBlock FontWeight="SemiBold" Text="Progress" />
                        </labs:DataColumn>
                        <labs:DataColumn CanResize="True" DesiredWidth="140">
                            <TextBlock FontWeight="SemiBold" Text="Status" />
                        </labs:DataColumn>
                    </labs:DataTable>
                </Border>
            </ListView.Header>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:HttpConnectionDisplayItem">
                    <labs:DataRow HorizontalAlignment="Left">
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="{x:Bind URL, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DownloadRate, Mode=OneWay}" />
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind DownloadSize, Mode=OneWay}" />
                        <Grid MinWidth="180">
                            <segment:RangePieceBar
                                Height="12"
                                HorizontalAlignment="Stretch"
                                IsRangeMode="True"
                                RangeEnd="{x:Bind RangeEnd, Mode=OneWay}"
                                RangeStart="{x:Bind RangeStart, Mode=OneWay}"
                                Value="{x:Bind ProgressValue, Mode=OneWay}" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Text="{x:Bind Progress, Mode=OneWay}" />
                        </Grid>
                        <TextBlock VerticalAlignment="Center" Text="{x:Bind Status, Mode=OneWay}" />
                    </labs:DataRow>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock
            x:Name="EmptyStateText"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsHitTestVisible="False"
            Text="Waiting for HTTP connection information" />
    </Grid>
</Page>
