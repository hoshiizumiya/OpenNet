<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:local="using:OpenNet.UI.Xaml.View.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:muxm="using:Microsoft.UI.Xaml.Media"
    xmlns:ouxc="using:OpenNet.UI.Xaml.Control"
    xmlns:ouxm="using:OpenNet.UI.Xaml.Media"
    xmlns:speedgraph="using:OpenNet.Controls.SpeedGraph"
    xmlns:vm="using:OpenNet.ViewModels"
    xmlns:xtlw="using:XamlToolkit.Labs.WinUI"
    xmlns:xtwc="using:XamlToolkit.WinUI.Controls"
    xmlns:xtwm="using:XamlToolkit.WinUI.Media"
    x:Uid="TasksPageRoot"
    Loaded="Loaded"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/AcrylicBrush_ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  SearchBox + CommandBar  -->
        <CommandBar
            Grid.Row="0"
            Margin="4,2,4,0"
            essential:CommandBarHelper.AcrylicWorkaround="True"
            CornerRadius="4"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Name="TaskNewButton"
                x:Uid="TaskNewButton"
                AutomationProperties.AutomationId="TaskNewButton"
                Icon="{essential:FontIcon Glyph=&#xE710;}">
                <AppBarButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                        <MenuFlyoutItem
                            x:Name="MenuItemAddFromLink"
                            x:Uid="TaskNewFromUrlButton"
                            Click="MenuItemAddFromLink_ClickAsync"
                            Icon="{essential:FontIcon FontFamily=Segoe UI Emoji,
                                                      Glyph=&#x1F9F2;}"
                            Text="From Magnet Link">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="O"
                                    Invoked="TaskNewFromUrlKeyboardAccelerator_Invoked"
                                    Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem
                            x:Name="MenuItemAddFromFile"
                            x:Uid="TaskNewFromFileButton"
                            Click="MenuItemAddFromFile_ClickAsync"
                            Icon="{essential:FontIcon Glyph=&#xE8E5;}"
                            Text="From Bittorrent File">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="O"
                                    Invoked="TaskNewFromFileKeyboardAccelerator_Invoked"
                                    Modifiers="Control, Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Name="MenuItemAddFromHttp"
                            x:Uid="TaskNewFromHttpButton"
                            Click="MenuItemAddFromHttp_ClickAsync"
                            Icon="{essential:FontIcon Glyph=&#xE71B;}"
                            Text="HTTP Download">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="N"
                                    Invoked="TaskNewFromHttpKeyboardAccelerator_Invoked"
                                    Modifiers="Control, Shift" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem
                            x:Uid="TaskCreateTorrentButton"
                            Click="CreateTorrentMenuItem_Click"
                            Icon="{essential:FontIcon Glyph=&#xE8A5;}"
                            Text="Create torrent...">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator
                                    Key="N"
                                    Invoked="CreateTorrentKeyboardAccelerator_Invoked"
                                    Modifiers="Control" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
            <AppBarButton
                x:Uid="TaskStartButton"
                AutomationProperties.AutomationId="TaskStartButton"
                Command="{x:Bind ViewModel.StartCommand}"
                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                Icon="{essential:FontIcon Glyph=&#xE768;}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="S"
                        Invoked="TaskStartKeyboardAccelerator_Invoked"
                        Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Uid="TaskPauseButton"
                AutomationProperties.AutomationId="TaskPauseButton"
                Command="{x:Bind ViewModel.PauseCommand}"
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Icon="{essential:FontIcon Glyph=&#xE769;}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="P"
                        Invoked="TaskPauseKeyboardAccelerator_Invoked"
                        Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton
                x:Uid="TaskDeleteButton"
                AutomationProperties.AutomationId="TaskDeleteButton"
                Click="DeleteTaskButton_ClickAsync"
                Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                Icon="{essential:FontIcon Glyph=&#xE74D;}">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Key="Delete"
                        Invoked="TaskDeleteKeyboardAccelerator_Invoked"
                        Modifiers="None" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    x:Uid="ViewTasksPagePortTestAppBarButton"
                    AutomationProperties.AutomationId="ViewTasksPagePortTestAppBarButton"
                    Click="ViewTasksPagePortTestAppBarButton_Click"
                    Icon="{essential:FontIcon Glyph=&#xF196;}"
                    Label="Port Test">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="T"
                            Invoked="PortTestKeyboardAccelerator_Invoked"
                            Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
                <AppBarButton
                    x:Uid="ViewTasksPageSettingsAppBarButton"
                    AutomationProperties.AutomationId="ViewTasksPageSettingsAppBarButton"
                    Click="ViewTasksPageSettingsAppBarButton_Click"
                    Icon="{essential:FontIcon Glyph=&#xE713;}"
                    Label="Settings">
                    <AppBarButton.KeyboardAccelerators>
                        <KeyboardAccelerator
                            Key="I"
                            Invoked="SettingKeyboardAccelerator_Invoked"
                            Modifiers="Control" />
                    </AppBarButton.KeyboardAccelerators>
                </AppBarButton>
            </CommandBar.SecondaryCommands>

        </CommandBar>

        <AutoSuggestBox
            x:Name="SearchBox"
            x:Uid="ViewTasksPageAutoSuggestBox"
            Grid.Row="0"
            Width="280"
            Margin="12,6"
            HorizontalAlignment="Left"
            essential:AutoSuggestBoxHelper.AcrylicWorkaround="True"
            PlaceholderText="Search"
            QueryIcon="Find"
            TextChanged="SearchBox_TextChanged">
            <AutoSuggestBox.KeyboardAccelerators>
                <KeyboardAccelerator
                    Key="F"
                    Invoked="SearchKeyboardAccelerator_Invoked"
                    Modifiers="Control" />
            </AutoSuggestBox.KeyboardAccelerators>
        </AutoSuggestBox>

        <Grid
            Grid.Row="1"
            Margin="4"
            ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  左侧筛选导航 / Left-side filter navigation  -->
            <Border
                Grid.Column="0"
                Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                CornerRadius="8">
                <NavigationView
                    x:Name="FilterNavView"
                    essential:NavigationViewHelper.AcrylicWorkaround="True"
                    Background="Transparent"
                    CompactPaneLength="50"
                    IsBackButtonVisible="Collapsed"
                    IsPaneToggleButtonVisible="False"
                    IsSettingsVisible="False"
                    PaneDisplayMode="LeftCompact"
                    SelectionChanged="FilterNavView_SelectionChanged">
                    <NavigationView.MenuItems>
                        <NavigationViewItem
                            x:Uid="FilterNavViewAllTasks"
                            Icon="{essential:FontIcon Glyph=&#xE8A9;}"
                            IsSelected="True"
                            Tag="AllTasks" />
                        <NavigationViewItem
                            x:Uid="FilterNavViewDownloading"
                            Icon="{essential:FontIcon Glyph=&#xE896;}"
                            Tag="Downloading" />
                        <NavigationViewItem
                            x:Uid="FilterNavViewSeeding"
                            Icon="{essential:FontIcon Glyph=&#xE898;}"
                            Tag="Seeding" />
                        <NavigationViewItem
                            x:Uid="FilterNavViewCompleted"
                            Icon="{essential:FontIcon Glyph=&#xE73E;}"
                            Tag="Completed" />
                        <NavigationViewItem
                            x:Uid="FilterNavViewUncompleted"
                            Icon="{essential:FontIcon Glyph=&#xE823;}"
                            Tag="Uncompleted" />
                        <NavigationViewItem
                            x:Uid="FilterNavViewActive"
                            Icon="{essential:FontIcon Glyph=&#xE768;}"
                            Tag="Active" />
                        <NavigationViewItem
                            x:Uid="FilterNavViewInactive"
                            Icon="{essential:FontIcon Glyph=&#xE769;}"
                            Tag="Inactive" />
                    </NavigationView.MenuItems>
                </NavigationView>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TasksListRow" Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Tasks List  -->
                <ListView
                    x:Name="TasksList"
                    Grid.Row="0"
                    ContainerContentChanging="TasksList_ContainerContentChanging"
                    ItemsSource="{x:Bind ViewModel.FilteredTasks, Mode=OneWay}"
                    RightTapped="TasksList_RightTapped"
                    SelectionChanged="TasksList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemContainerTransitions>
                        <TransitionCollection>
                            <AddDeleteThemeTransition />
                            <RepositionThemeTransition />
                        </TransitionCollection>
                    </ListView.ItemContainerTransitions>
                    <ListView.ItemContainerStyle>
                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.Header>
                        <Border
                            Padding="8,4,0,4"
                            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
                            CornerRadius="4"
                            RightTapped="TasksColumnHeader_RightTapped">
                            <interactivity:Interaction.Behaviors>
                                <behaviors:StickyHeaderBehavior />
                            </interactivity:Interaction.Behaviors>
                            <xtlw:DataTable ColumnSpacing="16" Loaded="DataTable_Loaded">
                                <xtlw:DataColumn
                                    x:Name="ColName"
                                    CanResize="True"
                                    Tag="Name">
                                    <Button
                                        x:Name="SortTaskNameButton"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        VerticalContentAlignment="Center"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="Name">
                                        <TextBlock
                                            x:Uid="Header_TaskName"
                                            Padding="0"
                                            Text="Name"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColSize"
                                    CanResize="True"
                                    Tag="Size"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColSizeLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskSizeButton"
                                        Padding="0"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="Size">
                                        <TextBlock
                                            x:Uid="Header_Size"
                                            Text="Size"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColProgress"
                                    CanResize="True"
                                    Tag="Progress"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColProgressLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskProgressButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="Progress">
                                        <TextBlock
                                            x:Uid="Header_Progress"
                                            Text="Progress"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColDownloadSize"
                                    CanResize="True"
                                    Tag="DownloadSize"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColDownloadSizeLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskDownloadSizeButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="DownloadSize">
                                        <TextBlock
                                            x:Uid="Header_DownloadSize"
                                            Text="Download Size"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColUploadSize"
                                    CanResize="True"
                                    Tag="UploadSize"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColUploadSizeLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskUploadSizeButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="UploadSize">
                                        <TextBlock
                                            x:Uid="Header_UploadSize"
                                            Text="Upload Size"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColumnTotalDownloadSize"
                                    CanResize="True"
                                    Tag="TotalDownloadSize"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColumnTotalDownloadSizeLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskTotalDownloadButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="TotalDownloadSize">
                                        <TextBlock
                                            x:Uid="Header_TotalDownloadSize"
                                            Text="Total Download Size"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColumnTotalUploadSize"
                                    CanResize="True"
                                    Tag="TotalUploadSize"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColumnTotalUploadSizeLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskTotalUploadButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="TotalUploadSize">
                                        <TextBlock
                                            x:Uid="Header_TotalUploadSize"
                                            Text="Total Upload Size"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColDLRate"
                                    CanResize="True"
                                    Tag="DLRate"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColDLRateLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskDlRateButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="DLRate">
                                        <TextBlock
                                            x:Uid="Header_DLRate"
                                            Text="DL Rate"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColULRate"
                                    CanResize="True"
                                    Tag="ULRate"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColULRateLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskUlRateButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="ULRate">
                                        <TextBlock
                                            x:Uid="Header_ULRate"
                                            Text="UL Rate"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColRemaining"
                                    CanResize="True"
                                    Tag="Remaining"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColRemainingLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskRemainingButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="Remaining">
                                        <TextBlock
                                            x:Uid="Header_Remaining"
                                            Text="Remaining"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColAddDate"
                                    CanResize="True"
                                    Tag="AddDate"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColAddDateLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskAddDateButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="AddDate">
                                        <TextBlock
                                            x:Uid="Header_AddDate"
                                            Text="Add Date"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColCompletedDate"
                                    CanResize="True"
                                    Tag="CompletedDate"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColCompletedDateLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskCompletedDateButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="CompletedDate">
                                        <TextBlock
                                            x:Uid="ViewTasksPageCompletedDateTextBlock"
                                            Text="Completed Date"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColShareRatio"
                                    CanResize="True"
                                    Tag="ShareRatio"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColShareRatioLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskShareRatioButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="ShareRatio">
                                        <TextBlock
                                            x:Uid="ViewTasksPageShareRatioTextBlock"
                                            Text="Share Ratio"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                                <xtlw:DataColumn
                                    x:Name="ColSeeds"
                                    CanResize="True"
                                    Tag="Seeds"
                                    Visibility="{x:Bind essential:Convert.BoolToVisibility(ViewModel.IsColSeedsLoad), Mode=OneWay}">
                                    <Button
                                        x:Name="SortTaskSeedsButton"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch"
                                        HorizontalContentAlignment="Right"
                                        Click="TasksColumnHeader_Click"
                                        FontWeight="SemiBold"
                                        Style="{StaticResource DataTableColumnHeaderButtonStyle}"
                                        Tag="Seeds">
                                        <TextBlock
                                            x:Uid="ViewTasksPageSeedsPeersTextBlock"
                                            Text="Seeds/Peers[all]"
                                            TextTrimming="CharacterEllipsis" />
                                    </Button>
                                </xtlw:DataColumn>
                            </xtlw:DataTable>
                            <Border.ContextFlyout>
                                <MenuFlyout Closed="TasksColumnMenuFlyout_Closed" Opening="TasksColumnMenuFlyout_Opening">
                                    <MenuFlyoutItem
                                        x:Name="ViewPageTasksColumnAutoSizeSelectedWidth"
                                        x:Uid="ViewPageTasksColumnAutoSizeSelectedWidth"
                                        AutomationProperties.AutomationId="ViewPageTasksColumnAutoSizeSelectedWidth"
                                        Click="TasksColumnAutoSizeSelectedWidth_Click"
                                        Text="Auto Size Selected Column's Width to Fit" />
                                    <MenuFlyoutItem
                                        x:Name="ViewPageTasksColumnAutoSizeAllWidth"
                                        x:Uid="ViewPageTasksColumnAutoSizeAllWidth"
                                        AutomationProperties.AutomationId="ViewPageTasksColumnAutoSizeAllWidth"
                                        Click="TasksColumnAutoSizeAllWidth_Click"
                                        Text="Auto Size All Column's Width to Fit" />
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_TaskName"
                                        IsChecked="True"
                                        IsEnabled="False"
                                        Tag="Name"
                                        Text="Name" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_Size"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColSizeLoad, Mode=OneWay}"
                                        Tag="Size"
                                        Text="Size" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_Progress"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColProgressLoad, Mode=OneWay}"
                                        Tag="Progress"
                                        Text="Progress" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_DownloadSize"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColDownloadSizeLoad, Mode=OneWay}"
                                        Tag="DownloadSize"
                                        Text="Download Size" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_UploadSize"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColUploadSizeLoad, Mode=OneWay}"
                                        Tag="UploadSize"
                                        Text="Upload Size" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_TotalDownloadSize"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColumnTotalDownloadSizeLoad, Mode=OneWay}"
                                        Tag="TotalDownloadSize"
                                        Text="Total Download Size" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_TotalUploadSize"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColumnTotalUploadSizeLoad, Mode=OneWay}"
                                        Tag="TotalUploadSize"
                                        Text="Total Upload Size" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_DLRate"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColDLRateLoad, Mode=OneWay}"
                                        Tag="DLRate"
                                        Text="Download Rate" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_ULRate"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColULRateLoad, Mode=OneWay}"
                                        Tag="ULRate"
                                        Text="Upload Rate" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_Remaining"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColRemainingLoad, Mode=OneWay}"
                                        Tag="Remaining"
                                        Text="Remaining" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="Header_AddDate"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColAddDateLoad, Mode=OneWay}"
                                        Tag="AddDate"
                                        Text="Add Date" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="ViewTasksPageCompletedDateTextBlock"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColCompletedDateLoad, Mode=OneWay}"
                                        Tag="CompletedDate"
                                        Text="Completed Date" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="ViewTasksPageShareRatioTextBlock"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColShareRatioLoad, Mode=OneWay}"
                                        Tag="ShareRatio"
                                        Text="Share Ratio" />
                                    <ToggleMenuFlyoutItem
                                        x:Uid="ViewTasksPageToggleMenuItem"
                                        Click="TasksColumnVisibility_Click"
                                        IsChecked="{x:Bind ViewModel.IsColSeedsLoad, Mode=OneWay}"
                                        Tag="Seeds"
                                        Text="Seeds/Peers[all]" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem
                                        x:Uid="ViewPageTasksColumnDisplayItemsReset"
                                        AutomationProperties.AutomationId="ViewPageTasksColumnDisplayItemsReset"
                                        Click="TasksColumnDisplayItemsReset_Click"
                                        Text="Reset To Default Display Items" />

                                </MenuFlyout>
                            </Border.ContextFlyout>
                        </Border>
                    </ListView.Header>
                    <ListView.ContextFlyout>
                        <MenuFlyout Opening="TasksContextMenuFlyout_Opening">
                            <MenuFlyoutItem
                                x:Name="StartTaskMenuItem"
                                x:Uid="TasksContextStart"
                                AutomationProperties.AutomationId="TasksContextStart"
                                Click="StartTaskMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE768;}"
                                Text="Start" />
                            <MenuFlyoutItem
                                x:Name="StopTaskMenuItem"
                                x:Uid="TasksContextStop"
                                AutomationProperties.AutomationId="TasksContextStop"
                                Click="StopTaskMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE769;}"
                                Text="Stop" />
                            <MenuFlyoutItem
                                x:Name="PreviewTaskMenuItem"
                                x:Uid="TasksContextPreview"
                                AutomationProperties.AutomationId="TasksContextPreview"
                                Click="PreviewTaskMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE8B1;}"
                                Text="Preview" />
                            <MenuFlyoutItem
                                x:Name="UpdateTrackerMenuItem"
                                x:Uid="TasksContextUpdateTracker"
                                AutomationProperties.AutomationId="TasksContextUpdateTracker"
                                Click="UpdateTrackerMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE895;}"
                                Text="Update Tracker" />
                            <ToggleMenuFlyoutItem
                                x:Name="SuperSeedModeMenuItem"
                                x:Uid="TasksContextSuperSeed"
                                Click="SuperSeedModeMenuItem_Click"
                                Text="Super Seed Mode" />
                            <ToggleMenuFlyoutItem
                                x:Name="SequentialDownloadMenuItem"
                                x:Uid="TasksContextSequential"
                                Click="SequentialDownloadMenuItem_Click"
                                Text="Sequential Download Mode" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="OpenTaskFileMenuItem"
                                x:Uid="TasksContextOpenFile"
                                AutomationProperties.AutomationId="TasksContextOpenFile"
                                Click="OpenTaskFileMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE7C3;}"
                                Text="Open File" />
                            <MenuFlyoutItem
                                x:Name="OpenTaskLocationMenuItem"
                                x:Uid="OpenTaskLocationMenuItem"
                                AutomationProperties.AutomationId="OpenTaskLocationMenuItem"
                                Click="OpenTaskLocationMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE8E5;}"
                                Text="Open Directory" />
                            <MenuFlyoutItem
                                x:Name="ManualHashCheckMenuItem"
                                x:Uid="TasksContextHashCheck"
                                AutomationProperties.AutomationId="TasksContextHashCheck"
                                Click="ManualHashCheckMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE9D5;}"
                                Text="Manual Hash Check" />
                            <MenuFlyoutItem
                                x:Name="SaveTorrentAsMenuItem"
                                x:Uid="TasksContextSaveTorrent"
                                AutomationProperties.AutomationId="TasksContextSaveTorrent"
                                Click="SaveTorrentAsMenuItem_ClickAsync"
                                Icon="{essential:FontIcon Glyph=&#xE74E;}"
                                Text="Save Torrent as..." />
                            <MenuFlyoutItem
                                x:Uid="TasksContextSubmitSnapshots"
                                AutomationProperties.AutomationId="TasksContextSubmitSnapshots"
                                IsEnabled="False"
                                Text="Submit Snapshots" />
                            <MenuFlyoutItem
                                x:Name="DeleteTaskMenuItem"
                                x:Uid="TasksContextDelete"
                                AutomationProperties.AutomationId="TasksContextDelete"
                                Click="DeleteTaskMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE74D;}"
                                Text="Delete" />
                            <MenuFlyoutItem
                                x:Uid="TasksContextCleanUp"
                                AutomationProperties.AutomationId="TasksContextCleanUp"
                                IsEnabled="False"
                                Text="Clean Up" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem
                                x:Name="MoveTaskMenuItem"
                                x:Uid="TasksContextMoveFiles"
                                AutomationProperties.AutomationId="TasksContextMoveFiles"
                                Icon="{essential:FontIcon Glyph=&#xE8DE;}"
                                Text="Files Move To">
                                <MenuFlyoutItem
                                    x:Uid="TasksContextChooseFolder"
                                    AutomationProperties.AutomationId="TasksContextChooseFolder"
                                    Click="MoveTaskMenuItem_Click"
                                    Text="Choose folder..." />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem
                                x:Name="TagsMenuItem"
                                x:Uid="TasksContextTags"
                                AutomationProperties.AutomationId="TasksContextTags"
                                Text="Tags">
                                <MenuFlyoutItem
                                    x:Uid="TasksContextNoTags"
                                    AutomationProperties.AutomationId="TasksContextNoTags"
                                    IsEnabled="False"
                                    Text="No tags configured" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                x:Name="RenameTaskMenuItem"
                                x:Uid="RenameTaskMenuItem"
                                AutomationProperties.AutomationId="RenameTaskMenuItem"
                                Click="RenameTaskMenuItem_ClickAsync"
                                Icon="{essential:FontIcon Glyph=&#xE8AC;}"
                                Text="Rename..." />
                            <MenuFlyoutSubItem
                                x:Name="SendToMenuItem"
                                x:Uid="TasksContextSendTo"
                                AutomationProperties.AutomationId="TasksContextSendTo"
                                Text="Send to">
                                <MenuFlyoutItem
                                    x:Name="SendToDefaultApplicationMenuItem"
                                    x:Uid="TasksContextDefaultApplication"
                                    AutomationProperties.AutomationId="TasksContextDefaultApplication"
                                    Click="OpenTaskFileMenuItem_Click"
                                    Text="Default application" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Name="SearchOnlineMenuItem"
                                x:Uid="TasksContextSearchOnline"
                                AutomationProperties.AutomationId="TasksContextSearchOnline"
                                Click="SearchOnlineMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE721;}"
                                Text="Search Online" />
                            <MenuFlyoutItem
                                x:Name="CopyMagnetUriMenuItem"
                                x:Uid="TasksContextCopyMagnet"
                                AutomationProperties.AutomationId="TasksContextCopyMagnet"
                                Click="CopyMagnetUriMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE8C8;}"
                                Text="Copy Magnet URI  (Ctrl+C)">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="C" Modifiers="Control" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSubItem
                                x:Name="CopyTaskMenuItem"
                                x:Uid="TasksContextCopy"
                                AutomationProperties.AutomationId="TasksContextCopy"
                                Text="Copy">
                                <MenuFlyoutItem
                                    x:Uid="TasksContextCopyName"
                                    AutomationProperties.AutomationId="TasksContextCopyName"
                                    Click="CopyTaskNameMenuItem_Click"
                                    Text="Name" />
                                <MenuFlyoutItem
                                    x:Name="CopyTaskHashMenuItem"
                                    x:Uid="TasksContextCopyHash"
                                    AutomationProperties.AutomationId="TasksContextCopyHash"
                                    Click="CopyTaskHashMenuItem_Click"
                                    Text="Info hash" />
                                <MenuFlyoutItem
                                    x:Uid="TasksContextCopyPath"
                                    AutomationProperties.AutomationId="TasksContextCopyPath"
                                    Click="CopyTaskPathMenuItem_Click"
                                    Text="Save path" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutItem
                                x:Name="DiskUsageInfoMenuItem"
                                x:Uid="TasksContextDiskUsage"
                                AutomationProperties.AutomationId="TasksContextDiskUsage"
                                Click="DiskUsageInfoMenuItem_ClickAsync"
                                Icon="{essential:FontIcon Glyph=&#xEDA2;}"
                                Text="Disk Usage Info..." />
                            <MenuFlyoutItem
                                x:Name="PropertiesMenuItem"
                                x:Uid="PropertiesMenuItem"
                                AutomationProperties.AutomationId="PropertiesMenuItem"
                                Click="PropertiesMenuItem_Click"
                                Icon="{essential:FontIcon Glyph=&#xE712;}"
                                Text="Properties" />
                        </MenuFlyout>
                    </ListView.ContextFlyout>
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TaskViewModel">
                            <!--  We set HorizontalAlignment to Left here as we're not stretching our content with a star column  -->
                            <xtlw:DataRow HorizontalAlignment="Left" Loaded="TaskDataRow_Loaded">
                                <xtlw:DataRow.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </xtlw:DataRow.Resources>
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ouxc:TaskStatusIndicator Grid.Column="0" State="{x:Bind StateValue, Mode=OneWay}" />
                                    <TextBlock
                                        x:Name="NameTextBlock"
                                        Grid.Column="1"
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Left"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </Grid>
                                <TextBlock
                                    x:Name="SizeTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind Size, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColSize.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="ProgressTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind Progress, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColProgress.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="DownloadSizeTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind DownloadSize, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColDownloadSize.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="UploadSizeTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind UploadSize, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColUploadSize.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="TotalDownloadSizeTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind TotalDownloadSize, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColumnTotalDownloadSize.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="TotalUploadSizeTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind TotalUploadSize, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColumnTotalUploadSize.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="DLRateTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind DownloadRate, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColDLRate.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="ULRateTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind UploadRate, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColULRate.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="RemainingTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind Remaining, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColRemaining.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    x:Name="AddDateTextBlock"
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind AddDate, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColAddDate.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind CompletedDate, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColCompletedDate.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind ShareRatio, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColShareRatio.Visibility, Mode=OneWay}" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    Text="{x:Bind Seeds, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="NoWrap"
                                    Visibility="{x:Bind ColSeeds.Visibility, Mode=OneWay}">
                                    <ToolTipService.ToolTip>
                                        <ToolTip
                                            x:Uid="ViewTasksPagePeersToolTip"
                                            essential:ToolTipHelper.AcrylicWorkaround="True"
                                            Content="Connected seeds / connected peers [all known seeds / all known peers]" />
                                    </ToolTipService.ToolTip>
                                </TextBlock>
                            </xtlw:DataRow>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  下方多标签 + SpeedGraph  -->
                <Grid Grid.Row="1" RowDefinitions="Auto,*">
                    <TabView
                        x:Name="Task_TabView"
                        Grid.Row="0"
                        CanDragTabs="True"
                        CanReorderTabs="True"
                        IsAddTabButtonVisible="False"
                        SelectionChanged="Task_TabView_SelectionChanged"
                        TabWidthMode="{x:Bind TaskTabViewTabWidthMode, Mode=TwoWay}">
                        <TabView.TabItems>
                            <TabViewItem
                                x:Name="SummaryContent"
                                x:Uid="Task_SummaryContent"
                                Header="Summary"
                                IsClosable="False"
                                Tag="{essential:TypeName Type=local:TaskSummaryPage}" />
                            <TabViewItem
                                x:Name="SpeedGraphContent"
                                x:Uid="ViewTasksPageNavigationViewItemSpeedGraph"
                                Header="Speed Graph"
                                IsClosable="False"
                                Tag="{essential:TypeName Type=local:TaskSpeedGraphPage}" />
                            <TabViewItem
                                x:Name="PieceMapContent"
                                x:Uid="ViewTasksPageNavigationViewItemPieceMap"
                                Header="Piece Map"
                                IsClosable="False"
                                Tag="{essential:TypeName Type=local:TaskPieceMapPage}" />
                            <TabViewItem
                                x:Name="PeersList"
                                x:Uid="Task_PeersList"
                                Header="Peers List"
                                IsClosable="False"
                                Tag="{essential:TypeName Type=local:TaskPeersListPage}" />
                            <TabViewItem
                                x:Name="TrackersList"
                                x:Uid="Task_TrackersList"
                                Header="Trackers List"
                                IsClosable="False"
                                Tag="{essential:TypeName Type=local:TaskTrackersPage}" />
                            <TabViewItem
                                x:Name="FilesList"
                                x:Uid="Task_FilesList"
                                Header="Files List"
                                IsClosable="False"
                                Tag="{essential:TypeName Type=local:TaskFilesPage}" />
                        </TabView.TabItems>
                        <TabView.ContextFlyout>
                            <MenuFlyout Opening="TaskTabViewContextFlyout_Opening">
                                <MenuFlyoutSubItem x:Uid="ViewTasksPageTabViewMenuFlyoutSubItemTabWidthMode" Text="TabView TabWidthMode">
                                    <RadioMenuFlyoutItem
                                        x:Name="ViewTasksPageTabViewRadioMenuFlyoutItemTabWidthModeEqual"
                                        x:Uid="ViewTasksPageTabViewToggleMenuFlyoutItemTabWidthModeEqual"
                                        Click="TabViewContextFlyoutRadioMenuFlyoutItem_Click"
                                        GroupName="TabWidthMode"
                                        Text="Equal">
                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                x:Uid="ViewTasksPageTabViewToggleMenuFlyoutItemTabWidthModeEqualToolTip"
                                                essential:ToolTipHelper.AcrylicWorkaround="True"
                                                Content="Each tab has the same width" />
                                        </ToolTipService.ToolTip>
                                    </RadioMenuFlyoutItem>

                                    <RadioMenuFlyoutItem
                                        x:Name="ViewTasksPageTabViewRadioMenuFlyoutItemTabWidthModeSizeToContent"
                                        x:Uid="ViewTasksPageTabViewToggleMenuFlyoutItemTabWidthModeSizeToContent"
                                        Click="TabViewContextFlyoutRadioMenuFlyoutItem_Click"
                                        GroupName="TabWidthMode"
                                        Text="Size To Content">
                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                x:Uid="ViewTasksPageTabViewToggleMenuFlyoutItemTabWidthModeSizeToContentToolTip"
                                                essential:ToolTipHelper.AcrylicWorkaround="True"
                                                Content="Each tab adjusts its width to the content within the tab" />
                                        </ToolTipService.ToolTip>
                                    </RadioMenuFlyoutItem>

                                    <RadioMenuFlyoutItem
                                        x:Name="ViewTasksPageTabViewRadioMenuFlyoutItemTabWidthModeCompact"
                                        x:Uid="ViewTasksPageTabViewToggleMenuFlyoutItemTabWidthModeCompact"
                                        Click="TabViewContextFlyoutRadioMenuFlyoutItem_Click"
                                        GroupName="TabWidthMode"
                                        Text="Compact">
                                        <ToolTipService.ToolTip>
                                            <ToolTip
                                                x:Uid="ViewTasksPageTabViewToggleMenuFlyoutItemTabWidthModeCompactToolTip"
                                                essential:ToolTipHelper.AcrylicWorkaround="True"
                                                Content="Unselected tabs collapse to show only their icon. The selected tab adjusts to display the content within the tab" />
                                        </ToolTipService.ToolTip>
                                    </RadioMenuFlyoutItem>
                                </MenuFlyoutSubItem>
                            </MenuFlyout>
                        </TabView.ContextFlyout>
                    </TabView>
                    <Frame
                        x:Name="ContentFrame"
                        Grid.Row="1"
                        essential:UIElementExtension.ClipToBounds="True"
                        IsNavigationStackEnabled="False" />

                </Grid>
                <!--  上下可调分隔条（XamlToolkit GridSplitter）  -->
                <xtwc:GridSplitter
                    Grid.Row="1"
                    Height="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    PointerReleased="GridSplitter_PointerReleased"
                    ResizeBehavior="BasedOnAlignment"
                    ResizeDirection="Rows">
                    <xtwc:GridSplitter.RenderTransform>
                        <TranslateTransform Y="-7" />
                    </xtwc:GridSplitter.RenderTransform>
                </xtwc:GridSplitter>

            </Grid>
        </Grid>
    </Grid>
</Page>
