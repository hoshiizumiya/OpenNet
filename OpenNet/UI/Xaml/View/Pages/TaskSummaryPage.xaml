<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="OpenNet.UI.Xaml.View.Pages.TaskSummaryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:piece="using:OpenNet.UI.Xaml.Control.Progress.HttpSegment"
    xmlns:speedgraph="using:OpenNet.Controls.SpeedGraph"
    NavigationCacheMode="Disabled"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Progress/HttpSegment/HttpSegmentProgressBar_ResourceDictionary.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SectionCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="14,10" />
            </Style>
            <Style x:Key="MetricCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer HorizontalScrollMode="Disabled">
        <StackPanel Padding="12" Spacing="10">
            <Border Style="{StaticResource SectionCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                x:Name="TaskNameText"
                                x:Uid="ViewTaskSummaryPageText1"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="No task selected"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="TaskPathText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Text="—"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="10,4"
                            Background="{ThemeResource AccentFillColorSecondaryBrush}"
                            CornerRadius="12">
                            <TextBlock
                                x:Name="TaskStatusText"
                                x:Uid="ViewTaskSummaryPageText3"
                                FontWeight="SemiBold"
                                Text="Idle" />
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Name="TaskProgress"
                            Height="4"
                            VerticalAlignment="Center"
                            Maximum="100" />
                        <TextBlock
                            x:Name="TaskProgressText"
                            x:Uid="ViewTaskSummaryPageText4"
                            Grid.Column="1"
                            FontWeight="SemiBold"
                            Text="0%" />
                    </Grid>
                    <StackPanel Grid.Row="2" Spacing="6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText5"
                                VerticalAlignment="Center"
                                Text="Downloaded pieces" />
                            <piece:RangePieceBar
                                x:Name="DownloadedPiecesProgress"
                                Grid.Column="1"
                                MinHeight="8"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="DownloadedPiecesText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="0 / 0" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText6"
                                VerticalAlignment="Center"
                                Text="Available pieces" />
                            <piece:RangePieceBar
                                x:Name="AvailablePiecesProgress"
                                Grid.Column="1"
                                MinHeight="8"
                                VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="AvailablePiecesText"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="0 / 0" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Height="132" Style="{StaticResource SectionCardStyle}">
                <Grid RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Uid="ViewTaskSummaryPageText7"
                        FontWeight="SemiBold"
                        Text="Download progress and speed" />
                    <speedgraph:SpeedGraph
                        x:Name="TaskSpeedGraph"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch" />
                </Grid>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="ViewTaskSummaryPageText8"
                        FontWeight="SemiBold"
                        Text="Transfer" />
                    <Grid ColumnSpacing="18" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText9"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Time elapsed" />
                            <TextBlock
                                x:Name="TimeElapsedText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                x:Uid="CommonTextDownloaded"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Downloaded" />
                            <TextBlock
                                x:Name="DownloadedText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText13"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Download speed" />
                            <TextBlock
                                x:Name="DownloadSpeedText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText15"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Download limit" />
                            <TextBlock
                                x:Name="DownloadLimitText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="1">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText17"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Seeding time" />
                            <TextBlock
                                x:Name="SeedingTimeText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText19"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Uploaded" />
                            <TextBlock
                                x:Name="UploadedText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText21"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Upload speed" />
                            <TextBlock
                                x:Name="UploadSpeedText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="3">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText23"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Upload limit" />
                            <TextBlock
                                x:Name="UploadLimitText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText25"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Seeds" />
                            <TextBlock
                                x:Name="SeedsText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText27"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Peers" />
                            <TextBlock
                                x:Name="PeersText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText29"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Connections" />
                            <TextBlock
                                x:Name="ConnectionsText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText31"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Share ratio" />
                            <TextBlock
                                x:Name="ShareRatioText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="ViewTaskSummaryPageText33"
                        FontWeight="SemiBold"
                        Text="Long-Term Seeding" />
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText34"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Upload size" />
                            <TextBlock
                                x:Name="LongTermUploadSizeText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText21"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Upload speed" />
                            <TextBlock
                                x:Name="LongTermUploadSpeedText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock
                                x:Uid="ViewTaskSummaryPageText31"
                                Style="{StaticResource MetricCaptionStyle}"
                                Text="Share ratio" />
                            <TextBlock
                                x:Name="LongTermShareRatioText"
                                x:Uid="ViewTaskSummaryPageText2"
                                Style="{StaticResource MetricValueStyle}"
                                Text="—" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}">
                <StackPanel Spacing="8">
                    <TextBlock
                        x:Uid="ViewTaskSummaryPageText40"
                        FontWeight="SemiBold"
                        Text="General" />
                    <Grid ColumnSpacing="24" RowSpacing="7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="7">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText41" Text="Task name" />
                                <TextBlock
                                    x:Name="GeneralTaskNameText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText43" Text="Save path" />
                                <TextBlock
                                    x:Name="SavePathText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Text="—"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText45" Text="Task size" />
                                <TextBlock
                                    x:Name="TaskSizeText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText47" Text="Info hash v1" />
                                <TextBlock
                                    x:Name="InfoHashV1Text"
                                    x:Uid="ViewTaskSummaryPageText48"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Text="N/A"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText49" Text="Info hash v2" />
                                <TextBlock
                                    x:Name="InfoHashV2Text"
                                    x:Uid="ViewTaskSummaryPageText48"
                                    Grid.Column="1"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Text="N/A"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText51" Text="Piece hashes" />
                                <TextBlock
                                    x:Name="PieceHashesText"
                                    x:Uid="ViewTaskSummaryPageText48"
                                    Grid.Column="1"
                                    Text="N/A" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText53" Text="Added on" />
                                <TextBlock
                                    x:Name="AddedOnText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText55" Text="Finished on" />
                                <TextBlock
                                    x:Name="FinishedOnText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText57" Text="Publisher" />
                                <TextBlock
                                    x:Name="PublisherText"
                                    x:Uid="ViewTaskSummaryPageText48"
                                    Grid.Column="1"
                                    Text="N/A"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="7">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText59" Text="Tags" />
                                <TextBlock
                                    x:Name="TagsText"
                                    x:Uid="ViewTaskSummaryPageText60"
                                    Grid.Column="1"
                                    Text="None"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText61" Text="Remaining size" />
                                <TextBlock
                                    x:Name="RemainingSizeText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText63" Text="Pieces" />
                                <TextBlock
                                    x:Name="PiecesText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText65" Text="Number of files" />
                                <TextBlock
                                    x:Name="NumberOfFilesText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText67" Text="File alignment" />
                                <TextBlock
                                    x:Name="FileAlignmentText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText69" Text="Queue position" />
                                <TextBlock
                                    x:Name="QueuePositionText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText71" Text="Created by" />
                                <TextBlock
                                    x:Name="CreatedByText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText73" Text="Created on" />
                                <TextBlock
                                    x:Name="CreatedOnText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText75" Text="Private torrent" />
                                <TextBlock
                                    x:Name="PrivateTorrentText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—" />
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Uid="ViewTaskSummaryPageText77" Text="Flags" />
                                <TextBlock
                                    x:Name="TaskFlagsText"
                                    x:Uid="ViewTaskSummaryPageText2"
                                    Grid.Column="1"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Uid="ViewTaskSummaryPageText79" Text="Description" />
                        <TextBlock
                            x:Name="DescriptionText"
                            x:Uid="ViewTaskSummaryPageText2"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="—"
                            TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
