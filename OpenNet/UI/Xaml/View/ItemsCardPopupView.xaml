<UserControl
    x:Class="OpenNet.UI.Xaml.View.ItemsCardPopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!--  左侧操作区域  -->
        <StackPanel
            Grid.Column="0"
            Padding="0,2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">

            <AppBarButton
                x:Uid="ViewUserViewUserCookieOperation"
                Width="100"
                MaxWidth="100"
                Margin="2,-4">

                <AppBarButton.Icon>
                    <ImageIcon Source="/Assets/miyoushe128.png" />
                </AppBarButton.Icon>

                <AppBarButton.Flyout>
                    <Flyout essential:FlyoutHelper.AcrylicWorkaround="True" Placement="RightEdgeAlignedBottom">

                        <StackPanel Orientation="Horizontal" Spacing="0">

                            <AppBarButton
                                x:Uid="ViewUserViewUserCookieOperationManualInputAction"
                                Width="100"
                                MaxWidth="100"
                                Margin="0,-4"
                                Command="{Binding AddUserCommand}"
                                Icon="Add" />

                            <Border Width="200" />

                        </StackPanel>

                    </Flyout>
                </AppBarButton.Flyout>

            </AppBarButton>

            <Border Height="200" />

        </StackPanel>

        <!--  右侧内容区域  -->
        <Grid Grid.Column="1" Width="280">

            <StackPanel>

                <TextBlock
                    x:Uid="ViewUserViewUserRole"
                    Margin="10,6,0,6"
                    FontSize="14"
                    FontWeight="SemiBold" />

                <ListView
                    Margin="4"
                    AllowDrop="True"
                    CanDragItems="True"
                    CanReorderItems="True"
                    SelectionMode="Single">

                    <ListViewItem Content="Item 1" />
                    <ListViewItem Content="Item 2" />
                    <ListViewItem Content="Item 3" />
                    <ListViewItem Content="Item 4" />

                </ListView>

            </StackPanel>

        </Grid>

    </Grid>

</UserControl>