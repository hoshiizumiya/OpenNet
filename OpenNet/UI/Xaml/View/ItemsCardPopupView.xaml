<UserControl
    x:Class="OpenNet.UI.Xaml.View.ItemsCardPopupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Loaded="OnLoaded"
    mc:Ignorable="d">

    <Grid MinHeight="300">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!--  Original left quick-action rail  -->
        <StackPanel
            Grid.Column="0"
            Padding="0,2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
            <AppBarButton
                x:Uid="MoreOpenWebUIQuickAction"
                Width="100"
                MaxWidth="100"
                AutomationProperties.AutomationId="MoreOpenWebUIQuickAction"
                Click="OnOpenWebUIClick"
                Icon="{essential:FontIcon Glyph=&#xE774;}"
                Label="Web UI" />
            <AppBarButton
                x:Uid="MoreRuntimeStatusQuickAction"
                Width="100"
                MaxWidth="100"
                AutomationProperties.AutomationId="MoreRuntimeStatusQuickAction"
                Click="OnRuntimeStatusClick"
                Icon="{essential:FontIcon Glyph=&#xE9D9;}"
                Label="Status" />
            <AppBarButton
                x:Uid="MoreNatDetectionQuickAction"
                Width="100"
                MaxWidth="100"
                AutomationProperties.AutomationId="MoreNatDetectionQuickAction"
                Click="OnNatDetectionClick"
                Icon="{essential:FontIcon Glyph=&#xE968;}"
                Label="NAT" />
            <AppBarButton
                x:Uid="MoreGuideQuickAction"
                Width="100"
                MaxWidth="100"
                AutomationProperties.AutomationId="MoreGuideQuickAction"
                Click="OnGuideClick"
                Icon="{essential:FontIcon Glyph=&#xE897;}"
                Label="Guide" />
        </StackPanel>

        <!--  Original right item-card area  -->
        <StackPanel
            Grid.Column="1"
            Padding="12,8,12,12"
            Spacing="8">
            <TextBlock
                x:Uid="MoreToolsHeader"
                Margin="2,0,0,2"
                FontSize="14"
                FontWeight="SemiBold"
                Text="OpenNet tools" />

            <Button
                x:Uid="MoreRuntimeStatusItem"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="MoreRuntimeStatusItem"
                Click="OnRuntimeStatusClick">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE9D9;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            x:Uid="MoreRuntimeStatusTitle"
                            FontWeight="SemiBold"
                            Text="Complete runtime status" />
                        <TextBlock
                            x:Uid="MoreRuntimeStatusDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Engine, network, transfer, CPU, memory, disk and queues"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                </Grid>
            </Button>

            <Button
                x:Uid="MoreNatDetectionItem"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="MoreNatDetectionItem"
                Click="OnNatDetectionClick">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE968;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            x:Uid="MoreNatDetectionTitle"
                            FontWeight="SemiBold"
                            Text="NAT and port detection" />
                        <TextBlock
                            x:Uid="MoreNatDetectionDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="STUN observations and libtorrent port mapping"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                </Grid>
            </Button>

            <Button
                x:Uid="MoreGuideItem"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="MoreGuideItem"
                Click="OnGuideClick">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE897;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            x:Uid="MoreGuideTitle"
                            FontWeight="SemiBold"
                            Text="Setup guide" />
                        <TextBlock
                            x:Uid="MoreGuideDescription"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Reopen Web UI credentials and GUI setup"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" />
                </Grid>
            </Button>

            <Border
                Padding="10"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                CornerRadius="6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock
                            x:Name="WebUIStatusText"
                            x:Uid="MoreWebUIStatus"
                            FontWeight="SemiBold"
                            Text="Checking Web UI…" />
                        <TextBlock
                            x:Name="WebUIUrlText"
                            x:Uid="MoreWebUIUrl"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            x:Uid="MoreCopyWebUIAddress"
                            AutomationProperties.AutomationId="MoreCopyWebUIAddress"
                            Click="OnCopyUrlClick"
                            Content="Copy" />
                        <Button
                            x:Uid="MoreOpenWebUIButton"
                            Margin="6,0,0,0"
                            AutomationProperties.AutomationId="MoreOpenWebUIButton"
                            Click="OnOpenWebUIClick"
                            Content="Open"
                            Style="{StaticResource AccentButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
