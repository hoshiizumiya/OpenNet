<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="OpenNet.UI.Xaml.View.Windows.RSSBrowserWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass"
    Width="1200"
    Height="760"
    MinWidth="640"
    MinHeight="420"
    mc:Ignorable="d">

    <essential:WindowEx.ContextMenu>
        <essential:ModernStandardWindowContextMenu />
    </essential:WindowEx.ContextMenu>

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <ResourceDictionary>
                <essential:ModernWindowCaptionButtonToolTip x:Name="CaptionButtonToolTip" Window="{x:Bind Window}" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="WindowTitleBar"
            Title="OpenNet Browser"
            Subtitle="RSS" />

        <Grid
            Grid.Row="1"
            Padding="12,8"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="BackButton"
                Click="BackButton_Click"
                IsEnabled="False"
                Style="{StaticResource SubtleButtonStyle}">
                <ToolTipService.ToolTip>
                    <ToolTip
                        x:Uid="CommonContentBack"
                        essential:ToolTipHelper.AcrylicWorkaround="True"
                        Content="Back" />
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE72B;" />
            </Button>
            <Button
                x:Name="ForwardButton"
                Click="ForwardButton_Click"
                IsEnabled="False"
                Style="{StaticResource SubtleButtonStyle}"
                Grid.Column="1">
                <ToolTipService.ToolTip>
                    <ToolTip
                        x:Uid="CommonContentForward"
                        essential:ToolTipHelper.AcrylicWorkaround="True"
                        Content="Forward" />
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE72A;" />
            </Button>
            <Button Click="ReloadButton_Click" Style="{StaticResource SubtleButtonStyle}"
                x:Name="GlassPresenter_2643"
                Grid.Column="2">
                <ToolTipService.ToolTip>
                    <ToolTip
                        x:Uid="CommonContentReload"
                        essential:ToolTipHelper.AcrylicWorkaround="True"
                        Content="Reload" />
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE72C;" />
            </Button>
            <TextBox
                KeyDown="AddressBox_KeyDown"
                PlaceholderText="Enter a web address" x:Name="AddressBox"
                ouxct:ControlAppearance.IsEnabled="True"
                VerticalAlignment="Center"
                Grid.Column="3" />
            <Button Click="GoButton_Click" Style="{StaticResource SubtleButtonStyle}"
                x:Name="GlassPresenter_3381"
                Grid.Column="4">
                <ToolTipService.ToolTip>
                    <ToolTip
                        x:Uid="CommonContentGo"
                        essential:ToolTipHelper.AcrylicWorkaround="True"
                        Content="Go" />
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE751;" />
            </Button>
            <Button Click="OpenExternalButton_Click" Style="{StaticResource SubtleButtonStyle}"
                x:Name="GlassPresenter_3873"
                Grid.Column="5">
                <ToolTipService.ToolTip>
                    <ToolTip
                        x:Uid="CommonContentOpenSysBrowser"
                        essential:ToolTipHelper.AcrylicWorkaround="True"
                        Content="Open in system browser" />
                </ToolTipService.ToolTip>
                <FontIcon Glyph="&#xE774;" />
            </Button>
        </Grid>

        <!--
            WebView2 needs a non-zero realized layout slot before its controller is
            created.  TabView does not always propagate the WindowEx star-row height
            to dynamically-created content during the first measure pass, so keep an
            explicit host and synchronize the effective viewport from SizeChanged.
        -->
        <Grid
            x:Name="BrowserHost"
            Grid.Row="2"
            Loaded="BrowserHost_Loaded"
            SizeChanged="BrowserHost_SizeChanged">
            <TabView
                x:Name="BrowserTabView"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                AddTabButtonClick="BrowserTabView_AddTabButtonClick"
                SelectionChanged="BrowserTabView_SelectionChanged"
                TabCloseRequested="BrowserTabView_TabCloseRequested"
                TabWidthMode="SizeToContent" />
        </Grid>
    </Grid>
</essential:WindowEx>
