<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="OpenNet.UI.Xaml.View.Windows.DevWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="DevWindow"
    MinWidth="480"
    MinHeight="360"
    IsAlwaysOnTop="True"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <essential:MicaBackdropWithFallback>
            <essential:MicaBackdropWithFallback.Fallback>
                <DesktopAcrylicBackdrop />
            </essential:MicaBackdropWithFallback.Fallback>
        </essential:MicaBackdropWithFallback>
    </Window.SystemBackdrop>

    <essential:WindowEx.ContextMenu>
        <essential:ModernStandardWindowContextMenu />
    </essential:WindowEx.ContextMenu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <essential:WindowCaptionButtonThemeWorkaround Window="{x:Bind}" />

        <TitleBar
            Title="Dev Window"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Subtitle="Developer test entry points" />

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="16" Spacing="10">
                <essential:SettingsCard Description="Open the isolated static/dynamic Win2D graph test studio." Header="LiveGraph">
                    <Button
                        Click="OpenLiveGraphTestWindow_Click"
                        Content="Open test studio"
                        Style="{StaticResource AccentButtonStyle}" />
                </essential:SettingsCard>

                <essential:SettingsCard Description="Show the operation progress dialog test." Header="Operation dialog">
                    <Button Click="OpenOperationProgressDialog_Click" Content="Open dialog" />
                </essential:SettingsCard>

                <essential:SettingsCard Description="Intentionally throw a XAML-facing exception." Header="Exception handling">
                    <Button Click="TriggerXamlException_Click" Content="Trigger exception" />
                </essential:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</essential:WindowEx>
