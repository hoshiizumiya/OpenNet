<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenNet.UI.Xaml.View.Windows.DevWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essentials="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxv="using:OpenNet.UI.Xaml.View"
    Title="DevWindow"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <essentials:SettingsCard>
            <Button
                Click="TriggerXamlException_Click"
                Content="Trigger Xaml Exception"
                Style="{StaticResource AccentButtonStyle}" />
        </essentials:SettingsCard>
    </StackPanel>
</Window>
