<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="OpenNet.UI.Xaml.View.Windows.GuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxv="using:OpenNet.UI.Xaml.View"
    MinWidth="1000"
    MinHeight="650"
    MaxWidth="1500"
    MaxHeight="1000"
    IsMaximizable="True"
    mc:Ignorable="d">

    <essential:WindowEx.ContextMenu>
        <essential:ModernStandardWindowContextMenu />
    </essential:WindowEx.ContextMenu>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <essential:WindowCaptionButtonThemeWorkaround Window="{x:Bind Window}" />

        <TitleBar
            x:Uid="GuideTitleBar"
            Title="OpenNet Guide"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
        </TitleBar>

        <ouxv:GuideView
            x:Name="GuideContent"
            Grid.Row="1"
            Completed="OnGuideCompleted" />
    </Grid>

</essential:WindowEx>
