<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="OpenNet.UI.Xaml.View.Windows.RuntimeStatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:controls="using:XamlToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OpenNet.ViewModels"
    x:Uid="RuntimeStatusWindow"
    MinWidth="760"
    MinHeight="560"
    Title="OpenNet Runtime Status"
    TitleBarAutoDarkMode="True"
    mc:Ignorable="d">

    <essential:WindowEx.ContextMenu>
        <essential:ModernStandardWindowContextMenu />
    </essential:WindowEx.ContextMenu>

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <essential:WindowCaptionButtonThemeWorkaround Window="{x:Bind}" />

        <TitleBar
            x:Name="RuntimeStatusTitleBar"
            x:Uid="RuntimeStatusTitleBar"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False"
            Title="OpenNet Runtime Status">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
        </TitleBar>

        <CommandBar
            x:Uid="RuntimeStatusCommandBar"
            Grid.Row="1"
            Margin="16,8,16,8"
            Background="Transparent"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Uid="RuntimeStatusRefreshButton"
                Click="RefreshButton_Click"
                Icon="{essential:FontIcon Glyph=&#xE72C;}"
                Label="Refresh" />
            <AppBarButton
                x:Uid="RuntimeStatusCopyButton"
                Click="CopyButton_Click"
                Icon="{essential:FontIcon Glyph=&#xE8C8;}"
                Label="Copy all" />
        </CommandBar>

        <Border
            Grid.Row="2"
            Margin="16,0"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <controls:HeaderedTreeView
                x:Name="StatusTreeView"
                x:Uid="RuntimeStatusTree"
                ItemsSource="{x:Bind StatusItems}"
                SelectionMode="None">
                <controls:HeaderedTreeView.Header>
                    <Border
                        Padding="8,6,8,6"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        CornerRadius="4,4,0,0">
                        <interactivity:Interaction.Behaviors>
                            <behaviors:StickyHeaderBehavior />
                        </interactivity:Interaction.Behaviors>
                        <labs:DataTable ColumnSpacing="12">
                            <labs:DataColumn CanResize="True" DesiredWidth="320">
                                <TextBlock
                                    x:Uid="RuntimeStatusItemColumn"
                                    FontWeight="SemiBold"
                                    Text="Status item" />
                            </labs:DataColumn>
                            <labs:DataColumn CanResize="True" DesiredWidth="*">
                                <TextBlock
                                    x:Uid="RuntimeStatusValueColumn"
                                    FontWeight="SemiBold"
                                    Text="Current value" />
                            </labs:DataColumn>
                        </labs:DataTable>
                    </Border>
                </controls:HeaderedTreeView.Header>
                <controls:HeaderedTreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:RuntimeStatusDisplayItem">
                        <TreeViewItem
                            HorizontalContentAlignment="Stretch"
                            IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                            ItemsSource="{x:Bind Children}">
                            <labs:DataRow>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Name}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Text="{x:Bind Value, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Value}" />
                            </labs:DataRow>
                        </TreeViewItem>
                    </DataTemplate>
                </controls:HeaderedTreeView.ItemTemplate>
            </controls:HeaderedTreeView>
        </Border>

        <StackPanel
            Grid.Row="3"
            Margin="16,10,16,14"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                x:Name="RefreshIndicator"
                x:Uid="RuntimeStatusRefreshIndicator"
                Width="16"
                Height="16"
                IsActive="False" />
            <TextBlock
                x:Name="LastUpdatedText"
                x:Uid="RuntimeStatusLastUpdated"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Waiting for first refresh" />
        </StackPanel>
    </Grid>
</essential:WindowEx>
