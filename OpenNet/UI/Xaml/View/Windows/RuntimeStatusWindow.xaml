<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenNet.UI.Xaml.View.Windows.RuntimeStatusWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="using:XamlToolkit.WinUI.Behaviors"
    xmlns:controls="using:XamlToolkit.WinUI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:interactivity="using:XamlToolkit.WinUI.Interactivity"
    xmlns:labs="using:XamlToolkit.Labs.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Uid="RuntimeStatusWindow"
    Title="OpenNet Runtime Status"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Padding="16"
        RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Uid="RuntimeStatusCommandBar"
            Background="Transparent"
            DefaultLabelPosition="Right">
            <AppBarButton
                x:Uid="RuntimeStatusRefreshButton"
                Click="RefreshButton_Click"
                Icon="{essential:FontIcon Glyph=&#xE72C;}"
                Label="Refresh" />
            <AppBarButton
                x:Uid="RuntimeStatusCopyButton"
                Click="CopyButton_Click"
                Icon="{essential:FontIcon Glyph=&#xE8C8;}"
                Label="Copy all" />
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE9D9;" />
                    <TextBlock
                        x:Uid="RuntimeStatusTitle"
                        VerticalAlignment="Center"
                        Style="{StaticResource TitleTextBlockStyle}"
                        Text="OpenNet Runtime Status" />
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <Border
            Grid.Row="1"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <controls:HeaderedTreeView
                x:Name="StatusTreeView"
                x:Uid="RuntimeStatusTree"
                SelectionMode="None">
                <controls:HeaderedTreeView.Header>
                    <Border
                        Padding="8,6,8,6"
                        Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                        CornerRadius="4,4,0,0">
                        <interactivity:Interaction.Behaviors>
                            <behaviors:StickyHeaderBehavior />
                        </interactivity:Interaction.Behaviors>
                        <labs:DataTable ColumnSpacing="12">
                            <labs:DataColumn CanResize="True" DesiredWidth="320">
                                <TextBlock
                                    x:Uid="RuntimeStatusItemColumn"
                                    FontWeight="SemiBold"
                                    Text="Status item" />
                            </labs:DataColumn>
                            <labs:DataColumn CanResize="True" DesiredWidth="*">
                                <TextBlock
                                    x:Uid="RuntimeStatusValueColumn"
                                    FontWeight="SemiBold"
                                    Text="Current value" />
                            </labs:DataColumn>
                        </labs:DataTable>
                    </Border>
                </controls:HeaderedTreeView.Header>
            </controls:HeaderedTreeView>
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                x:Name="RefreshIndicator"
                x:Uid="RuntimeStatusRefreshIndicator"
                Width="16"
                Height="16"
                IsActive="False" />
            <TextBlock
                x:Name="LastUpdatedText"
                x:Uid="RuntimeStatusLastUpdated"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Waiting for first refresh" />
        </StackPanel>
    </Grid>
</Window>
