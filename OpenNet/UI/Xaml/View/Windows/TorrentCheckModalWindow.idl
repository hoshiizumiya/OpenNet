import "ViewModels/TorrentMetadataViewModel.idl";

namespace OpenNet.UI.Xaml.View.Windows
{
	[default_interface]
	runtimeclass TorrentCheckModalWindow : WinUI3Package.WindowEx
	{
		TorrentCheckModalWindow();
		TorrentCheckModalWindow(String torrentLink);

		WinUI.LiquidGlass.LiquidGlassComboBox SaveTorrentCopyLocationComboBox;
		WinUI.LiquidGlass.LiquidGlassCheckBox SaveTorrentCopyCheckBox;
		WinUI.LiquidGlass.LiquidGlassCheckBox StartImmediatelyCheckBox;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskShareModeToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskUploadModeToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskForceStartToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskSuperSeedingToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskSequentialDownloadToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskApplyIpFilterToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskEnablePexToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskEnableLsdToggle;
		WinUI.LiquidGlass.LiquidGlassToggleSwitch TaskEnableDhtToggle;
		WinUI.LiquidGlass.LiquidGlassTextBox TrackerListTextBox;

		// Bindable properties
		OpenNet.ViewModels.TorrentMetadataViewModel MetadataViewModel{ get; };
		Boolean IsLoading{ get; };
		String LoadingStatus{ get; };
		Int32 LoadingProgress{ get; };
		Boolean HasError{ get; };
		String ErrorMessage{ get; };
		Boolean MetadataReady{ get; };
	}
}
