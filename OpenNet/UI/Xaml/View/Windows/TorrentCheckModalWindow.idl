import "ViewModels/TorrentMetadataViewModel.idl";

namespace OpenNet.UI.Xaml.View.Windows
{
	[default_interface]
	runtimeclass TorrentCheckModalWindow : WinUI3Package.WindowEx
	{
		TorrentCheckModalWindow();
		TorrentCheckModalWindow(String torrentLink);

		Microsoft.UI.Xaml.Controls.ComboBox SaveTorrentCopyLocationComboBox;
		Microsoft.UI.Xaml.Controls.CheckBox SaveTorrentCopyCheckBox;
		Microsoft.UI.Xaml.Controls.CheckBox StartImmediatelyCheckBox;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskShareModeToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskUploadModeToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskForceStartToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskSuperSeedingToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskSequentialDownloadToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskApplyIpFilterToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskEnablePexToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskEnableLsdToggle;
		Microsoft.UI.Xaml.Controls.ToggleSwitch TaskEnableDhtToggle;
		Microsoft.UI.Xaml.Controls.TextBox TrackerListTextBox;

		// Bindable properties
		OpenNet.ViewModels.TorrentMetadataViewModel MetadataViewModel{ get; };
		Boolean IsLoading{ get; };
		String LoadingStatus{ get; };
		Int32 LoadingProgress{ get; };
		Boolean HasError{ get; };
		String ErrorMessage{ get; };
		Boolean MetadataReady{ get; };
	}
}
