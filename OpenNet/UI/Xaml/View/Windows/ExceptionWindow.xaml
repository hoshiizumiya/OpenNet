<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="OpenNet.UI.Xaml.View.Windows.ExceptionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Xaml.View.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme"
    xmlns:wl="using:WinUI.LiquidGlass"
    Title="OpenNet Exception Report"
    Width="800"
    Height="520"
    MinWidth="640"
    MinHeight="420"
    MaxWidth="1800"
    MaxHeight="1000"
    IsAlwaysOnTop="True"
    IsMaximizable="True"
    IsMinimizable="False"
    IsResizable="True"
    mc:Ignorable="d">

    <essential:WindowEx.SystemBackdrop>
        <essential:MicaBackdropWithFallback>
            <essential:MicaBackdropWithFallback.Fallback>
                <DesktopAcrylicBackdrop />
            </essential:MicaBackdropWithFallback.Fallback>
        </essential:MicaBackdropWithFallback>
    </essential:WindowEx.SystemBackdrop>

    <essential:WindowEx.ContextMenu>
        <essential:ModernStandardWindowContextMenu />
    </essential:WindowEx.ContextMenu>

    <Grid>
        <Grid.Resources>
            <ResourceDictionary>
                <essential:ModernStandardWindowContextMenu x:Name="Menu" Window="{x:Bind Window}" />
                <essential:ModernWindowCaptionButtonToolTip x:Name="CaptionButtonToolTip" Window="{x:Bind Window}" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <essential:WindowCaptionButtonThemeWorkaround Window="{x:Bind Window}" />
        <TitleBar
            x:Name="ExceptionWindowTitleBar"
            x:Uid="ViewWindowExceptionTitle"
            Title="We encountered some problems"
            Grid.Row="0"
            Height="32"
            Margin="12,0,0,0"
            FontSize="{StaticResource CaptionTextBlockFontSize}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="False" />
        <Grid
            Grid.Row="1"
            Padding="16"
            Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock
                    x:Uid="ViewWindowExceptionHeader"
                    Style="{StaticResource SubheaderTextBlockStyle}"
                    Text="An unrecoverable fatal error has occurred" />
                <TextBlock
                    Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind TraceId}" />
            </StackPanel>
            <TextBox
                x:Uid="ViewExceptionWindowStacktraceHeader"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="ViewExceptionWindowStacktraceHeader"
                FontFamily="Consolas"
                Header="Exception Details"
                IsReadOnly="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                Text="{x:Bind Exception}"
                TextWrapping="NoWrap" x:Name="GlassPresenter_2746"
                ouxct:ControlAppearance.IsEnabled="True"
                Grid.Row="1" />
            <TextBox
                x:Uid="ViewExceptionWindowComment"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="ViewExceptionWindowComment"
                Description="Clear, step-by-step descriptions will help us locate the issue faster"
                Header="What actions did you perform before the crash occurred?"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                Text="{x:Bind Comment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" x:Name="GlassPresenter_3309"
                ouxct:ControlAppearance.IsEnabled="True"
                Grid.Row="2" />
            <StackPanel
                Grid.Row="3"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Uid="ViewWindowExceptionClose"
                    AutomationProperties.AutomationId="ViewWindowExceptionClose"
                    Click="ViewWindowExceptionCloseButton_Click"
                    Content="Close" x:Name="ExceptionWindowCloseButton"
                    ouxct:ControlAppearance.IsEnabled="True" />
            </StackPanel>
        </Grid>
    </Grid>
</essential:WindowEx>
