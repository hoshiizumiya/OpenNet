<?xml version="1.0" encoding="utf-8" ?>
<essential:WindowEx
    x:Class="OpenNet.UI.Xaml.View.Windows.NATDetectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NAT and port detection"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <essential:ModernStandardWindowContextMenu x:Name="Menu" Window="{x:Bind Window}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="NATDetectorWindowTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon Glyph="&#xE968;" />
                <TextBlock
                    x:Uid="ViewNATDetectorWindowText1"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="NAT and port detection" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,12,24,24" Spacing="16">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="ViewNATDetectorWindowText2"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Traversal directory" />
                        <TextBox
                            x:Name="DirectoryUriBox"
                            Grid.Column="1"
                            PlaceholderText="https://server.example/api/v1/traversal/servers" />
                        <NumberBox
                            x:Name="ListenPortNumber"
                            Grid.Column="2"
                            Width="130"
                            AutomationProperties.AutomationId="ViewNATDetectorWindowText3"
                            Header="IPv4 listen port"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline" />
                        <NumberBox
                            x:Name="IPv6ListenPortNumber"
                            Grid.Column="3"
                            Width="130"
                            Header="IPv6 listen port"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Inline" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Listening-port reachability and NAT behavior are separate tests. The four fast IPv4/IPv6 TCP/UDP probes target libtorrent's existing listeners. NAT behavior uses one temporary UDP socket and compares how its public endpoint changes across remote endpoints."
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="DiagnosticInfoBar"
                    x:Uid="ViewNATDetectorWindowDiagnosticInfoBar"
                    Title="Detection note"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText5"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Address and NAT" />
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Uid="ViewNATDetectorWindowText6" Text="Local IPv4" />
                                <TextBlock
                                    x:Name="LocalIPv4Text"
                                    x:Uid="ViewNATDetectorWindowText7"
                                    Grid.Column="1"
                                    Text="—" />
                                <TextBlock Grid.Row="1" Text="Internal UDP endpoint" />
                                <TextBlock
                                    x:Name="LocalEndpointText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="—" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText8"
                                    Grid.Row="2"
                                    Text="Public IPv4" />
                                <TextBlock
                                    x:Name="PublicIPv4Text"
                                    x:Uid="ViewNATDetectorWindowText7"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="—" />
                                <TextBlock Grid.Row="3" Text="Observed public endpoint" />
                                <TextBlock
                                    x:Name="PublicEndpointText"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="—" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText10"
                                    Grid.Row="4"
                                    Text="Mapping behavior" />
                                <TextBlock
                                    x:Name="MappingText"
                                    x:Uid="ViewNATDetectorWindowText11"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="Unknown"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText12"
                                    Grid.Row="5"
                                    Text="Filtering behavior" />
                                <TextBlock
                                    x:Name="FilteringText"
                                    x:Uid="ViewNATDetectorWindowText11"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="Unknown"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText14"
                                    Grid.Row="6"
                                    Text="Legacy label" />
                                <TextBlock
                                    x:Name="NatTypeText"
                                    x:Uid="ViewNATDetectorWindowText11"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Text="Unknown"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText16"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Listening port" />
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="IPv4 TCP / BitTorrent" />
                                <TextBlock
                                    x:Name="TcpPortText"
                                    x:Uid="ViewNATDetectorWindowText18"
                                    Grid.Column="1"
                                    Text="Not tested" />
                                <TextBlock Grid.Row="1" Text="IPv4 UDP / uTP" />
                                <TextBlock
                                    x:Name="UdpPortText"
                                    x:Uid="ViewNATDetectorWindowText18"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="Not tested" />
                                <TextBlock Grid.Row="2" Text="IPv6 TCP / BitTorrent" />
                                <TextBlock
                                    x:Name="IPv6TcpPortText"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="Not tested"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="IPv6 UDP / uTP" />
                                <TextBlock
                                    x:Name="IPv6UdpPortText"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="Not tested"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText21"
                                    Grid.Row="4"
                                    Text="UPnP" />
                                <TextBlock
                                    x:Name="UpnpText"
                                    x:Uid="ViewNATDetectorWindowText11"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="Unknown" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText23"
                                    Grid.Row="5"
                                    Text="NAT-PMP / PCP" />
                                <TextBlock
                                    x:Name="NatPmpText"
                                    x:Uid="ViewNATDetectorWindowText11"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="Unknown" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText25"
                                    Grid.Row="6"
                                    Text="Mapped port" />
                                <TextBlock
                                    x:Name="PortMappingText"
                                    x:Uid="ViewNATDetectorWindowText7"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Text="—"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Uid="ViewNATDetectorWindowText29"
                                    Grid.Row="7"
                                    Text="Probe evidence" />
                                <TextBlock
                                    x:Name="ProbeEvidenceText"
                                    x:Uid="ViewNATDetectorWindowText7"
                                    Grid.Row="7"
                                    Grid.Column="1"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            x:Uid="ViewNATDetectorWindowText31"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="RFC 5780 mapping observations" />
                        <Grid ColumnSpacing="1" RowSpacing="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText32"
                                Grid.Column="1"
                                Padding="8"
                                FontWeight="SemiBold"
                                Text="Server 1 / primary" />
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText33"
                                Grid.Column="2"
                                Padding="8"
                                FontWeight="SemiBold"
                                Text="Server 1 / other port" />
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText34"
                                Grid.Column="3"
                                Padding="8"
                                FontWeight="SemiBold"
                                Text="Other IPv4 / server 2" />
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText35"
                                Grid.Row="1"
                                Padding="8"
                                Text="Result" />
                            <TextBlock
                                x:Name="Observation1Result"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation2Result"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="1"
                                Grid.Column="2"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation3Result"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="1"
                                Grid.Column="3"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText39"
                                Grid.Row="2"
                                Padding="8"
                                Text="Public IP:port" />
                            <TextBlock
                                x:Name="Observation1Address"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="2"
                                Grid.Column="1"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation2Address"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="2"
                                Grid.Column="2"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation3Address"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="2"
                                Grid.Column="3"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Uid="ViewNATDetectorWindowText43"
                                Grid.Row="3"
                                Padding="8"
                                Text="Latency" />
                            <TextBlock
                                x:Name="Observation1Latency"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="3"
                                Grid.Column="1"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation2Latency"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="3"
                                Grid.Column="2"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation3Latency"
                                x:Uid="ViewNATDetectorWindowText7"
                                Grid.Row="3"
                                Grid.Column="3"
                                Padding="8"
                                Text="—" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="RFC 5780 filtering observations" />
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Reply from different IP + port" />
                            <TextBlock
                                x:Name="FilteringDifferentAddressPortText"
                                Grid.Column="1"
                                Text="Not tested"
                                TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Text="Reply from same IP, different port" />
                            <TextBlock
                                x:Name="FilteringDifferentPortText"
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="Not tested"
                                TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Text="Interpretation" />
                            <TextBlock
                                x:Name="FilteringExplanationText"
                                Grid.Row="2"
                                Grid.Column="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Run the full detection to measure which remote endpoints may send back through the NAT mapping."
                                TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Why this result?" />
                        <TextBlock
                            x:Name="ConclusionExplanationText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="Run the full detection to see the internal endpoint, observed public endpoints, and the evidence used for the classification."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    x:Name="DetectingProgress"
                    Width="20"
                    Height="20"
                    IsActive="False" />
                <TextBlock
                    x:Name="StatusText"
                    x:Uid="ViewNATDetectorWindowText47"
                    VerticalAlignment="Center"
                    Text="Ready" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="QuickPortButton"
                    Click="QuickPortButton_Click"
                    Content="Quick port test" />
                <Button
                    x:Name="StartButton"
                    x:Uid="ViewNATDetectorWindowText48"
                    AutomationProperties.AutomationId="ViewNATDetectorWindowText48"
                    Click="StartButton_Click"
                    Content="Start detection"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button
                    x:Uid="ViewNATDetectorWindowText49"
                    AutomationProperties.AutomationId="ViewNATDetectorWindowText49"
                    Click="CloseButton_Click"
                    Content="Close" />
            </StackPanel>
        </Grid>
    </Grid>
</essential:WindowEx>
