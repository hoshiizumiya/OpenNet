<?xml version="1.0" encoding="utf-8" ?>
<essential:ModalWindow
    x:Class="OpenNet.UI.Xaml.View.Windows.NATDetectorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="NAT and port detection"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <essential:ModernStandardWindowContextMenu x:Name="Menu" Window="{x:Bind}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="NATDetectorWindowTitleBar"
            Grid.Row="0"
            Height="48"
            Padding="16,0">
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon Glyph="&#xE968;" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="NAT and port detection" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="24,12,24,24" Spacing="16">
                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Traversal directory" />
                        <TextBox
                            x:Name="DirectoryUriBox"
                            Grid.Column="1"
                            PlaceholderText="https://server.example/api/v1/traversal/servers" />
                        <NumberBox
                            x:Name="ListenPortNumber"
                            Grid.Column="2"
                            Width="130"
                            Header="Listen port"
                            Maximum="65535"
                            Minimum="1"
                            SpinButtonPlacementMode="Hidden" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.ColumnSpan="3"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="NAT behavior uses a temporary UDP socket. Port reachability is tested against libtorrent's existing TCP/uTP listener."
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="DiagnosticInfoBar"
                    Title="Detection note"
                    IsClosable="False"
                    IsOpen="False"
                    Severity="Informational" />

                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Address and NAT" />
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Local IPv4" />
                                <TextBlock
                                    x:Name="LocalIPv4Text"
                                    Grid.Column="1"
                                    Text="—" />
                                <TextBlock Grid.Row="1" Text="Public IPv4" />
                                <TextBlock
                                    x:Name="PublicIPv4Text"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="—" />
                                <TextBlock Grid.Row="2" Text="Mapping behavior" />
                                <TextBlock
                                    x:Name="MappingText"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="Unknown"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Row="3" Text="Filtering behavior" />
                                <TextBlock
                                    x:Name="FilteringText"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="Unknown"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Row="4" Text="Legacy label" />
                                <TextBlock
                                    x:Name="NatTypeText"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="Unknown"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Column="1"
                        Padding="16"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <StackPanel Spacing="8">
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Text="Listening port" />
                            <Grid ColumnSpacing="12" RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="TCP / BitTorrent" />
                                <TextBlock
                                    x:Name="TcpPortText"
                                    Grid.Column="1"
                                    Text="Not tested" />
                                <TextBlock Grid.Row="1" Text="UDP / uTP" />
                                <TextBlock
                                    x:Name="UdpPortText"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="Not tested" />
                                <TextBlock Grid.Row="2" Text="UPnP" />
                                <TextBlock
                                    x:Name="UpnpText"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Text="Unknown" />
                                <TextBlock Grid.Row="3" Text="NAT-PMP / PCP" />
                                <TextBlock
                                    x:Name="NatPmpText"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    Text="Unknown" />
                                <TextBlock Grid.Row="4" Text="Mapped port" />
                                <TextBlock
                                    x:Name="PortMappingText"
                                    Grid.Row="4"
                                    Grid.Column="1"
                                    Text="—"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Row="5" Text="IPv6 TCP / UDP" />
                                <TextBlock
                                    x:Name="IPv6PortText"
                                    Grid.Row="5"
                                    Grid.Column="1"
                                    Text="Not tested"
                                    TextWrapping="Wrap" />
                                <TextBlock Grid.Row="6" Text="Probe evidence" />
                                <TextBlock
                                    x:Name="ProbeEvidenceText"
                                    Grid.Row="6"
                                    Grid.Column="1"
                                    Text="—"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border
                    Padding="16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="10">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="RFC 5780 mapping observations" />
                        <Grid ColumnSpacing="1" RowSpacing="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Column="1"
                                Padding="8"
                                FontWeight="SemiBold"
                                Text="Server 1 / primary" />
                            <TextBlock
                                Grid.Column="2"
                                Padding="8"
                                FontWeight="SemiBold"
                                Text="Server 1 / other port" />
                            <TextBlock
                                Grid.Column="3"
                                Padding="8"
                                FontWeight="SemiBold"
                                Text="Other IPv4 / server 2" />
                            <TextBlock
                                Grid.Row="1"
                                Padding="8"
                                Text="Result" />
                            <TextBlock
                                x:Name="Observation1Result"
                                Grid.Row="1"
                                Grid.Column="1"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation2Result"
                                Grid.Row="1"
                                Grid.Column="2"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation3Result"
                                Grid.Row="1"
                                Grid.Column="3"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                Grid.Row="2"
                                Padding="8"
                                Text="Public IP:port" />
                            <TextBlock
                                x:Name="Observation1Address"
                                Grid.Row="2"
                                Grid.Column="1"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation2Address"
                                Grid.Row="2"
                                Grid.Column="2"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation3Address"
                                Grid.Row="2"
                                Grid.Column="3"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                Grid.Row="3"
                                Padding="8"
                                Text="Latency" />
                            <TextBlock
                                x:Name="Observation1Latency"
                                Grid.Row="3"
                                Grid.Column="1"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation2Latency"
                                Grid.Row="3"
                                Grid.Column="2"
                                Padding="8"
                                Text="—" />
                            <TextBlock
                                x:Name="Observation3Latency"
                                Grid.Row="3"
                                Grid.Column="3"
                                Padding="8"
                                Text="—" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="24,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <ProgressRing
                    x:Name="DetectingProgress"
                    Width="20"
                    Height="20"
                    IsActive="False" />
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Text="Ready" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    x:Name="StartButton"
                    Click="StartButton_Click"
                    Content="Start detection"
                    Style="{StaticResource AccentButtonStyle}" />
                <Button Click="CloseButton_Click" Content="Close" />
            </StackPanel>
        </Grid>
    </Grid>
</essential:ModalWindow>
