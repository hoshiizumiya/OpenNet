<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:effect="using:OpenNet.UI.Xaml.Control.Effect"
    xmlns:essential="using:WinUI3Package">

    <Style TargetType="effect:AnimatedDigit">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="effect:AnimatedDigit">
                    <Grid essential:UIElementExtension.ClipToBounds="True">
                        <Grid.Resources>
                            <Duration x:Key="DigitAnimationDuration">0:0:0.3</Duration>
                            <Duration x:Key="OpacityAnimationDuration">0:0:0.25</Duration>
                            <ExponentialEase x:Key="DigitTranslationEasing" EasingMode="EaseOut" Exponent="5" />
                            <ExponentialEase x:Key="OpacityEasing" EasingMode="EaseOut" Exponent="7" />
                        </Grid.Resources>
                        <TextBlock
                            x:Name="CurrentDigit"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontStyle="{TemplateBinding FontStyle}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}"
                            Opacity="1"
                            RenderTransformOrigin="0.5,0.5"
                            Text="{Binding CurrentValue, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="CurrentDigitTranslate" />
                                    <ScaleTransform x:Name="CurrentDigitScale" />
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            x:Name="NextDigit"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontStyle="{TemplateBinding FontStyle}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}"
                            Opacity="0"
                            RenderTransformOrigin="0.5,0.5"
                            Text="{Binding NextValue, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                            Visibility="Collapsed">
                            <TextBlock.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform x:Name="NextDigitTranslate" />
                                    <ScaleTransform x:Name="NextDigitScale" />
                                </TransformGroup>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup>
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="IncreaseState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CurrentDigit" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="Collapsed" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NextDigit" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation x:Name="IncreaseCurrentDigitTranslateAnimation" Duration="{StaticResource DigitAnimationDuration}" EasingFunction="{StaticResource DigitTranslationEasing}" Storyboard.TargetName="CurrentDigitTranslate" Storyboard.TargetProperty="Y" />
                                        <DoubleAnimation x:Name="IncreaseNextDigitTranslateAnimation" Duration="{StaticResource DigitAnimationDuration}" EasingFunction="{StaticResource DigitTranslationEasing}" Storyboard.TargetName="NextDigitTranslate" Storyboard.TargetProperty="Y" />
                                        <DoubleAnimation Duration="{StaticResource OpacityAnimationDuration}" EasingFunction="{StaticResource OpacityEasing}" From="1" Storyboard.TargetName="CurrentDigit" Storyboard.TargetProperty="Opacity" To="0" />
                                        <DoubleAnimation Duration="{StaticResource OpacityAnimationDuration}" EasingFunction="{StaticResource OpacityEasing}" From="0" Storyboard.TargetName="NextDigit" Storyboard.TargetProperty="Opacity" To="1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="DecreaseState">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CurrentDigit" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="NextDigit" Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="Visible" />
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="Collapsed" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation x:Name="DecreaseCurrentDigitTranslateAnimation" Duration="{StaticResource DigitAnimationDuration}" EasingFunction="{StaticResource DigitTranslationEasing}" Storyboard.TargetName="CurrentDigitTranslate" Storyboard.TargetProperty="Y" />
                                        <DoubleAnimation x:Name="DecreaseNextDigitTranslateAnimation" Duration="{StaticResource DigitAnimationDuration}" EasingFunction="{StaticResource DigitTranslationEasing}" Storyboard.TargetName="NextDigitTranslate" Storyboard.TargetProperty="Y" />
                                        <DoubleAnimation Duration="{StaticResource OpacityAnimationDuration}" EasingFunction="{StaticResource OpacityEasing}" From="0" Storyboard.TargetName="CurrentDigit" Storyboard.TargetProperty="Opacity" To="1" />
                                        <DoubleAnimation Duration="{StaticResource OpacityAnimationDuration}" EasingFunction="{StaticResource OpacityEasing}" From="1" Storyboard.TargetName="NextDigit" Storyboard.TargetProperty="Opacity" To="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="effect:AnimatedNumber">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="effect:AnimatedNumber">
                    <StackPanel
                        x:Name="RootPanel"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <StackPanel.ChildrenTransitions>
                            <RepositionThemeTransition />
                        </StackPanel.ChildrenTransitions>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
