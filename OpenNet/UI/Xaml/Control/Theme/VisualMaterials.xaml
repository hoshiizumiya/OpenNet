<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:essential="using:WinUI3Package" xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="OpenNetTitleCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OpenNetCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OpenNetSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OpenNetGuideLiquidGlassBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarOverflowPresenterBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="OpenNetTitleCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OpenNetCardBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OpenNetSurfaceBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="OpenNetGuideLiquidGlassBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarOverflowPresenterBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="OpenNetTitleCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OpenNetCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OpenNetSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OpenNetGuideLiquidGlassBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <StaticResource x:Key="SettingsCardBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPointerOver" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="SettingsCardBackgroundPressed" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarBackgroundOpen" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="CommandBarOverflowPresenterBackground" ResourceKey="CardBackgroundFillColorDefaultBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ouxct:MaterialControlState xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme" x:Key="MaterialControlState" />

    <Style BasedOn="{StaticResource DefaultCommandBarStyle}" TargetType="CommandBar">
        <Setter Property="ouxct:ControlAppearance.Surface" Value="FloatingPanel" />
        <Setter Property="Background" Value="{Binding Path=(ouxct:ControlAppearance.Brush), RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style BasedOn="{StaticResource DefaultSettingsCardStyle}" TargetType="essential:SettingsCard">
        <Setter Property="ouxct:ControlAppearance.Surface" Value="Card" />
        <Setter Property="Background" Value="{Binding Path=(ouxct:ControlAppearance.Brush), RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style BasedOn="{StaticResource DefaultSettingsExpanderStyle}" TargetType="essential:SettingsExpander">
        <Setter Property="ouxct:ControlAppearance.Surface" Value="Card" />
        <Setter Property="Background" Value="{Binding Path=(ouxct:ControlAppearance.Brush), RelativeSource={RelativeSource Self}}" />
    </Style>
</ResourceDictionary>
