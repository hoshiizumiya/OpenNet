<?xml version="1.0" encoding="utf-8" ?>
<!--  One business control; real library controls own the template visuals and motion.  -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme" xmlns:wl="using:WinUI.LiquidGlass">

    <ControlTemplate x:Key="MaterialButtonTemplate" TargetType="Button">
        <wl:LiquidGlassButton x:Name="MaterialVisual"
                              Padding="{TemplateBinding Padding}"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ouxct:MaterialControlState.IsManaged="True"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                              ContentTransitions="{TemplateBinding ContentTransitions}"
                              FlowDirection="{TemplateBinding FlowDirection}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontStyle="{TemplateBinding FontStyle}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Foreground="{TemplateBinding Foreground}"
                              IsTabStop="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialHyperlinkButtonTemplate" TargetType="HyperlinkButton">
        <wl:LiquidGlassHyperlinkButton x:Name="MaterialVisual"
                                       Padding="{TemplateBinding Padding}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                       HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                       ouxct:MaterialControlState.IsManaged="True"
                                       Content="{TemplateBinding Content}"
                                       ContentTemplate="{TemplateBinding ContentTemplate}"
                                       ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                       ContentTransitions="{TemplateBinding ContentTransitions}"
                                       FlowDirection="{TemplateBinding FlowDirection}"
                                       FontFamily="{TemplateBinding FontFamily}"
                                       FontSize="{TemplateBinding FontSize}"
                                       FontStyle="{TemplateBinding FontStyle}"
                                       FontWeight="{TemplateBinding FontWeight}"
                                       Foreground="{TemplateBinding Foreground}"
                                       IsTabStop="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialToggleButtonTemplate" TargetType="ToggleButton">
        <wl:LiquidGlassToggleButton x:Name="MaterialVisual"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    ouxct:MaterialControlState.IsManaged="True"
                                    Command="{TemplateBinding Command}"
                                    CommandParameter="{TemplateBinding CommandParameter}"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                    ContentTransitions="{TemplateBinding ContentTransitions}"
                                    FlowDirection="{TemplateBinding FlowDirection}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontStyle="{TemplateBinding FontStyle}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    IsTabStop="False"
                                    IsThreeState="{TemplateBinding IsThreeState}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialCheckBoxTemplate" TargetType="CheckBox">
        <wl:LiquidGlassCheckBox x:Name="MaterialVisual"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                ouxct:MaterialControlState.IsManaged="True"
                                Command="{TemplateBinding Command}"
                                CommandParameter="{TemplateBinding CommandParameter}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                ContentTransitions="{TemplateBinding ContentTransitions}"
                                FlowDirection="{TemplateBinding FlowDirection}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                IsTabStop="False"
                                IsThreeState="{TemplateBinding IsThreeState}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialRadioButtonTemplate" TargetType="RadioButton">
        <wl:LiquidGlassRadioButton x:Name="MaterialVisual"
                                   Padding="{TemplateBinding Padding}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                   ouxct:MaterialControlState.IsManaged="True"
                                   Command="{TemplateBinding Command}"
                                   CommandParameter="{TemplateBinding CommandParameter}"
                                   Content="{TemplateBinding Content}"
                                   ContentTemplate="{TemplateBinding ContentTemplate}"
                                   ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                   ContentTransitions="{TemplateBinding ContentTransitions}"
                                   FlowDirection="{TemplateBinding FlowDirection}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontStyle="{TemplateBinding FontStyle}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   IsTabStop="False" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialSliderTemplate" TargetType="Slider">
        <wl:LiquidGlassSlider x:Name="MaterialVisual" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              ouxct:MaterialControlState.IsManaged="True"
                              FlowDirection="{TemplateBinding FlowDirection}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontSize="{TemplateBinding FontSize}"
                              FontStyle="{TemplateBinding FontStyle}"
                              FontWeight="{TemplateBinding FontWeight}"
                              Header="{TemplateBinding Header}"
                              HeaderTemplate="{TemplateBinding HeaderTemplate}"
                              IsTabStop="False"
                              IsThumbToolTipEnabled="{TemplateBinding IsThumbToolTipEnabled}"
                              LargeChange="{TemplateBinding LargeChange}"
                              Orientation="{TemplateBinding Orientation}"
                              SmallChange="{TemplateBinding SmallChange}"
                              SnapsTo="{TemplateBinding SnapsTo}"
                              StepFrequency="{TemplateBinding StepFrequency}"
                              ThumbToolTipValueConverter="{TemplateBinding ThumbToolTipValueConverter}"
                              TickFrequency="{TemplateBinding TickFrequency}"
                              TickPlacement="{TemplateBinding TickPlacement}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialTextBoxTemplate" TargetType="TextBox">
        <wl:LiquidGlassTextBox x:Name="MaterialVisual"
                               Padding="{TemplateBinding Padding}"
                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                               HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                               ouxct:MaterialControlState.IsManaged="True"
                               AcceptsReturn="{TemplateBinding AcceptsReturn}"
                               FlowDirection="{TemplateBinding FlowDirection}"
                               FontFamily="{TemplateBinding FontFamily}"
                               FontSize="{TemplateBinding FontSize}"
                               FontStyle="{TemplateBinding FontStyle}"
                               FontWeight="{TemplateBinding FontWeight}"
                               Foreground="{TemplateBinding Foreground}"
                               Header="{TemplateBinding Header}"
                               HeaderTemplate="{TemplateBinding HeaderTemplate}"
                               InputScope="{TemplateBinding InputScope}"
                               IsReadOnly="{TemplateBinding IsReadOnly}"
                               IsSpellCheckEnabled="{TemplateBinding IsSpellCheckEnabled}"
                               IsTabStop="{TemplateBinding IsTabStop}"
                               IsTextPredictionEnabled="{TemplateBinding IsTextPredictionEnabled}"
                               MaxLength="{TemplateBinding MaxLength}"
                               PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                               PlaceholderText="{TemplateBinding PlaceholderText}"
                               SelectionHighlightColor="{TemplateBinding SelectionHighlightColor}"
                               TextAlignment="{TemplateBinding TextAlignment}"
                               TextWrapping="{TemplateBinding TextWrapping}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialPasswordBoxTemplate" TargetType="PasswordBox">
        <wl:LiquidGlassPasswordBox x:Name="MaterialVisual"
                                   Padding="{TemplateBinding Padding}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                   HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                   VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                   ouxct:MaterialControlState.IsManaged="True"
                                   FlowDirection="{TemplateBinding FlowDirection}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontStyle="{TemplateBinding FontStyle}"
                                   FontWeight="{TemplateBinding FontWeight}"
                                   Foreground="{TemplateBinding Foreground}"
                                   IsTabStop="False"
                                   PlaceholderText="{TemplateBinding PlaceholderText}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialComboBoxTemplate" TargetType="ComboBox">
        <wl:LiquidGlassComboBox x:Name="MaterialVisual"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                ouxct:MaterialControlState.IsManaged="True"
                                DisplayMemberPath="{TemplateBinding DisplayMemberPath}"
                                FlowDirection="{TemplateBinding FlowDirection}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                FontStyle="{TemplateBinding FontStyle}"
                                FontWeight="{TemplateBinding FontWeight}"
                                Foreground="{TemplateBinding Foreground}"
                                Header="{TemplateBinding Header}"
                                HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                IsEditable="{TemplateBinding IsEditable}"
                                IsTabStop="False"
                                IsTextSearchEnabled="{TemplateBinding IsTextSearchEnabled}"
                                ItemContainerStyle="{TemplateBinding ItemContainerStyle}"
                                ItemContainerStyleSelector="{TemplateBinding ItemContainerStyleSelector}"
                                ItemTemplate="{TemplateBinding ItemTemplate}"
                                ItemTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                MaxDropDownHeight="{TemplateBinding MaxDropDownHeight}"
                                PlaceholderForeground="{TemplateBinding PlaceholderForeground}"
                                PlaceholderText="{TemplateBinding PlaceholderText}"
                                SelectedValuePath="{TemplateBinding SelectedValuePath}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialToggleSwitchTemplate" TargetType="ToggleSwitch">
        <wl:LiquidGlassToggleSwitch x:Name="MaterialVisual"
                                    Padding="{TemplateBinding Padding}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                    HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                    ouxct:MaterialControlState.IsManaged="True"
                                    FlowDirection="{TemplateBinding FlowDirection}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontStyle="{TemplateBinding FontStyle}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Header="{TemplateBinding Header}"
                                    HeaderTemplate="{TemplateBinding HeaderTemplate}"
                                    IsTabStop="False"
                                    OffContent="{TemplateBinding OffContent}"
                                    OffContentTemplate="{TemplateBinding OffContentTemplate}"
                                    OnContent="{TemplateBinding OnContent}"
                                    OnContentTemplate="{TemplateBinding OnContentTemplate}" />
    </ControlTemplate>

    <ControlTemplate x:Key="MaterialCardTemplate" TargetType="ContentControl">
        <wl:LiquidGlassCard x:Name="MaterialVisual"
                            Padding="{TemplateBinding Padding}"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            ouxct:MaterialControlState.IsManaged="True"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            FlowDirection="{TemplateBinding FlowDirection}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}"
                            FontStyle="{TemplateBinding FontStyle}"
                            FontWeight="{TemplateBinding FontWeight}"
                            Foreground="{TemplateBinding Foreground}"
                            IsTabStop="False" />
    </ControlTemplate>
</ResourceDictionary>
