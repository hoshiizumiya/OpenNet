<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ouxct="using:OpenNet.UI.Xaml.Control.Theme">
    <!--  Base sizes are DIPs before application AND system text scaling. No Viewbox zoom.  -->
    <Style x:Key="AppBaseTextBlockStyle" BasedOn="{StaticResource BaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style x:Key="BodyTextBlockStyle" BasedOn="{StaticResource AppBaseTextBlockStyle}" TargetType="TextBlock" />
    <Style x:Key="CaptionTextBlockStyle" BasedOn="{StaticResource AppBaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="12" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" BasedOn="{StaticResource AppBaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" BasedOn="{StaticResource AppBaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TitleTextBlockStyle" BasedOn="{StaticResource AppBaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="TitleLargeTextBlockStyle" BasedOn="{StaticResource AppBaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="40" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="DisplayTextBlockStyle" BasedOn="{StaticResource AppBaseTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="68" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock" />
    <Style TargetType="RichTextBlock">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultToggleButtonStyle}" TargetType="ToggleButton">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultHyperlinkButtonStyle}" TargetType="HyperlinkButton">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultCheckBoxStyle}" TargetType="CheckBox">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultRadioButtonStyle}" TargetType="RadioButton">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultToggleSwitchStyle}" TargetType="ToggleSwitch">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultPasswordBoxStyle}" TargetType="PasswordBox">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
    <Style BasedOn="{StaticResource DefaultAutoSuggestBoxStyle}" TargetType="AutoSuggestBox">
        <Setter Property="ouxct:Typography.BaseFontSize" Value="14" />
    </Style>
</ResourceDictionary>
