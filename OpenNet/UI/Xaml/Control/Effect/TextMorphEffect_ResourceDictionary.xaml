<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mgcux="using:Microsoft.Graphics.Canvas.UI.Xaml"
    xmlns:ouxce="using:OpenNet.UI.Xaml.Control.Effect">

    <Style BasedOn="{StaticResource DefaultTextMorphEffectStyle}" TargetType="ouxce:TextMorphEffect" />

    <Style x:Key="DefaultTextMorphEffectStyle" TargetType="ouxce:TextMorphEffect">
        <Setter Property="ColorBrush" Value="{ThemeResource SystemBaseMediumHighColor}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ouxce:TextMorphEffect">
                    <mgcux:CanvasControl x:Name="PART_Canvas" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
