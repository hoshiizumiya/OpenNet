<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ouxcc="using:OpenNet.UI.Xaml.Control.Card">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///UI/Xaml/Control/Theme/Card_ResourceDictionary.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource DefaultHorizontalCardStyle}" TargetType="ouxcc:HorizontalCard" />

    <Style x:Key="DefaultHorizontalCardStyle" TargetType="ouxcc:HorizontalCard">
        <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ouxcc:HorizontalCard">
                    <Grid Background="{TemplateBinding Background}" Style="{ThemeResource GridShimmerStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Child="{TemplateBinding Left}" />
                        <Border
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Child="{TemplateBinding Right}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
