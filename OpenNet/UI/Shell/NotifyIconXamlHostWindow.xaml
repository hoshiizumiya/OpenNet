<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenNet.UI.Shell.NotifyIconXamlHostWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet.UI.Shell"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page>
        <Page.Resources>
            <essential:TaskbarIcon
                x:Name="trayIcon"
                x:Uid="trayIcon"
                Guid="{x:Bind local:NotifyIconXamlHostWindow.IconGuid}"
                Icon="ms-appx:///Assets/AppIcons/win3264.ico"
                LeftDoublePressed="ShowMainWindow"
                LeftPressed="ShowMainWindow"
                ToolTip="OpenNet">
                <local:NotifyIconContextMenu />
            </essential:TaskbarIcon>
        </Page.Resources>
    </Page>

</Window>