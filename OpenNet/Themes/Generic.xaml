<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:anim="using:XamlToolkit.WinUI.Animations"
    xmlns:helpers="using:OpenNet.Helpers">

    <!--  资源：隐式 Opacity 动画定义  -->
    <anim:ImplicitAnimationSet x:Key="IconOpacityAnim">
        <anim:OpacityAnimation
            From="0"
            To="1"
            Duration="0:0:0.18" />
    </anim:ImplicitAnimationSet>

    <Style
        x:Key="DataTableColumnHeaderButtonStyle"
        BasedOn="{StaticResource SubtleButtonStyle}"
        TargetType="Button">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
