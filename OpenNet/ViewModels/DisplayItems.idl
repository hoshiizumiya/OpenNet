namespace OpenNet.ViewModels
{
	// Lightweight display items for task detail sub-pages (x:Bind DataTable rows).

	[default_interface]
	runtimeclass PeerDisplayItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
	{
		PeerDisplayItem();
		String IP;
		String Address;
		Int32 Port;
		String Client;
		String Progress;
		String DLSpeed;
		String ULSpeed;
		String Downloaded;
		String Uploaded;
		Double ProgressValue;
		Double SegmentStart;
		Double SegmentEnd;
		Microsoft.UI.Xaml.Visibility LinearProgressVisibility;
		Microsoft.UI.Xaml.Visibility RangeProgressVisibility;
		Int64 DownloadRate;
		Int64 UploadRate;
		Int64 DownloadedBytes;
		Int64 UploadedBytes;
		String PeerStatus;
		String Reason;
		String Location;
		String CountryCode;
		String FlagSvg;
		String ConnectionTime;
		String Protocol;
		String Initiator;
		String Source;
		Boolean IsExpanded;
		Boolean IsGroup;
		Windows.Foundation.Collections.IObservableVector<PeerDisplayItem> Children{ get; };
	};

	[default_interface]
	runtimeclass TrackerDisplayItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
	{
		TrackerDisplayItem();
		String URL;
		String Tier;
		String Peers;
		String Retries;
		String TimeRemaining;
		String Seeders;
		String Leechers;
		String Downloaded;
		String Status;
		String Message;
	};

	[default_interface]
	runtimeclass HttpConnectionDisplayItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
	{
		HttpConnectionDisplayItem();
		String Key;
		String URL;
		String DownloadRate;
		String DownloadSize;
		Double RangeStart;
		Double RangeEnd;
		Double ProgressValue;
		String Progress;
		String Status;
	};

	[default_interface]
	runtimeclass HttpServerDisplayItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
	{
		HttpServerDisplayItem();
		String Key;
		String URL;
		String Connections;
		String DownloadRate;
		String DownloadSize;
		String Pieces;
		String Progress;
