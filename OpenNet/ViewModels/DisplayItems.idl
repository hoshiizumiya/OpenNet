namespace OpenNet.ViewModels
{
    // Lightweight display items for task detail sub-pages (x:Bind DataTable rows).

    [default_interface]
    runtimeclass PeerDisplayItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        PeerDisplayItem();
        String IP;
        String Client;
        String Progress;
        String DLSpeed;
        String ULSpeed;
        String Downloaded;
        String PeerStatus;
        String Location;
        String CountryCode;
        String FlagSvg;
        String ConnectionTime;
        String Protocol;
        String Initiator;
        String Source;
        Boolean IsExpanded;
        Boolean IsGroup;
        Windows.Foundation.Collections.IObservableVector<PeerDisplayItem> Children{ get; };
    };

    [default_interface]
    runtimeclass TrackerDisplayItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        TrackerDisplayItem();
        String URL;
        String Tier;
        String Peers;
        String Status;
        String Message;
    };

    [default_interface]
    runtimeclass FileDisplayItem : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        FileDisplayItem();
        String Path;
        String Size;
        Double ProgressValue;
        String Done;
        Int32 PriorityIndex;
        Int32 FileIndex;
    };
}
