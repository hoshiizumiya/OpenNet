import "ViewModels/ObservableObject.idl"; // Base class for property change notifications
namespace OpenNet.ViewModels
{
    [default_interface]
    runtimeclass SettingsViewModel : Microsoft.UI.Xaml.Data.INotifyPropertyChanged
    {
        // Summary: Construct with defaults. Implementation can remain empty if unused by XAML.
        SettingsViewModel();
        Boolean ShowNotifications;
        Boolean ProgressEffectsEnabled;
        Int32 ProgressEffectScope;
        Windows.UI.Color DownloadProgressColor;
        Windows.UI.Color SeedingProgressColor;
        Windows.UI.Color CheckingProgressColor;
        Windows.UI.Color ProgressBaseColor;
        Microsoft.UI.Xaml.Visibility ProgressRowPreviewVisibility { get; };
        Microsoft.UI.Xaml.Visibility ProgressColumnPreviewVisibility { get; };
        Microsoft.UI.Xaml.Input.ICommand ResetProgressAppearanceCommand { get; };
        Int32 ServerEndpointModeIndex;
        String CurrentServerEndpoint { get; };
        String ServerEndpointStatusText { get; };
        Windows.Foundation.Collections.IObservableVector<String> ServerEndpoints { get; };
        Boolean CanRefreshServerEndpoints { get; };
        Microsoft.UI.Xaml.Input.ICommand RefreshServerEndpointsCommand { get; };
        Windows.Foundation.IAsyncAction LoadServerEndpointsAsync();
    };
}
