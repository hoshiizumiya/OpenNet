<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<_OpenNetParentTargets>$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))</_OpenNetParentTargets>
	</PropertyGroup>
	<Import Project="$(_OpenNetParentTargets)" Condition="'$(_OpenNetParentTargets)' != ''" />
	<Import Project="$(MSBuildThisFileDirectory)SentryNative.targets" Condition="'$(MSBuildProjectName)' == 'OpenNet'" />
</Project>
