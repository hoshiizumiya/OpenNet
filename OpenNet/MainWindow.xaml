<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="OpenNet.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:essential="using:WinUI3Package"
    xmlns:local="using:OpenNet"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ouxv="using:OpenNet.UI.Xaml.View"
    xmlns:pages="using:OpenNet.UI.Xaml.View.Pages"
    x:Uid="MainWindowRoot"
    Title="OpenNet"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Loaded="Grid_Loaded"
        PointerPressed="RootGrid_PointerPressed">
        <Grid.Resources>
            <essential:ModernStandardWindowContextMenu x:Name="Menu" Window="{x:Bind}" />
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Full-window background presentation layer.  -->
        <Image
            x:Name="BackgroundImagePresenter"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="UniformToFill"
            UseLayoutRounding="False">
            <Image.OpacityTransition>
                <ScalarTransition Duration="0:0:0.35" />
            </Image.OpacityTransition>
        </Image>

        <MediaPlayerElement
            x:Name="BackgroundVideoPresenter"
            Grid.RowSpan="2"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            AreTransportControlsEnabled="False"
            AutoPlay="True"
            IsHitTestVisible="False"
            Opacity="0"
            Stretch="UniformToFill"
            UseLayoutRounding="False">
            <MediaPlayerElement.OpacityTransition>
                <ScalarTransition Duration="0:0:0.35" />
            </MediaPlayerElement.OpacityTransition>
        </MediaPlayerElement>

        <essential:WindowCaptionButtonThemeWorkaround Window="{x:Bind}" />

        <!--  标题栏 / Title Bar  -->
        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="AppTitleBar"
            Grid.Row="0"
            Height="48"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            BackRequested="AppTitleBar_BackRequested"
            IsTabStop="False">

            <TitleBar.LeftHeader>
                <Image
                    x:Name="titleBarIcon"
                    Width="16"
                    Margin="10,0,10,0"
                    AutomationProperties.AccessibilityView="Raw"
                    Source="ms-appx:///Assets/AppIcons/Square44x44Logo.altform-lightunplated_targetsize-256.png" />
            </TitleBar.LeftHeader>
            <TitleBar.RightHeader>
                <StackPanel
                    Margin="0,0,6,0"
                    Orientation="Horizontal"
                    Spacing="6">
                    <StackPanel.Resources>
                        <Style
                            x:Key="SettingButtonStyle"
                            BasedOn="{StaticResource DefaultButtonStyle}"
                            TargetType="Button">
                            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                            <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="MinWidth" Value="120" />
                            <Setter Property="Padding" Value="16,6,16,6" />
                        </Style>
                    </StackPanel.Resources>
                    <Button
                        Padding="6"
                        Click="InvertAppThemeButton_Click"
                        Content="[Dev] Invert Theme"
                        Style="{ThemeResource SettingButtonStyle}"
                        Visibility="{x:Bind IsDebug, Mode=OneTime}" />
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>

        <!--  Main content: NavigationView + StatusBar  -->
        <pages:MainView x:Name="MainContentView" Grid.Row="1" />
        <ouxv:InfoBarView
            x:Name="GlobalInfoBarView"
            x:Uid="GlobalInfoBarView"
            Grid.RowSpan="2"
            Canvas.ZIndex="100" />
    </Grid>
</Window>
